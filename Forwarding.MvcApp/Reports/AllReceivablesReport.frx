      <TableDataSource Name="Table" DataType="System.Int32" Enabled="true" SelectCommand="Exec (@query)">
        <Column Name="Quantity" DataType="System.Decimal"/>
        <Column Name="SalePrice" DataType="System.Decimal"/>
        <Column Name="SaleAmount" DataType="System.Decimal"/>
        <Column Name="ExchangeRate" DataType="System.Decimal"/>
        <Column Name="ChargeTypeName" DataType="System.String"/>
        <Column Name="CurrencyCode" DataType="System.String"/>
        <Column Name="OperationCode" DataType="System.String"/>
        <Column Name="POLName" DataType="System.String"/>
        <Column Name="PODName" DataType="System.String"/>
        <Column Name="ContainerTypes" DataType="System.String"/>
        <Column Name="CommodityName" DataType="System.String"/>
        <Column Name="ATAPOLDate" DataType="System.DateTime"/>
        <Column Name="ActualArrival" DataType="System.DateTime"/>
        <Column Name="ReleaseDate" DataType="System.DateTime"/>
        <Column Name="FreeTime" DataType="System.Int32"/>
        <Column Name="ContainerNumber" DataType="System.String"/>
        <Column Name="TankNumbers" DataType="System.String"/>
        <Column Name="ShipmentType" DataType="System.String"/>
        <Column Name="PrintTitle" DataType="System.String" PropName="Column" Calculated="true" Expression="[PrintTitle]"/>
        <Column Name="Logo" DataType="System.String" PropName="Column" Calculated="true" Expression="[Logo]"/>
        <Column Name="Logo1" DataType="System.String" PropName="Column" Calculated="true" Expression="[Logo1]"/>
        <CommandParameter Name="@query" DataType="12" Expression="[query]" DefaultValue="SELECT ChargeTypeName,Quantity,SalePrice,SaleAmount,ExchangeRate,CurrencyCode,OperationCode,POLName,PODName,'' ContainerTypes ,'' CommodityName,CreationDate ATAPOLDate,CreationDate ActualArrival,CreationDate ReleaseDate,ContainerNumber,''TankNumbers,ShipmentType,0 FreeTime FROM vwReceivables"/>
      </TableDataSource>
    </MsSqlDataConnection>
    <Parameter Name="ReceivablesWithoutVAT" DataType="System.String"/>
    <Parameter Name="CurrenciesTotals" DataType="System.String"/>
    <Parameter Name="ClientName" DataType="System.String"/>
    <Parameter Name="PrintTitle" DataType="System.String" Expression="[PrintTitle]"/>
    <Parameter Name="Logo" DataType="System.String" Expression="[Logo]"/>
    <Parameter Name="Logo1" DataType="System.String" Expression="[Logo1]"/>
    <Parameter Name="CompanyName" DataType="System.String" Expression="[CompanyName]"/>
  </Dictionary>
