    private void Text102_BeforePrint(object sender, EventArgs e)
    {
      if (((Int64)Report.GetColumnValue(&quot;Table.InvoiceNumber&quot;)) != 0){
        Text102.Text = ((Int64)Report.GetColumnValue(&quot;Table.InvoiceNumber&quot;)).ToString();
      } else {
        Text102.Text = &quot;&quot;;
      }
    }
  }
}
