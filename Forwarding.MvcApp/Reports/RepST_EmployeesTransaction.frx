    private void Text18_AfterData(object sender, EventArgs e)
    {
      if (((String)Report.GetParameterValue(&quot;category&quot;))==&quot;1&quot;)
      {
		    Text18.Text=&quot;ALL&quot;;
      }  
      else  if (((String)Report.GetParameterValue(&quot;category&quot;))==&quot;2&quot;)
      {
        Text18.Text=&quot;يومية&quot;;
      }
      else  if (((String)Report.GetParameterValue(&quot;category&quot;))==&quot;3&quot;)
      {
        Text18.Text=&quot;موسمية&quot;;
      }
      else  if (((String)Report.GetParameterValue(&quot;category&quot;))==&quot;3&quot;)
      {
        Text18.Text=&quot;ثابتة&quot;;
      }
    }

    private void Text20_AfterData(object sender, EventArgs e)
    {
      if (((String)Report.GetParameterValue(&quot;shiftEmp&quot;))==&quot;1&quot;)
      {
        Text20.Text=&quot;ALL&quot;;
      }  
      else  if (((String)Report.GetParameterValue(&quot;shiftEmp&quot;))==&quot;2&quot;)
      {
        Text20.Text=&quot;صباحي&quot;;
      }
      else  if (((String)Report.GetParameterValue(&quot;shiftEmp&quot;))==&quot;3&quot;)
      {
        Text20.Text=&quot;مسائي&quot;;
      }

    }

    private void Text24_AfterData(object sender, EventArgs e)
    {
      if (((String)Report.GetParameterValue(&quot;maritalstatus&quot;))==&quot;1&quot;)
      {
        Text24.Text=&quot;ALL&quot;;
      }  
      else  if (((String)Report.GetParameterValue(&quot;maritalstatus&quot;))==&quot;2&quot;)
      {
        Text24.Text=&quot;اعزب&quot;;
      }
      else  if (((String)Report.GetParameterValue(&quot;maritalstatus&quot;))==&quot;3&quot;)
      {
        Text24.Text=&quot;متزوج&quot;;
      }  
      else  if (((String)Report.GetParameterValue(&quot;maritalstatus&quot;))==&quot;4&quot;)
      {
        Text24.Text=&quot;ارمل&quot;;
      }
      else  if (((String)Report.GetParameterValue(&quot;maritalstatus&quot;))==&quot;5&quot;)
      {
        Text24.Text=&quot;مطلق&quot;;
      }
    }

    private void Text22_AfterData(object sender, EventArgs e)
    {
      if (((String)Report.GetParameterValue(&quot;Section&quot;))==&quot;1&quot;)
      {
        Text22.Text=&quot;ALL&quot;;
      }  
      else  if (((String)Report.GetParameterValue(&quot;Section&quot;))==&quot;2&quot;)
      {
        Text22.Text=&quot;تعبئة&quot;;
      }
      else  if (((String)Report.GetParameterValue(&quot;Section&quot;))==&quot;3&quot;)
      {
        Text22.Text=&quot;اشراف جودة&quot;;
      }  
      else  if (((String)Report.GetParameterValue(&quot;Section&quot;))==&quot;4&quot;)
      {
        Text22.Text=&quot;عمال سير&quot;;
      }
      else  if (((String)Report.GetParameterValue(&quot;Section&quot;))==&quot;5&quot;)
      {
        Text22.Text=&quot;ادارى&quot;;
      }
      else  if (((String)Report.GetParameterValue(&quot;Section&quot;))==&quot;6&quot;)
      {
        Text22.Text=&quot;خدمات&quot;;
      }
    }

    private void Text25_AfterData(object sender, EventArgs e)
    {
      if (((String)Report.GetParameterValue(&quot;NumberofChildren&quot;))==&quot;1&quot;)
      {
        Text25.Text=&quot;ALL&quot;;
      }  
      else  if (((String)Report.GetParameterValue(&quot;NumberofChildren&quot;))==&quot;2&quot;)
      {
        Text25.Text=&quot;يعول&quot;;
      }
      else  if (((String)Report.GetParameterValue(&quot;NumberofChildren&quot;))==&quot;3&quot;)
      {
        Text25.Text=&quot;لا يعول&quot;;
      }  
    }


  }
}
</ScriptText>
