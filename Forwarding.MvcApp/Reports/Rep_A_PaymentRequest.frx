    private void SignatureTable_BeforePrint(object sender, EventArgs e)
    {  
//      Text9.Text= Report.GetVariableValue(&quot;TotalPages#&quot;).ToString();
      if(Convert.ToInt32(Report.GetVariableValue(&quot;Page&quot;)) == Convert.ToInt32(Report.GetVariableValue(&quot;TotalPages&quot;)))
        SignatureTable.Visible = true;
      else
        SignatureTable.Visible = false;
    }

    private void Text83_BeforePrint(object sender, EventArgs e)
    {
      if (   ((String)Report.GetColumnValue(&quot;Rep_A_PaymentRequest.CurrencyCode&quot;)) == &quot;EGP&quot; )
      {
           Text83.Text=&quot;&quot;;
           Text83.Visible=false;
      }
                
    }

    private void Text82_BeforePrint(object sender, EventArgs e)
    {
      if (   ((String)Report.GetColumnValue(&quot;Rep_A_PaymentRequest.CurrencyCode&quot;)) != &quot;EGP&quot; )
        Text82.Visible=false;
      
    }
    

    private void Text82_AfterPrint(object sender, EventArgs e)
    {
              
    }

    private void Text82_AfterData(object sender, EventArgs e)
    {
             Text82.Text =    Text82.Text.Replace(&quot;and 00 pence&quot;,&quot;&quot;);
    }

    private void Text83_AfterData(object sender, EventArgs e)
    {
          Text83.Text =    Text83.Text.Replace(&quot;and 00 cents&quot;,&quot;&quot;);
    }
    }

   
}
