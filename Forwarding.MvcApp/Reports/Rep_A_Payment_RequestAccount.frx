      </TableDataSource>
      <TableDataSource Name="Table1" DataType="System.Int32" Enabled="true" SelectCommand="SELECT apra.*,aa.Account_Name,asa.SubAccount_Name,acc.CostCenterName,apra.PaymentRequestID&#13;&#10;  FROM A_PaymentRequest AS apr JOIN A_PaymentRequestAccount AS apra ON apra.PaymentRequestID = apr.ID&#13;&#10;JOIN A_Accounts AS aa ON aa.ID = apra.Account_ID&#13;&#10;LEFT JOIN A_SubAccounts AS asa ON asa.ID = apra.SubAccount_ID&#13;&#10;LEFT JOIN A_CostCenters AS acc ON acc.ID = apra.CostCenter_ID&#13;&#10;WHERE apra.PaymentRequestID=@ID">
        <Column Name="ID" DataType="System.Int32"/>
        <Column Name="Account_ID" DataType="System.Int32"/>
        <Column Name="SubAccount_ID" DataType="System.Int32"/>
        <Column Name="CostCenter_ID" DataType="System.Int32"/>
        <Column Name="Amount" DataType="System.Decimal"/>
        <Column Name="Notes" DataType="System.String"/>
        <Column Name="PaymentRequestID" DataType="System.Int64"/>
        <Column Name="Account_Name" DataType="System.String"/>
        <Column Name="SubAccount_Name" DataType="System.String"/>
        <Column Name="CostCenterName" DataType="System.String"/>
        <Column Name="PaymentRequestID1" DataType="System.Int64"/>
        <CommandParameter Name="@ID" DataType="22" Expression="[ID]"/>
      </TableDataSource>
    </MsSqlDataConnection>
    <Parameter Name="ID" DataType="System.String"/>
    <Total Name="Total" Expression="[Rep_A_Payment_Request.EstmatedCost]" Evaluator="Data1" PrintOn="ReportSummary1"/>
  </Dictionary>
