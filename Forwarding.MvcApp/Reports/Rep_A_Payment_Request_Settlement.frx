  public class ReportScript
  {

   
    double vartotal;

    private void ReportSummary1_AfterData(object sender, EventArgs e)
    {
                                                                           
      vartotal = Convert.ToDouble( ((Decimal)Report.GetColumnValue(&quot;Rep_A_Payment_Request.SubAccountBalance&quot;)))
         + Report.GetTotalValue(&quot;TotalActual&quot;);

      vartotal=Math.Round(vartotal,2);
      NumberFormatInfo nfi1 = NumberFormatInfo.CurrentInfo;
      
       Text78.Text=  vartotal.ToString(&quot;N&quot;,nfi1);  
      double totalActual = Report.GetTotalValue(&quot;TotalActual&quot;);
      double total = Report.GetTotalValue(&quot;Total&quot;);
   
      // Compare the values and set the text accordingly
      if (totalActual &gt; total)
      {
        Text78.Text = (totalActual - total).ToString() + &quot; صرف&quot;;
      }
      else if (totalActual &lt; total)
      {
        Text78.Text = (total - totalActual).ToString() + &quot; استلام&quot;;
      }
      else
      {
        Text78.Text = &quot;&quot;;
      }
    
           
    }

    private void ReportTitle1_AfterPrint(object sender, EventArgs e)
    {
      if(  ((Boolean)Report.GetColumnValue(&quot;Rep_A_Payment_Request.IsCheck&quot;)) )
        Text80.Text= &quot;Cheque&quot;   ;
      else
        Text80.Text= &quot;Cash&quot;   ;
    }
