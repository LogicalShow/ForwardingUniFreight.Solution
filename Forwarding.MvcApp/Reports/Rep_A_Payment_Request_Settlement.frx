    private void ReportTitle1_AfterData(object sender, EventArgs e)
    {
      if(  ((Boolean)Report.GetColumnValue(&quot;Rep_A_Payment_Request.IsCheck&quot;)) )
        Text80.Text= &quot;Cheque&quot;   ;
      else
        Text80.Text= &quot;Cash&quot;   ;
    }
  }
}
