  public class ReportScript
  {

    private void Text64_AfterData(object sender, EventArgs e)
    {
      txtRef.Visible=false;
      txtrefervalue.Visible=false;
        
      Text77.Visible=false;
      Text44.Visible=false;
        
      Text80.Visible=false;
      Text47.Visible=false;
    
      if (((Int32)Report.GetColumnValue(&quot;Rep_A_Voucher_Print.VoucherType&quot;))==10)
      {
        Text64.Text=&quot;Cash Collection Receipt&quot;;
      }
      else if(((Int32)Report.GetColumnValue(&quot;Rep_A_Voucher_Print.VoucherType&quot;))==20)
      {
        Text64.Text=&quot;Cash Payment Receipt&quot;;
      }
      else if(((Int32)Report.GetColumnValue(&quot;Rep_A_Voucher_Print.VoucherType&quot;))==30)
      {
        Text64.Text=&quot;Bank Collection Receipt&quot;;
      }
      else if(((Int32)Report.GetColumnValue(&quot;Rep_A_Voucher_Print.VoucherType&quot;))==40)
      {
        Text64.Text=&quot;Bank Payment Receipt&quot;;
      }
    }

    private void Text77_AfterData(object sender, EventArgs e)
    {
      if (((Int32)Report.GetColumnValue(&quot;Rep_A_Voucher_Print.VoucherType&quot;))==30 || ((Int32)Report.GetColumnValue(&quot;Rep_A_Voucher_Print.VoucherType&quot;))==40)
      {
        Text77.Visible=true;
        Text44.Visible=true;
        Text87.Visible=true;
        Text80.Visible=true;
        Text90.Visible=true;
        Text47.Visible=true;
        Text78.Visible=true;
        Text88.Visible=true;
        Text45.Visible=true;
        
        Text79.Visible=false;
        Text89.Visible=false;
        Text46.Visible=false;
        
        Text104.Visible=true;
        Text105.Visible=true;
        Text4.Visible=true;

        Text106.Visible=true;
        Text107.Visible=true;
        Text3.Visible=true;
        
        if ((bool)Report.GetColumnValue(&quot;Rep_A_Voucher_Print.IsTransfer&quot;))
        {
          txtdepodate.Visible=false;
          txtdepodatevalue.Visible=false;
        
          txtRef.Visible=false;
          txtrefervalue.Visible=false;
        
          Text77.Visible=false;
          Text44.Visible=false;
        
          Text80.Visible=false;
          Text47.Visible=false;
        
        }
        else
        {
          if ((bool)Report.GetColumnValue(&quot;Rep_A_Voucher_Print.IsCheck&quot;))
          {
            txtdepodate.Visible=false;
            txtdepodatevalue.Visible=false;
          
            txtRef.Visible=false;
            txtrefervalue.Visible=false;
          
            txttransfdate.Visible=false;
            txttransfdatevalue.Visible=false;
                    
            txtIBAN.Visible=false; 
            txtibanvalue.Visible=false;
          }
          else
          {
            Text77.Visible=false;
            Text44.Visible=false;
        
            Text80.Visible=false;
            Text47.Visible=false;
          
            txttransfdate.Visible=false;
            txttransfdatevalue.Visible=false;
          
          
            txtIBAN.Visible=false; 
            txtibanvalue.Visible=false;     
            
            txtdepodate.Visible=true;
            txtdepodatevalue.Visible=true;
          
            txtRef.Visible=true;
            txtrefervalue.Visible=true;
          }
      
        }

      }
      else
      {
        Text77.Visible=false;
        Text44.Visible=false;
        Text87.Visible=false;
        Text80.Visible=false;
        Text90.Visible=false;
        Text47.Visible=false;
        Text78.Visible=false;
        Text88.Visible=false;
        Text45.Visible=false;
        Text104.Visible=false;
        Text105.Visible=false;
        Text4.Visible=false;

        
        Text106.Visible=false;
        Text107.Visible=false;
        Text3.Visible=false;
        
        txtdepodate.Visible=false;
        txtdepodatevalue.Visible=false;
          
        txtRef.Visible=false;
        txtrefervalue.Visible=false;
          
        txttransfdate.Visible=false;
        txttransfdatevalue.Visible=false;
                    
        txtIBAN.Visible=false; 
        txtibanvalue.Visible=false;
        
        Text79.Visible=true;
        Text89.Visible=true;
        Text46.Visible=true;
      }
    }

    private void Text58_AfterData(object sender, EventArgs e)
    {
      if (((Decimal)Report.GetColumnValue(&quot;Rep_A_Voucher_Print.TaxValue&quot;))&gt;0)
      {
        Text58.Visible=true;
        Text54.Visible=true;

      }
      else
      {
        Text58.Visible=false;
        Text54.Visible=false;  
      }
    }

    private void Text66_AfterData(object sender, EventArgs e)
    {
      if (((Decimal)Report.GetColumnValue(&quot;Rep_A_Voucher_Print.TaxValue2&quot;)) &gt;0)
      {
        Text66.Visible=true;
        Text56.Visible=true;

      }
      else
      {
        Text66.Visible=false;
        Text56.Visible=false;
      }
    }

    private void Text108_AfterData(object sender, EventArgs e)
    {
      if (((String)Report.GetColumnValue(&quot;Rep_A_Voucher_Print.Currency_Code&quot;)==&quot;EGP&quot;))
      {
        Text108.Visible=true;
        Text98.Visible=true;

      }
      else
      {
        Text108.Visible=false;
        Text98.Visible=true;
  
      }
    }

    private void Text98_BeforePrint(object sender, EventArgs e)
    {
      if (((String)Report.GetColumnValue(&quot;Rep_A_Voucher_Print.Currency_Code&quot;)==&quot;EGP&quot;))
      {
        Text98.Text=&quot;&quot;;
        Text108.Visible=true;
        Text98.Visible=false;
      }
    }

    private void txtibanvalue_AfterData(object sender, EventArgs e)
    {

    }

    private void CheckBox1_AfterData(object sender, EventArgs e)
    {
 
    }
  }
}
