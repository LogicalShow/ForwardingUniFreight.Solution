  public class ReportScript
  {
    private void Cell67_BeforePrint(object sender, EventArgs e)
    {
      if(Report.GetParameterValue(&quot;Title&quot;).ToString().Contains(&quot;Deals&quot;))
          Cell67.Text = (FormatDateTime((DateTime)Report.GetColumnValue(&quot;StageStatusReport.DealCreationDate&quot;),&quot;dd/MM/yyyy&quot;).ToString());
      else if(Report.GetParameterValue(&quot;Title&quot;).ToString().Contains(&quot;Oppurtunities&quot;))
          Cell67.Text =  (FormatDateTime((DateTime)Report.GetColumnValue(&quot;StageStatusReport.OppurtunityCreationDate&quot;),&quot;dd/MM/yyyy&quot;).ToString());
      else if(Report.GetParameterValue(&quot;Title&quot;).ToString().Contains(&quot;Leads&quot;))
        Cell67.Text =  (FormatDateTime((DateTime)Report.GetColumnValue(&quot;StageStatusReport.CreationDate&quot;),&quot;dd/MM/yyyy&quot;).ToString());
      else if(Report.GetParameterValue(&quot;Title&quot;).ToString().Contains(&quot;Customers&quot;))
        Cell67.Text =  (FormatDateTime((DateTime)Report.GetColumnValue(&quot;StageStatusReport.NewCustomerCreationDate&quot;),&quot;dd/MM/yyyy&quot;).ToString());
    }
  }
}
</ScriptText>
