    private void Text6_AfterData(object sender, EventArgs e)
    {
      int isMain = Convert.ToInt32(Report.GetColumnValue(&quot;Rep_ChartOfAccounts.IsMain&quot;));

      TextObject textObj = (TextObject)sender;
      if (isMain == 1)
      {
        textObj.Font = new System.Drawing.Font(&quot;Arial&quot;, 10, System.Drawing.FontStyle.Bold);
      }
      else
      {
        textObj.Font = new System.Drawing.Font(&quot;Arial&quot;, 10, System.Drawing.FontStyle.Regular);
      }
    }

    private void Text8_AfterData(object sender, EventArgs e)
    {
      int isMain = Convert.ToInt32(Report.GetColumnValue(&quot;Rep_ChartOfAccounts.IsMain&quot;));

      TextObject textObj = (TextObject)sender;
      if (isMain == 1)
      {
        textObj.Font = new System.Drawing.Font(&quot;Arial&quot;, 10, System.Drawing.FontStyle.Bold);
      }
      else
      {
        textObj.Font = new System.Drawing.Font(&quot;Arial&quot;, 10, System.Drawing.FontStyle.Regular);
      }
    }
  }
}
</ScriptText>
