    private void Text71_AfterData(object sender, EventArgs e)
    {
      string warehouseTo=Convert.ToString(Text71.Value);
      if(String.IsNullOrWhiteSpace(warehouseTo)||warehouseTo==&quot;0&quot;){
        Text70.Visible=false;
        Text71.Visible=false;
      }
      else{
        Text70.Visible=true;
        Text71.Visible=true;
      }
    }


  }
}
