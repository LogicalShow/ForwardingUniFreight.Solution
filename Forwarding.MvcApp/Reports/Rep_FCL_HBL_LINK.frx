    private void Text14_AfterData(object sender, EventArgs e)
    {
      String text=((String)Report.GetColumnValue(&quot;Rep_DeliveryOrders.CarrierSeal2&quot;));
      text = text.Replace(&quot;*&quot;, &quot;*&quot; + System.Environment.NewLine);
      string newString = text.Replace(&quot;*&quot;, &quot;\n\n&quot;);  
      Text14.Text= newString.ToString();
      
      
      text=((String)Report.GetColumnValue(&quot;Rep_DeliveryOrders.GrossWeightSum1&quot;));
      text = text.Replace(&quot;*&quot;, &quot;*&quot; + System.Environment.NewLine);
      newString = text.Replace(&quot;*&quot;, &quot;\n&quot;);  
      Text17.Text= newString.ToString();
      text=((String)Report.GetColumnValue(&quot;Rep_DeliveryOrders.volume1&quot;));
      text = text.Replace(&quot;*&quot;, &quot;*&quot; + System.Environment.NewLine);
      newString = text.Replace(&quot;*&quot;, &quot;\n&quot;);  
      Text18.Text= newString.ToString();
      
      
//      if (((String)Report.GetColumnValue(&quot;Rep_DeliveryOrders.ConsigneePhonesAndFaxes&quot;))==&quot;&quot;)
//      {
//        
//        Text23.Text=&quot;&quot;;
//             Text147.Text=&quot;&quot;;
//      }
      
    }

   
  }
}
