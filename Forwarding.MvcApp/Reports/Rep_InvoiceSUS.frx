namespace FastReport
{
  public class ReportScript
  {
    
    private void Text109_BeforePrint(object sender, EventArgs e)
    {
      decimal ReceivableTotalAmount = 0;
      if (((String)Report.GetParameterValue(&quot;IsTotalInLocalCurrency&quot;)) == &quot;true&quot;){
        // print in local currency
        ReceivableTotalAmount = ((Decimal)Report.GetColumnValue(&quot;Table.ReceivableTotalAmount&quot;)) * ((Decimal)Report.GetColumnValue(&quot;Table.ExchangeRate&quot;));
      } else {
        ReceivableTotalAmount = ((Decimal)Report.GetColumnValue(&quot;Table.ReceivableTotalAmount&quot;));
      }
      
      ReceivableTotalAmount = Math.Round(ReceivableTotalAmount, 4);
      Text109.Text = ReceivableTotalAmount.ToString();
    }

    private void Text101_BeforePrint(object sender, EventArgs e)
    {
      if (((String)Report.GetParameterValue(&quot;IsTotalInLocalCurrency&quot;)) == &quot;true&quot;){
        // print in local currency
        Text101.Text = &quot;Total Amount (AED)&quot;;
      } else {
        Text101.Text = &quot;Total Amount (&quot; + ((String)Report.GetColumnValue(&quot;Table.CurrencyCode&quot;)) + &quot;)&quot;;
      }
      
    }

    private void Text106_BeforePrint(object sender, EventArgs e)
    {
      Text106.Text = (((Decimal)Report.GetColumnValue(&quot;Table.ReceivableAmountWithoutVAT&quot;)) / ((Decimal)Report.GetColumnValue(&quot;Table.Quantity&quot;))).ToString();
    }
  }
}
</ScriptText>
