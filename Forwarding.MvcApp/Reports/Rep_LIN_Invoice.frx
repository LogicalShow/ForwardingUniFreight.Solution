        <CommandParameter Name="OPID" DataType="22" Expression="[Table.OperationID]"/>
      </TableDataSource>
      <TableDataSource Name="Table3" Alias="InvoiceNameDrafts" DataType="System.Int32" Enabled="true" SelectCommand="select i.InvoiceTypeCode, t.Name as drafttype from vwinvoices i left join InvoiceTypes t on i.USDPerContainer = t.id where  i.id = @ID">
        <Column Name="InvoiceTypeCode" DataType="System.String"/>
        <Column Name="drafttype" DataType="System.String"/>
        <CommandParameter Name="ID" DataType="22" Expression="[ID]"/>
      </TableDataSource>
      <TableDataSource Name="Table5" Alias="ClientAddress" DataType="System.Int32" Enabled="true" SelectCommand="SELECT TOP 1  StreetLine1+ ' , '+ CityName + ' , ' + CountryName &#13;&#10;FROM vwAddresses WHERE PartnerID=@PID AND AddressTypeID=1">
        <Column Name="Column1" DataType="System.String"/>
        <CommandParameter Name="PID" DataType="22" Expression="[Table.PartnerID]"/>
      </TableDataSource>
      <TableDataSource Name="Table6" DataType="System.Int32" Enabled="true" SelectCommand="select InvoiceTypeID from invoices where ChildInvoiceID =@INVID&#13;&#10;">
        <Column Name="InvoiceTypeID" DataType="System.Int32"/>
        <CommandParameter Name="INVID" DataType="22" Expression="[id]"/>
      </TableDataSource>
      <TableDataSource Name="Table7" DataType="System.Int32" Enabled="true" SelectCommand="select Form13Number from operations where id =@MSOP">
        <Column Name="Form13Number" DataType="System.String"/>
        <CommandParameter Name="MSOP" DataType="22" Expression="[Table.MasterOperationID]"/>
      </TableDataSource>
      <TableDataSource Name="Table8" Alias="package" DataType="System.Int32" Enabled="true" SelectCommand="select NumberOfPackages,PackageTypeName,PackageTypesOnContainersTotals from vwoperations where id = @OPID">
        <Column Name="NumberOfPackages" DataType="System.Int32"/>
        <Column Name="PackageTypeName" DataType="System.String"/>
        <Column Name="PackageTypesOnContainersTotals" DataType="System.String"/>
        <CommandParameter Name="OPID" DataType="22" Expression="[Table.OperationID]"/>
      </TableDataSource>
    </MsSqlDataConnection>
