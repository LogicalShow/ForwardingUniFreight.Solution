      <TableDataSource Name="Table1" Alias="Receivables" DataType="System.Int32" Enabled="true" SelectCommand="IF @cbCombineTrucking = 'yes' &#13;&#10;    AND (SELECT COUNT(DISTINCT SalePrice) &#13;&#10;         FROM vwReceivables &#13;&#10;         WHERE (DraftInvoiceID = @INVID OR InvoiceID = @INVID) &#13;&#10;         AND ChargeTypeID IN (521, 233)&#13;&#10;         AND SaleAmount != 0) &gt; 1&#13;&#10;BEGIN&#13;&#10;    -- Execute the query for the case when @cbCombineTrucking = 'no'&#13;&#10;    SELECT &#13;&#10;        ID,&#13;&#10;        ChargeTypeName,&#13;&#10;        Quantity,&#13;&#10;        SalePrice,&#13;&#10;        SaleAmount,&#13;&#10;        notes&#13;&#10;    FROM &#13;&#10;        vwReceivables &#13;&#10;    WHERE &#13;&#10;        (DraftInvoiceID = @INVID OR InvoiceID = @INVID) &#13;&#10;        AND SaleAmount != 0&#13;&#10;END&#13;&#10;ELSE IF @cbCombineTrucking = 'yes'&#13;&#10;BEGIN&#13;&#10;    SELECT &#13;&#10;        MAX(ID) AS id,&#13;&#10;        MAX(ChargeTypeID) AS ChargeTypeID,&#13;&#10;        MAX(ChargeTypeName) AS ChargeTypeName,&#13;&#10;        SUM(Quantity) AS Quantity,&#13;&#10;        Max(SalePrice) AS SalePrice,&#13;&#10;        SUM(SaleAmount) AS SaleAmount,&#13;&#10;        MAX(notes) AS notes&#13;&#10;    FROM &#13;&#10;        vwReceivables &#13;&#10;    WHERE &#13;&#10;        (DraftInvoiceID = @INVID OR InvoiceID = @INVID) &#13;&#10;        AND SaleAmount != 0&#13;&#10;    GROUP BY &#13;&#10;        CASE &#13;&#10;            WHEN ChargeTypeID IN (521, 233) THEN 0 &#13;&#10;            ELSE ID&#13;&#10;        END,&#13;&#10;        CASE &#13;&#10;            WHEN ChargeTypeID IN (521, 233) THEN 'TRUCKING'&#13;&#10;            ELSE NULL&#13;&#10;        END&#13;&#10;END&#13;&#10;ELSE&#13;&#10;BEGIN&#13;&#10;    SELECT &#13;&#10;        ID,&#13;&#10;        ChargeTypeName,&#13;&#10;        Quantity,&#13;&#10;        SalePrice,&#13;&#10;        SaleAmount,&#13;&#10;        notes&#13;&#10;    FROM &#13;&#10;        vwReceivables &#13;&#10;    WHERE &#13;&#10;        (DraftInvoiceID = @INVID OR InvoiceID = @INVID) &#13;&#10;        AND SaleAmount != 0&#13;&#10;END">
        <Column Name="Quantity" DataType="System.Decimal"/>
        <Column Name="SalePrice" DataType="System.Decimal"/>
        <Column Name="SaleAmount" DataType="System.Decimal"/>
        <Column Name="ChargeTypeName" DataType="System.String"/>
        <Column Name="id" DataType="System.Int64"/>
        <Column Name="notes" DataType="System.String"/>
        <CommandParameter Name="INVID " DataType="22" Expression="[id]"/>
        <CommandParameter Name="cbCombineTrucking" DataType="22" Expression="[cbCombineTrucking]" DefaultValue="no"/>
      </TableDataSource>
      <TableDataSource Name="Table2" Alias="Bank" DataType="System.Int32" Enabled="true" SelectCommand="select AccountName,BankName,BankAddress,SwiftCode,AccountNumber from Defaults">
        <Column Name="AccountName" DataType="System.String"/>
        <Column Name="BankName" DataType="System.String"/>
        <Column Name="BankAddress" DataType="System.String"/>
        <Column Name="SwiftCode" DataType="System.String"/>
        <Column Name="AccountNumber" DataType="System.String"/>
      </TableDataSource>
      <TableDataSource Name="Table4" DataType="System.Int32" Enabled="true" SelectCommand="select ActualArrival,ContainerTypes, CommodityName,ContainerNumber,Form13Number,VolumeSum,NumberOfPackages,PackageTypeName,WeightCharge,ConsigneeName,ShipperName,GrossWeightSum,PONumber,ACIDNumber from vwoperations where  id =@OPID&#13;&#10;">
        <Column Name="ActualArrival" DataType="System.DateTime"/>
        <Column Name="WeightCharge" DataType="System.Decimal"/>
        <Column Name="ContainerNumber" DataType="System.String"/>
        <Column Name="ContainerTypes" DataType="System.String"/>
        <Column Name="NumberOfPackages" DataType="System.Int32"/>
        <Column Name="PackageTypeName" DataType="System.String"/>
