  public class ReportScript
  {

   
   

    private void Text14_AfterData(object sender, EventArgs e)
    {
      String text=((String)Report.GetColumnValue(&quot;Rep_DeliveryOrders.CarrierSeal2&quot;));
      text = text.Replace(&quot;*&quot;, &quot;*&quot; + System.Environment.NewLine);
      string newString = text.Replace(&quot;*&quot;, &quot;\n&quot;); 
       
      Text14.Text= newString.ToString();
    }

    private void Text149_AfterData(object sender, EventArgs e)
    {
      if (((String)Report.GetColumnValue(&quot;Rep_DeliveryOrders.POrCName&quot;))==&quot;Prepaid&quot;)
      {
        Text149.Text=&quot;Prepaid&quot;;
        Text133.Text=&quot;&quot;;

      }
      else  if (((String)Report.GetColumnValue(&quot;Rep_DeliveryOrders.POrCName&quot;))==&quot;Collect&quot;)
      {
        Text149.Text=&quot;&quot;;
        Text133.Text=&quot;Collect&quot;;

      }
    }
  }
}
</ScriptText>
