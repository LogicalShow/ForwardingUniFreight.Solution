      <TextObject Name="Text2" Left="109.92" Top="62.43" Width="902.36" Height="25.88" Text="السادة / مصلحة الجمارك المصرية" HorzAlign="Right" VertAlign="Center" Font="Arial, 16pt, style=Underline"/>
      <TextObject Name="Text3" Left="109.25" Top="95.28" Width="906.35" Height="25.88" Text="السادة / التوكيل الملاحى &quot;[MEDReleaseAcceptanceLetter.LineName] &quot;" VertAlign="Center" RightToLeft="true" Font="Arial, 16pt, style=Underline"/>
      <TextObject Name="Text4" Left="115.4" Top="146.31" Width="839.2" Height="30.43" Text="قبلنا نحن شركة / [MEDReleaseAcceptanceLetter.Consignee2Name]" VertAlign="Center" RightToLeft="true" Font="Arial, 16pt"/>
      <TextObject Name="Text5" Left="117.24" Top="196.39" Width="837.36" Height="20.85" Text="- عن مشمول الرسالة الآتى ذكر بياناتها ." VertAlign="Center" RightToLeft="true" Font="Arial, 16pt, style=Underline"/>
      <TextObject Name="Text6" Left="60.39" Top="218.29" Width="894.21" Height="197.53" Text="- مشمول البوليصة رقم : [MEDReleaseAcceptanceLetter.MasterBL]&#13;&#10;- الواردة من : [MEDReleaseAcceptanceLetter.POL]&#13;&#10;- الواردة إلى ميناء : [MEDReleaseAcceptanceLetter.POD]&#13;&#10;- بعدد : [IIf([MEDReleaseAcceptanceLetter.ContainerTypes] == &quot;&quot;,[MEDReleaseAcceptanceLetter.PackageTypes],[MEDReleaseAcceptanceLetter.ContainerTypes])]&#13;&#10;- الصنف : [MEDReleaseAcceptanceLetter.CommodityName]&#13;&#10;- بوزن : [FormatNumber([MEDReleaseAcceptanceLetter.GrossWeightSum],2)] KG" VertAlign="Center" RightToLeft="true" Font="Arial, 16pt"/>
      <TextObject Name="Text7" Left="288.79" Top="536.02" Width="439.26" Height="25.88" Text="ولسيادتكم جزيل الشكر والتقدير ,,,," HorzAlign="Center" VertAlign="Center" RightToLeft="true" Font="Arial, 16pt, style=Bold"/>
      <TextObject Name="Text8" Left="62.46" Top="430.76" Width="892.14" Height="30.43" Text="من السادة شركة / [MEDReleaseAcceptanceLetter.ConsigneeName]" VertAlign="Center" RightToLeft="true" Font="Arial, 16pt"/>
      <TextObject Name="Text9" Left="23.03" Top="469.93" Width="931.57" Height="59.49" Text="وذلك دون أدنى مسئولية على التوكيل الملاحى أو الخط الملاحى مع تحملنا كافة الغرامات والرسوم الناتجة من ذلك أمام كافة الخطوط الملاحية ومصلحة الجمارك والجهات الحكومية ..." RightToLeft="true" Font="Arial, 16pt"/>
