    <PageHeaderBand Name="PageHeader1" Width="1047.06" Height="518.6">
      <TextObject Name="Text1" Left="425.34" Top="20.8" Width="196.38" Height="25.88" Text="تنـــــــازل" HorzAlign="Center" VertAlign="Center" Font="Arial, 16pt, style=Bold"/>
      <TextObject Name="Text2" Left="474.82" Top="65.05" Width="547.43" Height="25.88" Text="السادة / مصلحة الجمارك المصرية" HorzAlign="Right" VertAlign="Center" Font="Arial, 16pt, style=Underline"/>
      <TextObject Name="Text3" Left="379.33" Top="97.92" Width="646.24" Height="25.88" Text="السادة / التوكيل الملاحى &quot; [MEDReleaseLetter.LineName]&quot;" VertAlign="Center" RightToLeft="true" Font="Arial, 16pt, style=Underline"/>
      <TextObject Name="Text4" Left="23.69" Top="136.08" Width="941.1" Height="55.74" Text="- تنازلنا نحن شركة : [MEDReleaseLetter.ConsigneeName]&#13;&#10;- لصالح شركة : [MEDReleaseLetter.Consignee2Name]" RightToLeft="true" Font="Arial, 16pt"/>
      <TextObject Name="Text5" Left="552.08" Top="199.01" Width="413.22" Height="35.94" Text="- عن مشمول الرسالة الآتى ذكر بياناتها ." VertAlign="Center" RightToLeft="true" Font="Arial, 16pt, style=Underline"/>
      <TextObject Name="Text6" Left="55.21" Top="222.82" Width="910.09" Height="220.75" Text="- مشمول البوليصة رقم : [MEDReleaseLetter.MasterBL]&#13;&#10;- الواردة من : [MEDReleaseLetter.POL]&#13;&#10;- الواردة إلى ميناء : [MEDReleaseLetter.POD]&#13;&#10;- بعدد : [IIf([MEDReleaseLetter.ContainerTypes] == &quot;&quot;,[MEDReleaseLetter.PackageTypes],[MEDReleaseLetter.ContainerTypes])]&#13;&#10;- الصنف : [MEDReleaseLetter.CommodityName]&#13;&#10;- بوزن : [FormatNumber([MEDReleaseLetter.GrossWeightSum],2)] KG" VertAlign="Center" RightToLeft="true" Font="Arial, 16pt"/>
      <TextObject Name="Text7" Left="303.9" Top="473.07" Width="439.26" Height="25.88" Text="وهذا تنازل منا بذلك ولسيادتكم خالص الشكر والتقدير ,,,," HorzAlign="Center" VertAlign="Center" RightToLeft="true" Font="Arial, 16pt, style=Bold"/>
    </PageHeaderBand>
