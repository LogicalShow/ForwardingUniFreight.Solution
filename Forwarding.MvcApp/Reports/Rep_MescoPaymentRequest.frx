    </MsSqlDataConnection>
    <Parameter Name="ID" DataType="System.String"/>
    <Total Name="TotalTAXAmount" Expression="([Rep_A_Payment_Request.PaymentRequestDetailEstimatedCost] - [Rep_A_Payment_Request.DebitAmount] )* ([Rep_A_Payment_Request.DetailTaxPercentage] / 100)" Evaluator="Data1"/>
    <Total Name="TotalDiscountAmount" Expression="([Rep_A_Payment_Request.PaymentRequestDetailEstimatedCost] - [Rep_A_Payment_Request.DebitAmount])* ([Rep_A_Payment_Request.DetailDiscountPercentage] / 100)" Evaluator="Data1"/>
    <Total Name="TotalAmount" Expression="[TotaAmountlWithoutVAT] + [TotalTAXAmount] - [TotalDiscountAmount]" Evaluator="Data1"/>
    <Total Name="TotaAmountlWithoutVAT" Expression="([Rep_A_Payment_Request.PaymentRequestDetailEstimatedCost] - [Rep_A_Payment_Request.DebitAmount])" Evaluator="Data1"/>
  </Dictionary>
