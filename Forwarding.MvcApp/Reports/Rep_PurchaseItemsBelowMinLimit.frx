  <Dictionary>
    <MsSqlDataConnection Name="Connection" ConnectionString="rijcmlq+rW0RkboK+/8CKGGYUID3ctBV8q9SvKYxl3iiE7vBnh7Tgou0+4WFf3NfmPSvHVFtHJVZLL/i3PN7CkdFc/1A7YXJU6T13VfFIAjI9Ib2eHK43COXIAb1+oG8abaGcWEZGpgJFPBP3+b+JobTIAbFImpu7AL5/m4I+6ScGE9e6WjDfiveqdM4GY1NsEAX+IA1+1MHRXd+NPrNY+fdXmYVA==">
      <TableDataSource Name="PurchaseItem" Alias="PurchaseItems" DataType="System.Int32" Enabled="true" TableName="PurchaseItem" SelectCommand="SELECT P.Code,P.Name,P.MinQty,SUM(I.AvailableQuantity) AS AvailableQuantity&#13;&#10;FROM PurchaseItem P&#13;&#10;INNER JOIN vwWH_Inventory I ON I.PurchaseItemID = P.ID&#13;&#10;WHERE P.MinQty IS NOT NULL AND P.MinQty &gt; 0&#13;&#10;GROUP BY P.ID,P.MinQty,P.Code,P.Name&#13;&#10;HAVING P.MinQty &gt; SUM(I.AvailableQuantity)">
        <Column Name="Code" DataType="System.String"/>
        <Column Name="Name" DataType="System.String"/>
        <Column Name="MinQty" DataType="System.Decimal"/>
        <Column Name="AvailableQuantity" DataType="System.Decimal"/>
        <Column Name="Logo" DataType="System.String" PropName="Column" Calculated="true" Expression="[Logo]"/>
      </TableDataSource>
    </MsSqlDataConnection>
    <Parameter Name="Logo" DataType="System.String"/>
  </Dictionary>
