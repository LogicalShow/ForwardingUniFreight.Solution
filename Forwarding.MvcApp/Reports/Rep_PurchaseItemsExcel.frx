    private void Data1_AfterData(object sender, EventArgs e)
    {  
      if( ((String)Report.GetParameterValue(&quot;CompanyName&quot;)) == &quot;EF&quot; )
      {
        Cell65.Visible=true;
        Cell66.Visible=true;
        Cell67.Visible=true;
      }
    }       
    private void DataHeader1_AfterData(object sender, EventArgs e)
    {                           
      if( ((String)Report.GetParameterValue(&quot;CompanyName&quot;)) == &quot;EF&quot; )
      {
        Cell28.Visible=true;
        Cell29.Visible=true;
        Cell30.Visible=true;
        
        Cell26.Text=&quot;Item Code&quot;;
        Cell27.Text=&quot;Description&quot;;
      }          
    }
  }
}
