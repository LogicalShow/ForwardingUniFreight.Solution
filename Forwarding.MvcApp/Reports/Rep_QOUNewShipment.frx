        <Column Name="BankFeesAirExp" DataType="System.Decimal"/>
        <Column Name="DirectionType" DataType="System.Int32"/>
        <Column Name="TransportType" DataType="System.Int32"/>
        <Column Name="Commission" DataType="System.Decimal" PropName="Column" Calculated="true" Expression="IIf([Rep_QOUNewShipment.DirectionType]==1,[Rep_QOUNewShipment.QuolaCommissionImp]*[Rep_QOUNewShipment.ExRateQuolaCommissionImp],[Rep_QOUNewShipment.QuolaCommissionExp]*[Rep_QOUNewShipment.ExRateQuolaCommissionEXP])"/>
        <Column Name="Form4" DataType="System.Decimal" PropName="Column" Calculated="true" Expression="[Rep_QOUNewShipment.ExChangeForm4]*[Rep_QOUNewShipment.Form4CostAmount]"/>
        <Column Name="BankFees" DataType="System.Decimal" PropName="Column" Calculated="true" Expression="IIf([Rep_QOUNewShipment.DirectionType]==1&amp;&amp;[Rep_QOUNewShipment.TransportType]==1,[Rep_QOUNewShipment.BankFeesOcImp],IIf([Rep_QOUNewShipment.DirectionType]==1&amp;&amp;[Rep_QOUNewShipment.TransportType]==2,[Rep_QOUNewShipment.BankFeesAirImp],IIf([Rep_QOUNewShipment.DirectionType]==2&amp;&amp;[Rep_QOUNewShipment.TransportType]==1,[Rep_QOUNewShipment.BankFeesOcExp],IIf([Rep_QOUNewShipment.DirectionType]==2&amp;&amp;[Rep_QOUNewShipment.TransportType]==2,[Rep_QOUNewShipment.BankFeesAirExp],0))))"/>
        <Column Name="QCostAmount" DataType="System.Decimal"/>
        <Column Name="ChargeTypeID" DataType="System.Int32"/>
        <Column Name="CostExchangeRate" DataType="System.Decimal"/>
        <Column Name="x" DataType="System.Decimal" PropName="Column" Calculated="true" Expression="[Rep_QOUNewShipment.Form4] +[Rep_QOUNewShipment.commission]+[Rep_QOUNewShipment.BankFees]*[Rep_QOUNewShipment.ExchangeRate]+[Rep_QOUNewShipment.SwaftCostAmount]*[Rep_QOUNewShipment.ExChangeSwaft]"/>
        <Column Name="فرق الضريبة" DataType="System.Decimal" PropName="Column" Calculated="true" Expression="(([Rep_QOUNewShipment.x] + [Total10]) * 0.14) + ([Rep_QOUNewShipment.x] + [Total10])"/>
        <Column Name="EXWOcImp" DataType="System.Decimal"/>
        <Column Name="EXWOcExp" DataType="System.Decimal"/>
        <Column Name="EXWAirImp" DataType="System.Decimal"/>
        <Column Name="EXWAirExp" DataType="System.Decimal"/>
        <Column Name="CustomsAcceptedValue" DataType="System.Decimal"/>
        <Column Name="CommodityName" DataType="System.String"/>
        <Column Name="POLName" DataType="System.String"/>
        <Column Name="PODName" DataType="System.String"/>
        <Column Name="CCAInvoiceNumber" DataType="System.String"/>
        <Column Name="CCAInsurance" DataType="System.String"/>
        <Column Name="CCADischargeValue" DataType="System.String"/>
        <Column Name="ExChangeForm4" DataType="System.Decimal"/>
        <Column Name="ExRateQuolaCommissionImp" DataType="System.Decimal"/>
        <Column Name="ExRateQuolaCommissionEXP" DataType="System.Decimal"/>
        <Column Name="ExRateBankFeesOcImp" DataType="System.Decimal"/>
        <Column Name="ExRateBankFeesOcEXP" DataType="System.Decimal"/>
        <Column Name="ExRateBankFeesAirIMP" DataType="System.Decimal"/>
        <Column Name="ExRateBankFeesAirEXP" DataType="System.Decimal"/>
        <Column Name="ExchangeRate" DataType="System.Decimal" PropName="Column" Calculated="true" Expression="IIf([Rep_QOUNewShipment.DirectionType]==1&amp;&amp;[Rep_QOUNewShipment.TransportType]==1,[Rep_QOUNewShipment.ExRateBankFeesOcImp],IIf([Rep_QOUNewShipment.DirectionType]==1&amp;&amp;[Rep_QOUNewShipment.TransportType]==2,[Rep_QOUNewShipment.ExRateBankFeesAirIMP],IIf([Rep_QOUNewShipment.DirectionType]==2&amp;&amp;[Rep_QOUNewShipment.TransportType]==1,[Rep_QOUNewShipment.ExRateBankFeesOcEXP],IIf([Rep_QOUNewShipment.DirectionType]==2&amp;&amp;[Rep_QOUNewShipment.TransportType]==2,[Rep_QOUNewShipment.ExRateBankFeesAirEXP],1))))"/>
        <Column Name="المسدد قبل الضريبة" DataType="System.Decimal" PropName="Column" Calculated="true" Expression="[Rep_QOUNewShipment.CustomsAcceptedValue] * 14/100"/>
        <Column Name="SwaftCostAmount" DataType="System.Decimal"/>
        <Column Name="ExChangeSwaft" DataType="System.Decimal"/>
        <CommandParameter Name="query" DataType="12" Expression="[query]" DefaultValue="Rep_QOUNewShipment 'WHERE 1=1'"/>
      </TableDataSource>
    </MsSqlDataConnection>
    <Parameter Name="Logo" DataType="System.String" Expression="[Logo]"/>
    <Parameter Name="Logo1" DataType="System.String" Expression="[Logo1]"/>
    <Parameter Name="query" DataType="System.String" Expression="[query]"/>
    <Parameter Name="Commission" DataType="System.Decimal" Expression="IIf([Rep_QOUNewShipment.DirectionType]==1,[Rep_QOUNewShipment.QuolaCommissionImp]*[Rep_QOUNewShipment.ExRateQuolaCommissionImp],[Rep_QOUNewShipment.QuolaCommissionExp]*[Rep_QOUNewShipment.ExRateQuolaCommissionImp])"/>
    <Parameter Name="Form4" DataType="System.Decimal" Expression="[Rep_QOUNewShipment.CostExchangeRate]*[Rep_QOUNewShipment.Form4CostAmount]"/>
    <Parameter Name="BankFees" DataType="System.Decimal" Expression="IIf([Rep_QOUNewShipment.DirectionType]==1&amp;&amp;[Rep_QOUNewShipment.TransportType]==1,[Rep_QOUNewShipment.BankFeesOcImp],IIf([Rep_QOUNewShipment.DirectionType]==1&amp;&amp;[Rep_QOUNewShipment.TransportType]==2,[Rep_QOUNewShipment.BankFeesOcExp],IIf([Rep_QOUNewShipment.DirectionType]==2&amp;&amp;[Rep_QOUNewShipment.TransportType]==1,[Rep_QOUNewShipment.BankFeesAirImp],IIf([Rep_QOUNewShipment.DirectionType]==2&amp;&amp;[Rep_QOUNewShipment.TransportType]==2,[Rep_QOUNewShipment.BankFeesAirExp],0))))"/>
    <Parameter Name="x" DataType="System.Decimal" Expression="IIf([Rep_QOUNewShipment.DirectionType]==1,[Rep_QOUNewShipment.QuolaCommissionImp]*[Rep_QOUNewShipment.CostExchangeRate]+[Rep_QOUNewShipment.Form4CostAmount]*[Rep_QOUNewShipment.CostExchangeRate]+[Rep_QOUNewShipment.BankFees]*[Rep_QOUNewShipment.CostExchangeRate],[Rep_QOUNewShipment.QuolaCommissionExp]*[Rep_QOUNewShipment.CostExchangeRate]+[Rep_QOUNewShipment.Form4CostAmount]*[Rep_QOUNewShipment.CostExchangeRate]+[Rep_QOUNewShipment.BankFees]*[Rep_QOUNewShipment.CostExchangeRate])"/>
    <Parameter Name="فرق الضريبة" DataType="System.Decimal" Expression="(([Rep_QOUNewShipment.x] + [Total10]) * 0.14) + ([Rep_QOUNewShipment.x] + [Total10])"/>
    <Parameter Name="ExchageRate" DataType="System.Decimal" Expression="IIf([Rep_QOUNewShipment.DirectionType]==1&amp;&amp;[Rep_QOUNewShipment.TransportType]==1,[Rep_QOUNewShipment.ExRateBankFeesOcImp],IIf([Rep_QOUNewShipment.DirectionType]==1&amp;&amp;[Rep_QOUNewShipment.TransportType]==2,[Rep_QOUNewShipment.ExRateBankFeesAirIMP],IIf([Rep_QOUNewShipment.DirectionType]==2&amp;&amp;[Rep_QOUNewShipment.TransportType]==1,[Rep_QOUNewShipment.ExRateBankFeesOcEXP],IIf([Rep_QOUNewShipment.DirectionType]==2&amp;&amp;[Rep_QOUNewShipment.TransportType]==2,[Rep_QOUNewShipment.ExRateBankFeesAirEXP],1))))"/>
    <Parameter Name="المسدد قبل الضريبة" DataType="System.Decimal" Expression="[Rep_QOUNewShipment.CustomsAcceptedValue] * 14/100"/>
    <Total Name="CostPrice*ChargeFee" Expression="[Rep_QOUNewShipment.CostPrice]*[Rep_QOUNewShipment.BankFeeCharges]"/>
    <Total Name="Commision Charges" Expression="[Rep_QOUNewShipment.commission]*[Rep_QOUNewShipment.CostPrice]"/>
    <Total Name="Total(TotalCost)" Expression="[Rep_QOUNewShipment.TotalCostEGP]"/>
    <Total Name="Total2" Expression="[Commission]+[Form4]+[BankFees]"/>
    <Total Name="Total10" Expression="[Rep_QOUNewShipment.QCostAmount]*[Rep_QOUNewShipment.CostExchangeRate]" Evaluator="Data2"/>
    <Total Name="Total11" Expression="[Rep_QOUNewShipment.QCostAmount]"/>
    <Total Name="xyz" Expression="[Rep_QOUNewShipment.Form4]" Evaluator="Data2"/>
    <Total Name="Total9" Expression="IIf([Rep_QOUNewShipment.CostExchangeRate]==1,[Rep_QOUNewShipment.CostExchangeRate]*[Rep_QOUNewShipment.QCostAmount],0)" Evaluator="Data2"/>
    <Total Name="Total8" Expression="IIf([Rep_QOUNewShipment.CostExchangeRate] !=1,[Rep_QOUNewShipment.QCostAmount],0)" Evaluator="Data2"/>
  </Dictionary>
