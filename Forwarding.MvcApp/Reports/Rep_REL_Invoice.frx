        <CommandParameter Name="MSOP" DataType="22" Expression="[Table.MasterOperationID]"/>
      </TableDataSource>
      <TableDataSource Name="Table8" Alias="package" DataType="System.Int32" Enabled="true" SelectCommand="SELECT sum (GrossWeight), SUBSTRING(&#10;    (&#10;        SELECT '-' + CONCAT(vwopd.Quantity,'x', vwopd.PackageTypeName) AS [data()]&#10;        FROM vwOperationContainersAndPackages VWOPD&#10;        WHERE VWOPD.OperationID = @OPID&#10;        FOR XML PATH('')&#10;    ), 2, 10000&#10;) AS Packages from vwOperationContainersAndPackages where OperationID = @OPID">
        <Column Name="Packages" DataType="System.String"/>
        <Column Name="Column1" DataType="System.Decimal"/>
        <CommandParameter Name="OPID" DataType="22" Expression="[Table.OperationID]"/>
      </TableDataSource>
