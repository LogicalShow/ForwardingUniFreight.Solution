    <ReportSummaryBand Name="ReportSummary1" Top="618.25" Width="718.2" Height="198.45">
      <TextObject Name="Text1" Left="-9.45" Top="9.45" Width="718.2" Height="122.85" Text="يرجي العلم ان مشمول البوليصة الواردة بعاليه قد وردت باسمنا بصفتنا وكلاء شحن فقط وهي لا تخصنا وقد تنازلنا عن مشمول&#13;&#10;الرساله الي صاحبها بشرط وصول الشحنة الي ميناء التفريغ دون مسولية علي التوكيل, و اقر المستفيد بالتزامه امام جميع الجهات&#13;&#10;المعنيه سواء القانونيه او غيرها بتسديد كافه الالتزامات المادية من غرامات وارضيات و خلافه للمستحق, أن وكيل الشحن ليس له&#13;&#10;.مسؤلية بعد تسليم خطاب التنازل الى العميل او من فوضه حتي في حالة عدم استلام اذن التسليم من الخط الملاحي" HorzAlign="Right" VertAlign="Center" Font="Arial, 11pt, style=Bold" LineHeight="27"/>
      <TextObject Name="Text174" Left="217.35" Top="132.3" Width="292.95" Height="28.35" Text="... مع وافر التحية  " HorzAlign="Center" VertAlign="Center" Font="Arial, 12pt, style=Bold"/>
      <TextObject Name="Text175" Top="170.1" Width="292.95" Height="28.35" Text="Relan Global Logistic Services" VertAlign="Center" Font="Arial, 12pt, style=Bold"/>
