  <Dictionary>
    <MsSqlDataConnection Name="Connection" ConnectionString="rijcmlq+rW0RkboK+/8CKGGYUID3ctBV8q9SvKYxl3iiE7vBnh7Tgou0+4WFf3NfmPSvHVF6q/wtYSzyzK0FSBR4RgMnJiOg3+1uczm9/Bqn36i7bd/C6YZRLntfe30aIXgSqMDU98lxRDnP45hciAAsVWsXEP9gOJ/bq5B+52Z45kA9bPIDFbEy8c/a8Dwmhx7q2+k">
      <TableDataSource Name="Table1" DataType="System.Int32" Enabled="true" SelectCommand="SELECT &#13;&#10; O.ConsigneeID&#13;&#10; ,MAX(O.ConsigneeName) AS ConsigneeName&#13;&#10; ,COUNT(*) AS Total&#13;&#10; ,COUNT(CASE WHEN MONTH(O.OpenDate) = 1  THEN 1 END) AS JAN&#13;&#10; ,COUNT(CASE WHEN MONTH(O.OpenDate) = 2  THEN 1 END) AS Feb&#13;&#10; ,COUNT(CASE WHEN MONTH(O.OpenDate) = 3  THEN 1 END) AS Mar&#13;&#10; ,COUNT(CASE WHEN MONTH(O.OpenDate) = 4  THEN 1 END) AS Apr&#13;&#10; ,COUNT(CASE WHEN MONTH(O.OpenDate) = 5  THEN 1 END) AS May&#13;&#10; ,COUNT(CASE WHEN MONTH(O.OpenDate) = 6  THEN 1 END) AS June&#13;&#10; ,COUNT(CASE WHEN MONTH(O.OpenDate) = 7  THEN 1 END) AS July&#13;&#10; ,COUNT(CASE WHEN MONTH(O.OpenDate) = 8  THEN 1 END) AS Aug&#13;&#10; ,COUNT(CASE WHEN MONTH(O.OpenDate) = 9  THEN 1 END) AS Sep&#13;&#10; ,COUNT(CASE WHEN MONTH(O.OpenDate) = 10 THEN 1 END) AS Oct&#13;&#10; ,COUNT(CASE WHEN MONTH(O.OpenDate) = 11 THEN 1 END) AS Nov&#13;&#10; ,COUNT(CASE WHEN MONTH(O.OpenDate) = 12 THEN 1 END) AS Dec&#13;&#10;FROM vwOperationsUNFReports O&#13;&#10;WHERE O.ConsigneeID IS NOT NULL&#13;&#10;AND BLType = 2 AND DirectionType = 1 AND ATAPODAlarmStatus = 1&#13;&#10;AND O.OpenDate &gt;= @creation AND O.OpenDate &lt;= @End&#13;&#10;AND (@NotifyIDFilter = '0' OR O.NotifyID = CAST(@NotifyIDFilter AS INT))&#13;&#10;AND (@OperationStageIDFilter = '0' OR O.OperationStageID = CAST(@OperationStageIDFilter AS INT))&#13;&#10;GROUP BY O.ConsigneeID&#13;&#10;HAVING COUNT(*) &gt; 0">
        <Column Name="ConsigneeID" DataType="System.Int32"/>
        <Column Name="ConsigneeName" DataType="System.String"/>
        <Column Name="JAN" DataType="System.Int32"/>
        <Column Name="Feb" DataType="System.Int32"/>
        <Column Name="Mar" DataType="System.Int32"/>
        <Column Name="Apr" DataType="System.Int32"/>
        <Column Name="May" DataType="System.Int32"/>
        <Column Name="June" DataType="System.Int32"/>
        <Column Name="July" DataType="System.Int32"/>
        <Column Name="Aug" DataType="System.Int32"/>
        <Column Name="Sep" DataType="System.Int32"/>
        <Column Name="Oct" DataType="System.Int32"/>
        <Column Name="Nov" DataType="System.Int32"/>
        <Column Name="Dec" DataType="System.Int32"/>
        <Column Name="Total" DataType="System.Int32"/>
        <CommandParameter Name="creation  " DataType="22" Expression="[FromDateForDB]" DefaultValue="1/1/2025"/>
        <CommandParameter Name="End" DataType="22" Expression="[ToDateForDB]" DefaultValue="[Format(&quot;{0:dd/MM/yyyy}&quot;, [Date])]"/>
        <CommandParameter Name="NotifyIDFilter" DataType="22" Expression="[NotifyIDFilter]" DefaultValue="0"/>
        <CommandParameter Name="OperationStageIDFilter" DataType="22" Expression="[OperationStageIDFilter]" DefaultValue="0"/>
      </TableDataSource>
    </MsSqlDataConnection>
    <Parameter Name="Type" DataType="System.String"/>
    <Parameter Name="WhereClause" DataType="System.String"/>
    <Parameter Name="query" DataType="System.String"/>
    <Parameter Name="ToDate" DataType="System.String"/>
    <Parameter Name="FromDate" DataType="System.String"/>
    <Parameter Name="ToDateForDB" DataType="System.String"/>
    <Parameter Name="FromDateForDB" DataType="System.String"/>
    <Parameter Name="NotifyIDFilter" DataType="System.String"/>
    <Parameter Name="OperationStageIDFilter" DataType="System.String"/>
    <Total Name="Total" TotalType="Count" Evaluator="Data1" PrintOn="GroupFooter1" ResetOnReprint="true"/>
  </Dictionary>
