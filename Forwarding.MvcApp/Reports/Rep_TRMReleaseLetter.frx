  <ReportPage Name="Page1" FirstPageSource="15" OtherPagesSource="15">
    <PageHeaderBand Name="PageHeader1" Width="718.2" Height="1096.2">
      <TextObject Name="Text1" Left="9.45" Top="94.5" Width="699.3" Height="28.35" Text="[IIf(FormatDateTime([Rep_TRMReleaseLetter.ReleaseDate],&quot;dd/MM/yyyy&quot;) == &quot;01/01/0001&quot;,&quot;&quot;,FormatDateTime([Rep_TRMReleaseLetter.ReleaseDate],&quot;dd/MM/yyyy&quot;))] : [Rep_TRMReleaseLetter.BranchLocalName] فى" HorzAlign="Right" Font="Arial, 12pt"/>
      <TextObject Name="Text2" Left="311.85" Top="132.3" Width="396.9" Height="18.9" Text="[Rep_TRMReleaseLetter.LineName]  : السادة" HorzAlign="Right" Font="Arial, 12pt"/>
      <TextObject Name="Text3" Left="485.85" Top="169.8" Width="151.2" Height="28.35" Text=",,,,    تحية طيبة و بعد" HorzAlign="Right" Font="Arial, 18pt"/>
      <TextObject Name="Text4" Left="127.05" Top="214" Width="576.45" Height="28.35" Text="[Rep_TRMReleaseLetter.ConsigneeName] / برجاء التكرم بتسليم السادة" HorzAlign="Right" Font="Arial, 12pt"/>
      <TextObject Name="Text5" Left="495.05" Top="255.2" Width="207.9" Height="28.35" Text=" : مشمول الرسالة التالى بياناتها " HorzAlign="Right" Font="Arial, 18pt"/>
      <TextObject Name="Text6" Left="264.6" Top="311.85" Width="387.45" Height="18.9" Text="[Rep_TRMReleaseLetter.MasterBL] : رقم البوليصة الكلية" HorzAlign="Right" Font="Arial, 12pt"/>
      <TextObject Name="Text7" Left="245.7" Top="349.65" Width="406.35" Height="18.9" Text="[Rep_TRMReleaseLetter.HouseNumber] : رقم البوليصة الفرعية " HorzAlign="Right" Font="Arial, 12pt"/>
      <TextObject Name="Text8" Left="236.25" Top="378" Width="415.8" Height="18.9" Text="[Rep_TRMReleaseLetter.GrossWeightSum] KG :  وزن اجمالى " HorzAlign="Right" Font="Arial, 12pt"/>
      <TextObject Name="Text9" Left="321.3" Top="406.35" Width="330.75" Height="18.9" Text="[Rep_TRMReleaseLetter.POLName] : وارد من ميناء " HorzAlign="Right" Font="Arial, 12pt"/>
      <TextObject Name="Text10" Left="425.25" Top="434.7" Width="226.8" Height="18.9" Text="[Rep_TRMReleaseLetter.VesselName] : على باخرة " HorzAlign="Right" Font="Arial, 12pt"/>
      <TextObject Name="Text11" Left="292.95" Top="472.5" Width="359.1" Height="18.9" Text="[Rep_TRMReleaseLetter.ContainerTypes] : عدد" HorzAlign="Right" Font="Arial, 12pt"/>
      <TextObject Name="Text12" Left="179.55" Top="434.7" Width="189" Height="18.9" Text="[Rep_TRMReleaseLetter.VoyageOrTruckNumber] : رحلة" Font="Arial, 12pt"/>
      <TextObject Name="Text13" Left="8.3" Top="522.55" Width="652.05" Height="37.8" Text="حيث ان مشمول هذه الرسالة لا تخصنا و انما تخص العميل المذكور مع تحصيل كافة مستحقاتكم من العميل دون الرجوع علينا بأدنى مسؤلية " HorzAlign="Right" Font="Arial, 12pt"/>
      <TextObject Name="Text14" Left="-18.9" Top="585.9" Width="680.4" Height="37.8" Text="[Rep_TRMReleaseLetter.AgentName] : و نحيط سيادتكم علما بان هذا التانك الاتى رقمه ملك لموكلنا" HorzAlign="Right" Font="Arial, 12pt"/>
      <TextObject Name="Text15" Left="9.45" Top="661.5" Width="661.5" Height="47.25" CanGrow="true" Text="[Rep_TRMReleaseLetter.TankNumbers]&#13;&#10;" HorzAlign="Center" Font="Arial, 12pt"/>
      <TextObject Name="Text16" Left="18.9" Top="727.65" Width="652.05" Height="28.35" Text="و سوف يتم صرف التانكات بمعرفة المستلمين بكشف اسنخلاص و رجوع التنكات داخل الدائرة الجمركية بمعرفة المستلمين " HorzAlign="Right" Font="Arial, 12pt"/>
      <TextObject Name="Text17" Left="47.25" Top="774.9" Width="604.8" Height="37.8" Text="على ان يتم تحصيل الغرامات اللازمة عند انتهاء فترة السماح المذكورة على البوليصة الفرعية بمعرفة ترانز مصر " HorzAlign="Right" Font="Arial, 12pt"/>
      <TextObject Name="Text18" Left="89.6" Top="859.75" Width="491.4" Height="37.8" Text=" .......و تفضلوا سيادتكم بقبول فائق التحية و الاحترام" HorzAlign="Center" Font="Arial, 12pt"/>
      <TextObject Name="Text19" Top="935.55" Width="330.75" Height="28.35" Text="ترانز مصر شیبنج كلیرنج أند تریدنج" HorzAlign="Center" Font="Arial, 12pt"/>
      <PictureObject Name="Picture1" Left="9.45" Width="699.3" Height="85.05" DataColumn="Rep_TRMReleaseLetter.Logo"/>
      <PictureObject Name="Picture2" Left="9.45" Top="973.35" Width="699.3" Height="122.85" SizeMode="StretchImage" DataColumn="Rep_TRMReleaseLetter.Logo1"/>
    </PageHeaderBand>
  </ReportPage>
