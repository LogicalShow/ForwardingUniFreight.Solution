      <TableDataSource Name="Table1" Alias="Receivables" DataType="System.Int32" Enabled="true" SelectCommand="select id, ChargeTypeName,Quantity,SalePrice,SaleAmount,Notes,ChargeTypeLocalName  from vwReceivables WHERE(DraftInvoiceID =@INVID or InvoiceID=@INVID)  And SaleAmount !=0">
