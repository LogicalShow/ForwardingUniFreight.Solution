  <ScriptText>using System;
using System.Collections;
using System.Collections.Generic;
using System.ComponentModel;
using System.Windows.Forms;
using System.Drawing;
using System.Data;
using FastReport;
using FastReport.Data;
using FastReport.Dialog;
using FastReport.Barcode;
using FastReport.Table;
using FastReport.Utils;

namespace FastReport
{
  public class ReportScript
  {                              
    private void Data1_AfterData(object sender, EventArgs e)
    {                                                                                           
      txtExtraTotal.Text = Convert.ToString(Convert.ToDecimal(txtBouns.Text)+Convert.ToDecimal(txtExtra.Text));
      txtDeductTotal.Text = Convert.ToString(Convert.ToDecimal(txtDeduct.Text)+Convert.ToDecimal(txtLoan.Text));
      txtTotal.Text = Convert.ToString(Convert.ToDecimal(txtExtraTotal.Text) + (Convert.ToDecimal(Report.GetParameterValue(&quot;Days&quot;)) * Convert.ToDecimal(txtSalary.Text)) - Convert.ToDecimal(txtDeductTotal.Text));
    }
  }
}
</ScriptText>
