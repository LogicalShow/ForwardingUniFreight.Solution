        <Column Name="NumberOf40RFContainers" DataType="System.Int32"/>
        <Column Name="NumberOf40OTContainers" DataType="System.Int32"/>
        <Column Name="NumberOfLCL" DataType="System.String"/>
        <CommandParameter Name="@query" DataType="12" Expression="[query]" DefaultValue="SELECT O.ID,O.Code,O.CustomerReference,O.ClientName,ISNULL(O.BookingNumbers,O.BookingNumber) BookingNumber,O.POLName,O.PODName,O.LineName,O.OpenDate LoadingDate,'' LoadingTime,O.CutOffDate,O.OpenDate ActualDeparture,O.VoyageOrTruckNumber,'' PickupAddress,'' TruckerName,'BOSLA' AS Bosla,'' IsLoaded,2 NumberOf20DCContainers,2 NumberOf40DCContainers,9 NumberOf40HCContainers,13 NumberOf20RFContainers,14 NumberOf40RFContainers,11 NumberOf40OTContainers,'' NumberOfLCL FROM vwOperations O"/>
      </TableDataSource>
    </MsSqlDataConnection>
    <Parameter Name="dummy" DataType="System.String"/>
  </Dictionary>
