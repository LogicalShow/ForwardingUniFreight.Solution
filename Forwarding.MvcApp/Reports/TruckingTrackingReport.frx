  <Dictionary>
    <MsSqlDataConnection Name="Connection" ConnectionString="rijcmlq+rW0RkboK+/8CKGGYUID3ctBV8q9SvKYxl3iiE7vBnh7Tgou0+4WFf3NfmPSvHVFdK1pGRuXb2ZqNrvvshfdvk1WTy4Q4X3n3sfovtvD12ZUZMgosSXIKCfex3Uxiv0ztNRpdBkVUVn6xObKSedOpcc6jTMR7CoRC+37+7/tXCLDT73rOQRxu2R+JRG3kt9K7ktECnOYnW3ok2nm2tEsMg==">
      <TableDataSource Name="Table" DataType="System.Int32" Enabled="true" SelectCommand="exec (@query)">
        <Column Name="ID" DataType="System.Int64"/>
        <Column Name="Code" DataType="System.String"/>
        <Column Name="ClientName" DataType="System.String"/>
        <Column Name="TruckerName" DataType="System.String"/>
        <Column Name="TruckingApprovalDate" DataType="System.DateTime"/>
        <Column Name="LoadingDate" DataType="System.DateTime"/>
        <CommandParameter Name="@query" DataType="12" Expression="[query]" DefaultValue="SELECT O.ID,O.Code,O.TruckerName,O.ClientName,(SELECT r.LoadingDate FROM Routings AS r WHERE r.OperationID=O.ID AND r.RoutingTypeID=30) LoadingDate,O.TruckingApprovalDate FROM vwOperations O"/>
      </TableDataSource>
    </MsSqlDataConnection>
    <Parameter Name="dummy" DataType="System.String"/>
  </Dictionary>
