using FastReport.Table;
using FastReport.Utils;

namespace FastReport
{
  public class ReportScript
  {         
    private void Text52_AfterData(object sender, EventArgs e)
    {
       string warehouseTo=Convert.ToString(Text52.Value);
      if(String.IsNullOrWhiteSpace(warehouseTo)||warehouseTo==&quot;0&quot;){
        Text52.Visible=false;
        Text53.Visible=false;
      }
      else{
        Text52.Visible=true;
        Text53.Visible=true;
      }
    }
  }
}
