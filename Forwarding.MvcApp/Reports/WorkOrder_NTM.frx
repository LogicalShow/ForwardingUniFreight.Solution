      <TableDataSource Name="Table" DataType="System.Int32" Enabled="true" SelectCommand="select C.name Customer,MOP.MasterBL MasterBL,OP.MasterBL MasterHBL,&#13;&#10;op.BLDate ArrivalDate,&#13;&#10;OCPP.GrossWeight ,OCPP.Quantity,&#13;&#10;PT.name PackageType ,CTS.Name Country,PRS.Name Ports,AGS.Name Agent,AGS.Address AgeNTAdress&#13;&#10;from operations OP&#13;&#10;left join Customers C on OP.ConsigneeID= C.ID&#13;&#10;left join operations MOP on MOP.ID = OP.MasterOperationID&#13;&#10;left join OperationContainersAndPackages OCPP on OCPP.OperationID=OP.ID&#13;&#10;left join Countries CTS on CTS.ID = OP.POLCountryID&#13;&#10;left join Ports PRS on PRS.ID = OP.pod&#13;&#10;left join PackageTypes PT on PT.id = OCPP.PackageTypeID&#13;&#10;left join Agents AGS on AGS.ID = MOP.AgentID&#13;&#10;where OP.id=@HID">
