        <Column Name="Quantity" DataType="System.Int32"/>
        <Column Name="PackageType" DataType="System.String"/>
        <Column Name="Country" DataType="System.String"/>
        <Column Name="Ports" DataType="System.String"/>
        <Column Name="Agent" DataType="System.String"/>
        <Column Name="AgeNTAdress" DataType="System.String"/>
        <CommandParameter Name="HID" DataType="22" Expression="[HID]"/>
