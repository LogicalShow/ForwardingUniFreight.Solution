<!-- start breadcrumb  -->
<ul id="ul-breadcrumb" class="breadcrumb no-border no-radius b-b b-light pull-in">
    <li>
        <a id="hl-homepage" href="javascript:void(0);">
            <i class="fa fa-home icon-home"></i><span>@Forwarding.MvcApp.App_Resources.App_Resources.HomePage</span>
        </a>
    </li>
    <li>
        <a id="Accounting" href="javascript:void(0);" onclick="LoadViews('AccountingReports')">
            @Forwarding.MvcApp.App_Resources.App_Resources.Accounting
    </a>
</li>
<li>
    <a id="AccountingReports" href="javascript:void(0);" onclick="LoadViews('AccountingReports')">
        @Forwarding.MvcApp.App_Resources.App_Resources.Reports
</a>
</li>
<li class="active">@Forwarding.MvcApp.App_Resources.App_Resources.JobSummery</li>
</ul>
<!-- end breadcrumb  -->

<div id="div-TrialBalance">
    <div id="div-Data">
        <div id="div-Options">
            <div id="div-Action" class="radius-top-left-right">
            </div>
        </div>
        <section class="panel panel-default">
            <header class="panel-heading">
                <h3 class="m-b-none">
                    @Forwarding.MvcApp.App_Resources.App_Resources.JobSummery
                </h3>
            </header>
            <div class="row text-sm wrapper hidden-print m-t-n-sm">
                <div class="form-group col-sm-2 classAllJob">
                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.From</label>
                    <input id="txtFromDate" readonly="readonly" type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="background-color:white; cursor:text;" class="input-sm datepicker-input form-control" data-date-format="dd/mm/yyyy" placeholder="Select Date" />
                </div>
                <div class="form-group col-sm-2">
                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.To</label>
                    <input id="txtToDate" readonly="readonly" type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="background-color:white; cursor:text;" class="input-sm datepicker-input form-control" data-date-format="dd/mm/yyyy" placeholder="Select Date" />
                </div>

                <div class="input-group col-sm-2 hide">
                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.Status</label>
                    <select id="slStatus" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" class="form-control input-sm">
                        <option value="0">@Forwarding.MvcApp.App_Resources.App_Resources.All</option>
                        <option value="1">@Forwarding.MvcApp.App_Resources.App_Resources.Posted</option>
                        <option value="2">@Forwarding.MvcApp.App_Resources.App_Resources.UnPosted</option>
                    </select>
                </div>
                <div class="form-group col-sm-2 classAllJob">
                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.Group</label>
                    <select id="slAccountsGroup" class="form-control m-b input-sm" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" onchange="Details_FillCheckboxList();" data-required="false"></select>

                </div>
                <div class="input-group col-sm-4 clasStatement">
                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.Client</label>
                    <select id="slSubAccountGroup2" onchange="" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" class="form-control input-sm"></select>
                </div>
                <div class="input-group col-sm-2 clasStatement">
                    <label>Currency</label>
                    <select id="slCurrency" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" class="form-control input-sm"></select>
                </div>
                <div class="input-group col-sm-2 m-t-27 classAllJob">
                    <label class=""><input type="checkbox" id="cbSuppressReverseJVs" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.SuppressReverseJVs</label><br />
                </div>
                <div class="input-group col-sm-2 m-t-27 classAllJob">
                    <label class=""><input type="checkbox" id="cbSuppressForZeroes" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.SuppressForZeroes</label><br />
                </div>

            </div>
            <div class="row text-sm wrapper hidden-print m-t-n-sm">
                <div class="col-sm-2 text-left swapChildrenClass m-t-n classAllJob">
                    <select id="slPost" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" class="form-control input-sm">
                        <option value="2">All</option>
                        <option value="1">Posted</option>
                        <option value="0">UnPosted </option>
                    </select>
                </div>
                <!--Region Filter-->
                <div class="col-sm-1 text-left swapChildrenClass m-t-n">
                    <input type="radio" name="nameReportType" checked="checked" id="cbByJob" onchange="showHide()" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><b>&nbsp;By Job</b>
                </div>
                <div class="col-sm-2 text-left swapChildrenClass m-t-n">
                    <input type="radio" name="nameReportType" id="cbByJobNew" onchange="showHide()" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><b>&nbsp;By Job New&nbsp;</b>
                </div>
                <div class="col-sm-2 text-left swapChildrenClass m-t-n hidden">
                    <input type="radio" name="nameReportType" id="cbWithoutJob" onchange="" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><b>&nbsp;Without Job&nbsp;</b>
                </div>
                <div class="col-sm-2 text-left swapChildrenClass m-t-n">
                    <input type="radio" name="nameReportType" id="cbstatement" onchange="showHide()" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><b>&nbsp;statement of a/c for principal&nbsp;</b>
                </div>


            </div>
            <div class="row text-sm wrapper hidden-print m-t-n-sm">
                <!--Region Filter-->

                <div class="col-sm-4">
                    <button id="btn-ExportToExcel" type="button" onclick="Print_JobSummery_Excel();" class="btn btn-sm btn-lightblue m-t-md"><i class="fa fa-table"></i><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.TraExportExcelSheet&nbsp;</b></button>
                    @*<button id="btn-Print" type="button" onclick="IncomeStatement_Print('Print');" class="btn btn-sm btn-info m-t-md"><i class="fa fa-print"></i><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Print&nbsp;</b></button>*@
                    <button type="button" id="btnPrintPDA" class="btn btn-sm btn-info m-t-md" onclick="TrialBalance_Print('Print');">
                        <i><span class="glyphicon glyphicon-print"></span></i>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Print&nbsp;
                    </button>

                </div>
            </div>
            <div class="row text-sm wrapper hidden-print m-t-n-sm">


                <section id="secAccount" class="m-t-sm m-l col-sm-2 panel panel-default classAllJob" style="clear:both;">
                    <div class="">
                        <label class=""><input type="checkbox" id="cbCheckAllAccounts" onchange="JobSummery_cbCheckAllAccountsChanged(); CallGETActivityJobWithParameters();" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><u>&nbsp;Select All Accounts</u></label><br />
                    </div>
                    <div id="divCbAccount" onchange="JobSummery_DivCheckAccountChanged();" style="width:104%; height:370px; font-size:100%; overflow:scroll;">
                    </div>
                </section>
                <section id="secSubAccount" class="m-t-sm m-l col-sm-2 panel panel-default classAllJob">
                    <div class="">
                        <label class=""><input type="checkbox" id="cbCheckAllSubAccounts" onchange="SubAccount_cbCheckAllSubAccountsChanged();" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><u>&nbsp;Select All SubAccounts</u></label><br />
                    </div>
                    <div id="divCbSubAccount" style="width:104%; height:370px; font-size:100%; overflow:scroll;">
                    </div>
                </section>
                <section id="secActivityCenter" class="m-t-xs m-l col-sm-1 panel panel-default classAllJob">
                    <div class="">
                        <label class=""><input type="checkbox" id="cbCheckAllActivityCenters" onchange="JobSummery_cbCheckAllActivityCenterChanged();" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><u>&nbsp;Select all activity Centers</u></label><br />
                    </div>
                    <div id="divCbActivityCenter" onchange="JobSummery_DivCheckActivityCentersChanged();" style="width:104%; height:370px; font-size:100%; overflow:scroll;">
                    </div>
                </section>
                <section id="secActivityPort" class="m-t-xs m-l col-sm-2 panel panel-default classAllJob">
                    <div class="">
                        <label class=""><input type="checkbox" id="cbCheckAllActivityPorts" onchange="JobSummery_cbCheckAllActivityPortChanged();" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><u>&nbsp;Select all activity Ports</u></label><br />
                    </div>
                    <div id="divCbActivityPort" onchange="JobSummery_DivCheckActivityPortChanged();" style="width:104%; height:370px; font-size:100%; overflow:scroll;">
                    </div>
                </section>
                <section id="secVessel" class="m-t-xs m-l col-sm-2 panel panel-default classAllJob">
                    <div class="">
                        <label class=""><input type="checkbox" id="cbCheckAllVessel" onchange="JobSummery_cbCheckAllVesselChanged();" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><u>&nbsp;Select all Vessel</u></label><br />
                    </div>
                    <div id="divCbVessel" onchange="JobSummery_DivCheckVesselChanged();" style="width:104%; height:370px; font-size:100%; overflow:scroll;">
                    </div>
                </section>
                <section id="secJob" class="m-t-sm m-l col-sm-2 panel panel-default clasJob">
                    <div class="">
                        <label class=""><input type="checkbox" id="cbCheckAllJobs" onchange="TrialBalance_cbCheckAllJobChanged();" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><u>&nbsp;Select all activity Jobs</u></label><br />
                    </div>
                    <div id="divCbJob" onchange="" style="width:104%; height:370px; font-size:100%; overflow:scroll;">
                    </div>
                </section>
                <div class="input-group col-sm-2 classlSubAccountGroup">
                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.Job</label>
                    <select id="slSubAccountGroup" onchange="" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" class="form-control input-sm"></select>
                </div>

                <div id="hExportedTable" class="hide"></div>
                <table id="tblJobSummery" hidden></table>
            </div>


            <footer class="panel-footer hide">
                <div class="row">
                    <div class="col-sm-4 hidden-xs">
                        <select id="select-page-size" class="input-sm form-control input-s-sm inline">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                        <button id="btn-applypaging" class="btn btn-sm btn-default" type="button">
                            @Forwarding.MvcApp.App_Resources.App_Resources.Apply
                        </button>
                    </div>

                    <div id="div-Text-Total" class="col-sm-4 text-center">
                        <small class="text-muted inLine m-t-sm m-b-sm">
                            @Forwarding.MvcApp.App_Resources.App_Resources.Showing
                            <span id="spn-first-page-row"></span>- <span id="spn-last-page-row"></span> @Forwarding.MvcApp.App_Resources.App_Resources.Of
                            <span id="spn-total-count"></span> @Forwarding.MvcApp.App_Resources.App_Resources.Items
                        </small>
                    </div>
                    <div id="div-Pager" class="col-sm-4 text-right text-center-xs float-right"></div>
                </div>
            </footer>
        </section>
    </div>
</div>
