<!-- start breadcrumb  -->
<ul id="ul-breadcrumb" class="breadcrumb no-border no-radius b-b b-light pull-in">
    <li>
        <a id="hl-homepage" href="javascript:void(0);">
            <i class="fa fa-home icon-home"></i><span>@Forwarding.MvcApp.App_Resources.App_Resources.HomePage</span>
        </a>
    </li>
    <li>
        <a id="MasterData" href="javascript:void(0);" onclick="LoadViews('CRM')">
            @Forwarding.MvcApp.App_Resources.App_Resources.CRM
        </a>
    </li>
    <li>
        <a id="liTabName" href="javascript:void(0);" onclick="LoadViews('CRMBasicData')">
            @Forwarding.MvcApp.App_Resources.App_Resources.CRMBasicData
        </a>
    </li>
    <li class="active">@Forwarding.MvcApp.App_Resources.App_Resources.CRMCycleSettings</li>
</ul>
<!-- end breadcrumb  -->

<div id="div-CRMCycleSettingsModal">
    <!-- Add / Edit Region Modal --> <!--data-keyboard="false" data-backdrop="false" to prevent modal closure on pressing escape and pressing outside the modal-->
    <!-- Region Options & Template  -->

    <div id="div-Data">
        <div id="div-Options">
            <div id="div-Action" class="radius-top-left-right">
            </div>
        </div>
        <section class="panel panel-default">
            <header class="panel-heading">
                <h3 class="m-b-none">
                    @Forwarding.MvcApp.App_Resources.App_Resources.CRMCycleSettings
                </h3>
            </header>
            <!--Region the searh, delete, addnew-->
            <div class="row text-sm wrapper hidden-print ">
                <div id="div-main-options" class="col-sm-5 m-b-xs">
                    @*<button id="btn-NewAdd" onclick="CRMCycleSettings_ClearAllControls();" class="hide btn btn-warning btn-sm" data-toggle="modal" data-target="#CRMCycleSettingsModal"><i class="fa fa-plus"></i>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.New</button>*@
                    <div id="div-option-buttons" class="btn-group hide">
                        <button id="btn-Copy" type="button" class="btn btn-sm btn-default"><i class="fa fa-copy"></i>Copy </button>
                        <button id="btn-Print" type="button" class="btn btn-sm btn-default"><i class="fa fa-print"></i>Print </button>
                        <button id="btn-Send" type="button" class="btn btn-sm btn-default"><i class="fa fa-envelope-o"></i>Send </button>
                    </div>
                </div>
                <div id="div-search-option" class="col-sm-7">
                    <div id="div-search-controls" class="input-group col-sm-9 hide ">
                        <input id="txt-Search" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="text-transform:uppercase" type="text" class="input-sm form-control" binding-name="SearchPlaceHolder" binding-prop="placeholder" placeholder="Search Code / Name / Arabic Name">
                        <span class="input-group-btn">
                            <button id="btn-search" class="btn btn-sm btn-primary" type="button" onclick="CRMCycleSettings_LoadingWithPaging();"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                    <div class="float-right col-sm-1 hide ">
                        <button id="btn-Delete" type="button" class="float-right btn btn-sm btn-danger m-r-n"><i class="fa fa-trash-o"></i>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Delete</button>
                    </div>
                </div>
            </div>
            <!--Region the searh, delete, addnew-->
            <!--Region: table header-->
            <div class="table-responsive">
                <table id="tblCRMCycleSettings" class="table table-striped b-t b-light text-sm  table-hover">
                    <thead>
                        <tr>
                            <th class="th-sortable" data-toggle="class">
                                Setting Name
                            </th>
                            <th class="th-sortable hide" data-toggle="class">
                                ActionID
                            </th>
                            <th class="th-sortable hide" data-toggle="class">
                                StatusID
                            </th>

                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <!--Region: table header-->
          
        </section>
    </div>
</div>

<div id="div-SetCRMCycle">
    <!-- Add / Edit Region Modal --> <!--data-keyboard="false" data-backdrop="false" to prevent modal closure on pressing escape and pressing outside the modal-->
    <div class="modal fade" id="CRMCycleModal" tabindex="-1" data-keyboard="true" data-backdrop="false" role="dialog" aria-labelledby="CRMCycleModalLabel" aria-hidden="true">
        <div class="modal-dialog modalwidth-50">
            @*<div class="modal-content modalwidth-100">*@
            <div class="modal-content">
                <div class="modal-header">
                    <h3 class="m-b-none">
                        Default follow-up procedure to create a sales deal&nbsp;<label id="lblShown" purpose="dynamicLabel" class="static-text-primary"></label>
                    </h3>
                </div>
                <!-- Region Add / Edit Region Form -->
                <div class="modal-body">
                    <div class="span7 form vertical-mode" id="CRM_Actions-form">
                        <fieldset>
                            <div class="form-group pull-in  has-error clearfix">
                                <!-- start alert message region -->
                                <div class="alert alert-danger div-error">
                                    @Forwarding.MvcApp.App_Resources.App_Resources.ErrorMessage
                                </div>
                                <div class="form-group col-sm-4 hide">
                                    <label>ID</label>
                                    <input type="text" disabled id="SettingID" class="input-sm form-control parsley-validated">
                                </div>
                                <div class="form-group col-sm-4">
                                    <label>Sales lead action</label>
                                    <select id="slAction" class="input-sm form-control parsley-validated" onchange="" data-required="true"></select>
                                </div>
                                <div class="form-group col-sm-4">
                                    <label>Sales lead status</label>
                                    <select id="slStatus" class="input-sm form-control parsley-validated" onchange="" data-required="true"></select>
                                </div>
                            </div>
                        </fieldset>
                    </div>
                </div>
                <!-- Endregion Add / Edit Region Form -->
                <div class="modal-footer">
                    <button type="button" id="btnSave" class="btn btn-primary btn-sm">
                        <span class="glyphicon glyphicon-save"></span>@Forwarding.MvcApp.App_Resources.App_Resources.Save
                    </button>
                    <button class="btnClose btn btn-link btn-sm" id="btnClose" data-dismiss="modal" aria-hidden="true">@Forwarding.MvcApp.App_Resources.App_Resources.Close</button><!--sherif: i added an id and the onclick fn go set the timelocked in the DB to null-->

                </div>
            </div>
        </div>
    </div>

</div>