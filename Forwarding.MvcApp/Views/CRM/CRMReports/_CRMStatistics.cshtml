<!-- start breadcrumb  -->
<ul id="ul-breadcrumb" class="breadcrumb no-border no-radius b-b b-light pull-in">
    <li>
        <a id="hl-homepage" href="javascript:void(0);">
            <i class="fa fa-home icon-home"></i><span>@Forwarding.MvcApp.App_Resources.App_Resources.HomePage</span>
        </a>
    </li>
    <li>
        <a id="MasterData" href="javascript:void(0);" onclick="LoadViews('CRM')">
            @Forwarding.MvcApp.App_Resources.App_Resources.CRM
        </a>
    </li>
    <li>
        <a id="CRMReports" href="javascript:void(0);" onclick="LoadViews(id)">
            @Forwarding.MvcApp.App_Resources.App_Resources.CRMReports
        </a>
    </li>
    <li class="active">@Forwarding.MvcApp.App_Resources.App_Resources.CRMStatistics</li>
</ul>
<!-- end breadcrumb  -->

<div id="div-CRMSalesReport">
    <!-- Add / Edit Region Modal --> <!--data-keyboard="false" data-backdrop="false" to prevent modal closure on pressing escape and pressing outside the modal-->
    <!-- Region Options & Template  -->

    <div id="div-Data">
        <section class="panel panel-default">
            <header class="panel-heading">
                <h3 class="m-b-none">
                    @Forwarding.MvcApp.App_Resources.App_Resources.FilterBy
                </h3>
            </header>
            <div class="m-t-sm">
                <div class="span7 form" id="Search-form">
                    <fieldset>
                        <div class="row" style="margin:5px;">
                            <!--Print-->
                            <div class="form-group has-error  col-sm-1">
                                <div class="col-sm-12">
                                    <button id="btn-print" type="button" class="btn btn-lightblue btn-sm m-t-md" onclick="CRMStatistics_Print('Print');"><i class="fa fa-print"></i><b>&nbsp;Print</b></button>
                                </div>
                            </div>

                            <!--Export Excel-->
                            <div class="form-group has-error col-sm-1">
                                <div class="col-sm-12">
                                    <button id="btn-ExportExcel" type="button" class="btn btn-primary btn-sm m-t-md" onclick="CRMStatistics_Print('Excel');"><i class="fa fa-table"></i><b>&nbsp;Export Excel</b></button>
                                </div>
                            </div>
                        </div>
                        <div class="form-group pull-in row">

                            <!--Report Name-->
                            <div class="form-group has-error col-sm-3">
                                <div class="col-sm-12">
                                    <label>Report</label>
                                    <select id="slReportName" class="input-sm form-control" onchange="">
                                        <option value="1">Stages per sales person report</option>
                                        <option value="2">Stages report</option>
                                        <option value="3">Pipeline report</option>
                                        <option value="4">Stage Status report</option>
                                        <option value="5">Source report</option>
                                        <option value="6">Sales stages report</option>
                                        <option value="7">Sales report</option>
                                    </select>
                                </div>
                            </div>

                            <!--CRM Stage-->
                            <div class="form-group has-error col-sm-3 hide">
                                <div class="col-sm-12">
                                    <label>CRM Stage</label>
                                    <select id="slCRMStage" class="input-sm form-control" onchange="">
                                        <option value="1">Lead</option>
                                        <option value="2">Deal</option>
                                        <option value="3">Oppurtunity</option>
                                        <option value="4">New Customer</option>
                                    </select>
                                </div>
                            </div>

                            <!--Source-->
                            <div class="form-group has-error col-sm-2 hide">
                                <div class="col-sm-12">
                                    <label>Source</label>
                                    <select id="slSource" class="input-sm form-control" onchange="">
                                    </select>
                                </div>
                            </div>

                            <!--From Date-->
                            <div class="form-group col-sm-2">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.From</label>
                                <input id="txtFromDate" readonly="readonly" type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="background-color:white; cursor:text;" class="input-sm datepicker-input form-control" data-date-format="dd/mm/yyyy" placeholder="Select Date" />
                            </div>

                            <!--To Date-->
                            <div class="form-group col-sm-2">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.To</label>
                                <input id="txtToDate" readonly="readonly" type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="background-color:white; cursor:text;" class="input-sm datepicker-input form-control" data-date-format="dd/mm/yyyy" placeholder="Select Date" />
                            </div>

                            <!--Select multiple CRM stages-->
                            <div id="slMultipleStages" class="form-group hide">
                                <div class="row col-sm-2">
                                    <div class="col-sm-12">
                                        <div class="row form-check">
                                            <input id="cbIsLead" type="checkbox" class="form-check-input" />
                                            <label class="form-check-label" for="cbIsLead">Lead</label>
                                        </div>
                                        <div class="row form-check">
                                            <input id="cbIsDeal" type="checkbox" class="form-check-input" />
                                            <label class="form-check-label" for="cbIsDeal">Deal</label>
                                        </div>
                                        <div class="row form-check">
                                            <input id="cbIsOppurtunity" type="checkbox" class="form-check-input" />
                                            <label class="form-check-label" for="cbIsOppurtunity">Oppurtunity</label>
                                        </div>
                                        <div class="row form-check">
                                            <input id="cbIsCustomer" type="checkbox" class="form-check-input" />
                                            <label class="form-check-label" for="cbIsCustomer">Customer</label>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            

                        </div>

                        <div class="form-group pull-right    row">

                            <div class="col-sm-12 ">
                                <br />
                                &nbsp;&nbsp;&nbsp;
                               
                            </div>
                        </div>

                        <div class="row">
                            <!--Salesmen-->
                            <div class="form-group col-sm-3 m-t-n" style="clear:both;margin:10px;">
                                <div class="form-group">
                                    <label>Salesmen</label>
                                    <div id="slSalesman" style="border:solid 3px black!important;height:300px;overflow-y:scroll;border-radius:5px;padding:5px">
                                        <input type="checkbox" checked id="cbSelectAll"/>
                                        <label for="cbSelectAll"><b>Select all</b></label>
                                        <ul id="ul_Salesman"></ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>
            <footer class="panel-footer"></footer>
            <!--Region: footer-->
        </section>
    </div>
</div>
<input type="hidden" id="hExportedTable" />