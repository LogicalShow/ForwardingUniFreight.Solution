<!--WH_ConsolGateIn Search-->
<div id="div-WH_CFS_GateIn">
    <!-- Region Options & Template  -->
    <div id="div-Data">
        <div id="div-Options">
            <div id="div-Action" class="radius-top-left-right">
            </div>
        </div>
        <section class="panel panel-default">
            <header class="panel-heading">
                <h3 class="m-b-none">@Forwarding.MvcApp.App_Resources.App_Resources.WH_CFS_GateIn</h3>
            </header>
            <!--Region the searh, delete, addnew-->
            <div class="row text-sm wrapper">
                <div id="div-main-options">
                    <!--Region Filter-->
                    <div class="form-group col-sm-2">

                    </div>

                    <div id="div-search-controls" class="input-group col-sm-5 m-l-n m-t-22">
                        <input id="txt-Search" autocomplete="off" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="text-transform:uppercase" type="text" class="input-sm form-control" binding-name="SearchPlaceHolder" binding-prop="placeholder" placeholder="Search House Number" title="Search House Number">
                        <span class="input-group-btn">
                            <button id="btn-search" title="" class="btn btn-sm btn-primary" type="button" onclick="WH_CFS_GateIn_LoadWithPagingWithWhereClauseAndOrderBy();"><i class="fa fa-search"></i></button>
                        </span>
                    </div>

                    <div class="form-group col-sm-3 m-t-22">
                        <button class="btn btn-sm btn-primary" data-toggle="modal" data-target="#FilterOptionsModal">
                            <i class="fa fa-filter"></i>&nbsp;Filter
                        </button>
                        <button class="btn btn-sm btn-warning m-l-xs" onclick="ClearAll('#FilterOptionsModal'); WH_CFS_GateIn_LoadWithPagingWithWhereClauseAndOrderBy();">
                            <i class="fa fa-eraser"></i>&nbsp;Clear
                        </button>
                    </div>

                    <div class="form-group col-sm-2 hide">
                        <button id="btn-NewAdd" class="btn btn-warning btn-sm m-t-22 float-right hide" data-toggle="modal" data-target="" onclick="WH_CFS_GateIn_ContainersClearAllControls();"><i class="fa fa-plus"></i>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.AddContainers</button>
                    </div>

                    <!--Region: table header-->
                    <div class="table-responsive">
                        <table id="tblWH_CFS_GateIn" class="table table-striped b-t b-light text-sm table-hover" style="font-size:90%;">
                            <thead>
                                <tr>
                                    <th>@Forwarding.MvcApp.App_Resources.App_Resources.OperationNumber</th>
                                    <th>@Forwarding.MvcApp.App_Resources.App_Resources.MasterBL</th>
                                    <th>@Forwarding.MvcApp.App_Resources.App_Resources.ContainerNumber</th>
                                    <th>@Forwarding.MvcApp.App_Resources.App_Resources.HouseNumber</th>
                                    <th>@Forwarding.MvcApp.App_Resources.App_Resources.Consignee</th>
                                    <th>@Forwarding.MvcApp.App_Resources.App_Resources.BookingParty</th>
                                    <th class="rounded-right hide"></th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                    <!--Region: EOF table header-->
                    <!--Region: table footer-->
                    <footer class="panel-footer">
                        <div class="row">
                            <div class="col-sm-4 hidden-xs">
                                <select id="select-page-size" class="input-sm form-control input-s-sm inline">
                                    <option value="10">10</option>
                                    <option value="25">25</option>
                                    <option value="50">50</option>
                                </select>
                                <button id="btn-applypaging" class="btn btn-sm btn-default" type="button">
                                    @Forwarding.MvcApp.App_Resources.App_Resources.Apply
                                </button>
                            </div>
                            <div id="div-Text-Total" class="col-sm-4 text-center">
                                <small class="text-muted inline m-t-sm m-b-sm">
                                    @Forwarding.MvcApp.App_Resources.App_Resources.Showing
                                    <span id="spn-first-page-row"></span>- <span id="spn-last-page-row"></span> @Forwarding.MvcApp.App_Resources.App_Resources.Of
                                    <span id="spn-total-count"></span> @Forwarding.MvcApp.App_Resources.App_Resources.Items
                                </small>
                            </div>
                            <div id="div-Pager" class="col-sm-4 text-right text-center-xs float-right"></div>
                        </div>
                    </footer>
                    <!--Region: EOF table footer-->

                </div><!--EOF Region Main-Options-->
            </div>
            <!--EOF Region the searh, delete, addnew-->
        </section>
    </div>
</div>

<!--FilterOptionsModal-->
<div class="modal fade" id="FilterOptionsModal" tabindex="-1" data-keyboard="true" data-backdrop="false" role="dialog" aria-hidden="true">
    <div class="modal-dialog modalwidth-100">
        <div class="modal-content m-t-n-lg">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h3 class="m-b-none"><label class="static-text-primary">Filter Options</label></h3>
            </div>
            <div class="modal-body">
                <div class="span7 form vertical-mode m-t-sm">
                    <fieldset>
                        <div class="m-t-n classSearchOptions">
                            <div class="form-group col-sm-2">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.OperationNumber</label>
                                <input id="txtFilterOperationNumber" type="text" class="form-control input-sm" style="text-transform:uppercase" />
                            </div>
                
                            <div class="form-group col-sm-2">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.ContainerNumber</label>
                                <input id="txtFilterContainerNumber" type="text" class="form-control input-sm" style="text-transform:uppercase" />
                            </div>
                            <div class="form-group col-sm-2">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.MasterBL</label>
                                <input id="txtFilterMasterBL" type="text" class="form-control input-sm" style="text-transform:uppercase" />
                            </div>
                            <div class="form-group col-sm-2">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.HouseNumber</label>
                                <input id="txtFilterHouseNumber" type="text" class="form-control input-sm" style="text-transform:uppercase" />
                            </div>
                            <div class="form-group col-sm-2">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.Consignee</label>
                                <input id="txtFilterConsignee" type="text" class="form-control input-sm" style="text-transform:uppercase" />
                            </div>
                            <div class="form-group col-sm-2">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.BookingParty</label>
                                <input id="txtFilterBookingParty" type="text" class="form-control input-sm" style="text-transform:uppercase" />
                            </div>
                            <div class="form-group col-sm-2">
                                <label>Gross Weight</label>
                                <input id="txtFilterGrossWeight" type="text" class="form-control input-sm" />
                            </div>
                            <div class="form-group col-sm-2">
                                <label>Net Weight</label>
                                <input id="txtFilterNetWeight" type="text" class="form-control input-sm" />
                            </div>
                            <div class="form-group col-sm-2">
                                <label>Volume</label>
                                <input id="txtFilterVolume" type="text" class="form-control input-sm" />
                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" onclick="ClearAll('#FilterOptionsModal');" class="btn btn-sm btn-warning"><i class="fa fa-eraser"></i>&nbsp;Clear Filters</button>
                <button type="button" class="btn btn-sm btn-primary" data-dismiss="modal" onclick="WH_CFS_GateIn_LoadWithPagingWithWhereClauseAndOrderBy();"><i class="fa fa-search"></i>&nbsp;Search</button>
            </div>
        </div>
    </div>
</div>

