                                        <label class="m-l swapChildrenClass"><input type="radio" id="cbIsMaster" onchange="Operations_BLTypeChanged(); Operations_AdjustControlsSettings(); Operations_ShowHideContainerControls();" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" name="cbBLType" value="3">&nbsp;<i class='fa fa-book master-icon-style' />&nbsp;<span id="spanCbIsMaster">@Forwarding.MvcApp.App_Resources.App_Resources.Master</span></label><br />
                                    </section>
                                    <section id="secDirectionType" class="panel panel-default m-t-n">
                                        <header class="panel-heading font-bold">@Forwarding.MvcApp.App_Resources.App_Resources.Direction</header>
                                        <label class="m-l swapChildrenClass"><input type="radio" id="cbIsImport" onchange="DirectionType_SetIconNameAndStyle();Operations_SetCloseDate('txtOperationOpenDate', 'txtOperationCloseDate');" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" name="cbDirectionType" value="1">&nbsp;<i class='fa fa-arrow-circle-down import-icon-style' />&nbsp;<span>@Forwarding.MvcApp.App_Resources.App_Resources.Import</span></label><br />
                                        <label class="m-l swapChildrenClass"><input type="radio" id="cbIsExport" onchange="DirectionType_SetIconNameAndStyle();Operations_SetCloseDate('txtOperationOpenDate', 'txtOperationCloseDate');" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" name="cbDirectionType" value="2">&nbsp;<i class='fa fa-external-link export-icon-style' />&nbsp;<span>@Forwarding.MvcApp.App_Resources.App_Resources.Export</span></label><br />
                                        <label class="m-l swapChildrenClass"><input type="radio" id="cbIsDomestic" onchange="DirectionType_SetIconNameAndStyle();Operations_SetCloseDate('txtOperationOpenDate', 'txtOperationCloseDate');" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" name="cbDirectionType" value="3">&nbsp;<i class='fa fa-home domestic-icon-style' />&nbsp;<span>@Forwarding.MvcApp.App_Resources.App_Resources.Domestic</span></label><br />
