<div class="modal fade" id="ShipmentModal" tabindex="-1" style="z-index: 1040;" data-keyboard="true" data-backdrop="false" role="dialog" aria-labelledby="ShipmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modalwidth-100 m-t-n-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true" title="Close">
                    &times;
                </button>
                <h3 class="m-b-none">
                    Inspection Data &nbsp;<label id="lblShownShipment" purpose="dynamicLabel" class="static-text-primary"></label>
                </h3>
            </div>
            <!-- Region Add / Edit Region Form -->
            <div class="modal-body">
                <div class="span7 form vertical-mode" id="Shipment-form">
                    <fieldset>
                        <div class="form-group pull-in  has-error clearfix">
                            <input id="hShipmentID" type="hidden" />
                            <input id="hHouseParentID" type="hidden" />
                            <input id="hInspectionID" type="hidden" />

                            <div class="col-sm-2">
                                <label>Inspection Date</label>
                                <input id="txtInspectionDate" type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" class="datepicker-input form-control input-sm" data-required="true" data-date-format="dd/mm/yyyy" placeholder="Select Date" />
                            </div>
                            <div class="col-sm-2">
                                <label>Inspector Name</label>
                                <input type="text" id="txtInspectorName" onkeypress="DisableEnterKey(id);" onfocus="DisableEnterKey(id);" class="form-control parsley-validated input-sm" data-required="true" maxlength="90" placeholder="Inspector Name.." style="text-transform:uppercase;" />
                            </div>
                            <div class="form-group col-sm-8">

                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.Notes</label>
                                <textarea id="txtInspectionNotes" type="text" maxlength="500" class="form-control m-b input-sm" data-required="false" style="text-transform:uppercase;overflow-y:scroll;height:100px;"></textarea>
                            </div>
                        </div>


                        <!--EOF Wizard-->
                        @*</div>*@
                    </fieldset>
                </div>
            </div>
            <!-- Endregion Add / Edit Region Form -->
            <div class="modal-footer m-t-n-lg">

                <button type="button" id="btnSaveShipment" class="btn btn-primary btn-sm">
                    <span class="glyphicon glyphicon-save"></span>@Forwarding.MvcApp.App_Resources.App_Resources.Save
                </button>

                <button class="btn btn-link btn-sm" data-dismiss="modal" aria-hidden="true">@Forwarding.MvcApp.App_Resources.App_Resources.Close</button><!--sherif: i added an id and the onclick fn go set the timelocked in the DB to null-->
            </div>
        </div>
    </div>
</div>
