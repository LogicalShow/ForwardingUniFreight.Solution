                                        <header class="panel-heading font-bold">@Forwarding.MvcApp.App_Resources.App_Resources.BLType</header>
                                        <label class="m-l swapChildrenClass"><input type="radio" id="cbIsDirect" onchange="Operations_BLTypeChanged(); Operations_AdjustControlsSettings(); Operations_ShowHideContainerControls();" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" name="cbBLType" value="1" checked="checked">&nbsp;<i class='fa fa-indent direct-icon-style' />&nbsp;<span id="spanCbBLType">@Forwarding.MvcApp.App_Resources.App_Resources.Direct</span></label><br />
