                                    </section>
                                    <section id="secTransportType" class="panel panel-default m-t-n">
                                        <header class="panel-heading font-bold">@Forwarding.MvcApp.App_Resources.App_Resources.TransportMode</header>
                                        <label class="m-l swapChildrenClass"><input type="radio" id="cbIsOcean" onchange="Operations_TransportTypeChanged();Operations_ShowHideContainerControls();Operations_SetCloseDate('txtOperationOpenDate', 'txtOperationCloseDate');Operations_AdjustControlsSettings();" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" name="cbTransportType" value="1" checked="checked">&nbsp;<i class='fa fa-anchor ocean-icon-style' />&nbsp;<span>@Forwarding.MvcApp.App_Resources.App_Resources.IsOcean</span></label><br />
