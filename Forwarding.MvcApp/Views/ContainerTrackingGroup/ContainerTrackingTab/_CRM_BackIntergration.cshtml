

<ul id="ul-breadcrumb" class="breadcrumb no-border no-radius b-b b-light pull-in">
    <li>
        <a id="hl-homepage" href="javascript:void(0);" onclick="LoadViews(id);">
            <i class="fa fa-home icon-home"></i><span>@Forwarding.MvcApp.App_Resources.App_Resources.HomePage</span>
        </a>
    </li>
    <li>
        <a id="TR" href="javascript:void(0);" onclick="LoadViews('ContainerTrackingTab')">
            @Forwarding.MvcApp.App_Resources.App_Resources.ContainerTrackingTab
        </a>
    </li>
   
    @*<li><a id="ContainerTrackingTab" href="javascript:void(0);" onclick="LoadViews(ContainerTrackingGroup)">@Forwarding.MvcApp.App_Resources.App_Resources.ContainerTracking
        </a></li>*@
    <li class="active">@Forwarding.MvcApp.App_Resources.App_Resources.CRM_BackIntergration </li>
</ul>
<!-- end breadcrumb  -->


<div id="div-SetOperationStage">
    <!-- Region Options & Template  -->
    <div id="div-Data">
        <div id="div-Options">
            <div id="div-Action" class="radius-top-left-right">
            </div>
        </div>
        <section class="panel panel-default">
            <header class="panel-heading">
                <div id="hExportedTable" class="hide"></div>
                <h3 class="m-b-none">@Forwarding.MvcApp.App_Resources.App_Resources.FilterBy</h3>
                @*<h3 class="m-b-none">Best Print Using Internet Explorer</h3>*@
            </header>
            <!--Region the searh, delete, addnew-->
            <div class="row text-sm wrapper hidden-print m-l">
                <div id="div-main-options">
                    <!--Region Filter-->
                    <div class="row col-sm-12">
                        <div class="form-group col-sm-1 m-t-md hide">
                            <label><input type="checkbox" id="cbIsInvoiced" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"> Invoiced</label>
                        </div>
                        <div class="col-sm-12">

                            <div class="form-group col-sm-2 m-l-n">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.Branch</label>
                                <select id="slBranches" style="width:100%;" class="form-control input-sm" data-required="true"></select>
                            </div>
                            <div class="form-group col-sm-2 m-l-n">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.Service</label>
                                <select id="slServices" style="width:100%;" onchange="ShowHideSalesman();" class="form-control input-sm" data-required="true"></select>
                            </div>
                            <div class="form-group col-sm-2 m-l-n">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.Direction</label>
                                <select id="slDirections" style="width:100%;" class="form-control input-sm" data-required="true"></select>
                            </div>
                            <div class="form-group col-sm-1 m-l-n">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.Months</label>
                                <select id="slMonths" style="width:100%;" class="form-control input-sm" data-required="true">
                                    <option value="0">All</option>
                                    <option value="1">1</option>
                                    <option value="2">2</option>
                                    <option value="3">3</option>
                                    <option value="4">4</option>
                                    <option value="5">5</option>
                                    <option value="6">6</option>
                                    <option value="7">7</option>
                                    <option value="8">8</option>
                                    <option value="9">9</option>
                                    <option value="10">10</option>
                                    <option value="11">11</option>
                                    <option value="12">12</option>
                                </select>
                            </div>
                            <div class="col-sm-2 m-l-n">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.Year</label>
                                <input id="txtYear" style="text-transform:uppercase" type="text" class="input-sm form-control" placeholder="" />
                            </div>
                            <div class="form-group col-sm-2 m-l-n">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.Salesman</label>
                                <select id="slSalesman" style="width:100%;" class="form-control input-sm" data-required="true"></select>
                            </div>
                            <div class="form-group col-sm-2 m-l-n">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.OperationMan</label>
                                <select id="slOperationMan" style="width:100%;" class="form-control input-sm" data-required="false"></select>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <div class="col-sm-2 m-l-n">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.Code</label>
                                <div id="div-search-controls" class="input-group">
                                    <input id="txtSearchItems" style="text-transform:uppercase" type="text" class="input-sm form-control" binding-name="SearchPlaceHolder" binding-prop="placeholder" placeholder="Operation Code" />
                                    <span class="input-group-btn">
                                        <button id="btn-SearchItems" class="btn btn-sm btn-lightblue" type="button" onclick="OperationsStatistics_FilterOperationsModal();"><i class="fa fa-search"> Search </i></button>
                                    </span>
                                </div>
                            </div>
                            <div class="form-group col-sm-2 m-l-n hide">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.Status</label>
                                <select id="slOperationStages" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" class="form-control input-sm">
                                    @*<option value="60">OPEN</option>*@
                                    <option value="120">CLOSED</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-group col-sm-2 m-l-n hide">
                            <label>@Forwarding.MvcApp.App_Resources.App_Resources.From</label>
                            <input id="txtFromDateSelectOperations" readonly="readonly" type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="background-color:white; cursor:text;" class="input-sm datepicker-input form-control" data-date-format="dd/mm/yyyy" placeholder="Select Date" />
                        </div>
                        <div class="form-group col-sm-2 m-l-n hide">
                            <label>@Forwarding.MvcApp.App_Resources.App_Resources.To</label>
                            <input id="txtToDateSelectOperations" readonly="readonly" type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="background-color:white; cursor:text;" class="input-sm datepicker-input form-control" data-date-format="dd/mm/yyyy" placeholder="Select Date" />
                        </div>
                        <div class="form-group col-sm-1 m-t-md hide">
                            <label><input type="checkbox" id="cbIsCreateJV" onchange="ShowHideJV();" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"> Create JV</label>
                        </div>
                        <div class="col-sm-4 m-l-n">
                        </div>
                   

                    </div>


                    <div class="form-group col-sm-2 m-l-n hide">
                        <label>@Forwarding.MvcApp.App_Resources.App_Resources.CloseDate</label>
                        <input id="txtCloseDate" readonly="readonly" type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="background-color:white; cursor:text;" class="input-sm datepicker-input form-control" data-date-format="dd/mm/yyyy" placeholder="Select Date" />
                    </div>


                    @*<div class="col-sm-3 m-l-n-sm m-t-sm">
                            <br />
                            <label> <input type="checkbox" id="cbIncludeCurrenciesDetails" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"> Show Currencies Details</label>
                            <br /><br />
                        </div>*@





                    <!-- Region CheckboxesList Form -->


                    <div style="clear:both;" class="span7 form vertical-mode m-t" id="CheckboxesList-form">
                        <fieldset>
                            <button id="btn-SelectAllOperations" type="button" class="btn btn-primary btn-sm" onclick="OperationsStatistics_SelectAllOperations();"><i class="fa "></i><b>&nbsp;Select All</b></button>
                            <button id="btn-ClearAllOperations" type="button" class="btn btn-warning btn-sm" onclick="OperationsStatistics_ClearAllOperations();"><i class="fa "></i><b>&nbsp;Clear All</b></button>
                            @*<button id="btn-SetOperationStage" type="button" class="btn btn-lightblue btn-sm" onclick="SetOperationStage(false);"><i class="fa "></i><b>&nbsp;Set Status</b></button>*@
                            <button type="button" class="btn btn-info btn-sm hide" onclick="PrintOperationStage('Print');"><i class="fa fa-file-pdf-o"></i><b>&nbsp;Print</b></button>
                            <button type="button" class="btn btn-success btn-sm hide" onclick="PrintOperationStage('Excel');"><i class="fa fa-file-excel-o"></i><b>&nbsp;Export</b></button>
                            <button id="btn-SetOperationCloseJV" type="button" class="btn btn-lightblue btn-sm hide" onclick="SetOperationStage(true);"><i class="fa "></i><b>&nbsp;JV Close</b></button>
                            <button type="button" class="btn btn-info btn-sm " onclick="SetAllClosedOperationsStage();"><i class="fa fa-upload"></i><b>&nbsp;Update CRM Quote/s</b></button>

                            <div id="divCheckboxesList" style="clear:both;">
                            </div>
                        </fieldset>
                    </div>
                    <!-- Endegion CheckboxesList Form -->



                </div>
            </div>
            <!--EOF Region the searh, delete, addnew line-->


        </section>
    </div>
</div>
