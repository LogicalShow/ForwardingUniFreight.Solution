<div class="modal fade" id="BillsHoldReason" tabindex="-1" data-keyboard="true" data-backdrop="false" role="dialog" aria-labelledby="BillsHoldReasonModalLabel" aria-hidden="false">
    <div class="modal-dialog modalwidth-50">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" title="Close" data-dismiss="modal" aria-hidden="true">×</button>
                <h3 class="m-b-none">
                   Reason
                </h3>
            </div>
            <!-- Region Add / Edit Region Form -->
            <div class="modal-body">
                <fieldset>

                    <div class="form-group pull-in  has-error clearfix">

                        <input id="hBillID" type="hidden" />
                        <input id="hIsHold" type="hidden" />
                        <div class="tab-content">
                            <div class="tab-pane active m-t-sm">
                                <div class="form-group col-sm-12">
                                    <div class="form-group col-sm-10">
                                        <label>Reason</label>
                                        <input type="text" id="txtBillsHoldReason" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" class="form-control" data-required="true" placeholder="Reason" style="text-transform:uppercase" autocomplete="off" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    @*  </div>*@
                    <!-- Region Add / Edit Region Form -->
                </fieldset>

            </div>

            <!-- Endregion Add / Edit Region Form -->
            <div class="modal-footer">

                <button type="button" id="btnBillsHoldReason" class="btn btn-primary btn-sm" onclick="HoldUnHoldBills();">

                    <span class="glyphicon glyphicon-save"></span>Save
                </button>
                
                <button class="btnClose btn btn-link btn-sm" id="btnCloseBillsHoldReason" data-dismiss="modal" aria-hidden="true">@Forwarding.MvcApp.App_Resources.App_Resources.Close</button><!--sherif: i added an id and the onclick fn go set the timelocked in the DB to null-->
            </div>
        </div>
    </div>
</div>

