@if (Forwarding.MvcApp.DocAi.DocAiSettings.Enabled)
{
    <div class="modal fade" id="DocAiUsageModal" tabindex="-1" role="dialog" aria-labelledby="docAiUsageTitle" data-backdrop="false"
         data-support-name="@Forwarding.MvcApp.DocAi.DocAiSettings.SupportName"
         data-support-email="@System.Configuration.ConfigurationManager.AppSettings["DocAi:SupportEmail"]"
         data-support-phone="@System.Configuration.ConfigurationManager.AppSettings["DocAi:SupportPhone"]"
         data-support-url="@System.Configuration.ConfigurationManager.AppSettings["DocAi:SupportUrl"]">
        <div class="modal-dialog modal-lg"><div class="modal-content">
            <div class="modal-header docai-usage-header">
                <button type="button" class="close m-l-sm" data-dismiss="modal" aria-label="@Forwarding.MvcApp.App_Resources.App_Resources.Close">&times;</button>
                <button id="docAiUsageRefresh" type="button" class="btn btn-default btn-sm pull-right" onclick="DocAiUsage_Refresh();"><i class="fa fa-refresh"></i>&nbsp;<span id="docAiUsageRefreshText">@Forwarding.MvcApp.App_Resources.App_Resources.DocAi_Refresh</span></button>
                <h3 id="docAiUsageTitle" class="m-b-none">@Forwarding.MvcApp.App_Resources.App_Resources.DocAi_AIUsage</h3>
                <span id="docAiUsageAsOf" class="text-muted text-sm"></span>
            </div>
            <div id="docAiUsageBody" class="modal-body" aria-live="polite"></div>
        </div></div>
    </div>
    <style>
        @@media (min-width:768px) { #DocAiUsageModal .modal-dialog { width:800px; max-width:calc(100% - 40px); } }
        #DocAiUsageModal .docai-usage-big { font-size:40px; font-weight:bold; line-height:1; margin-right:6px; }
        #DocAiUsageModal .progress { height:8px; margin:12px 0 10px; }
        #DocAiUsageModal .docai-usage-thin { height:4px; margin:8px 0; }
        /* Legend dots use the theme's progress-bar colours (default, warning, bar background). */
        #DocAiUsageModal .docai-usage-dot { display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:5px; }
        #DocAiUsageModal .docai-usage-dot-used { background-color:#428bca; }
        #DocAiUsageModal .docai-usage-dot-reserved { background-color:#f0ad4e; }
        #DocAiUsageModal .docai-usage-dot-remaining { background-color:#f5f5f5; box-shadow:inset 0 0 0 1px #e8e8e8; }
        /* Cards and table frames match the theme's panels. */
        #DocAiUsageModal .docai-usage-card, #DocAiUsageModal .docai-usage-table { background:#fff; border:1px solid #e8e8e8; border-radius:2px; box-shadow:0 1px 1px rgba(0,0,0,0.05); }
        #DocAiUsageModal .docai-usage-card { padding:14px 16px; min-height:112px; }
        #DocAiUsageModal .docai-usage-table { overflow:hidden; }
        #DocAiUsageModal .docai-usage-table .table { margin-bottom:0; }
        #DocAiUsageModal .docai-usage-table .table.b-t { border-top:0; }
        #DocAiUsageModal .docai-usage-table th, #DocAiUsageModal .docai-usage-table td { text-align:left; padding:10px 14px; vertical-align:middle; }
    </style>
}
