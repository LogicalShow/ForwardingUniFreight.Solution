    <li>
        <a id="hl-homepage" href="javascript:void(0);">
            <i class="fa fa-home icon-home"></i><span>@Forwarding.MvcApp.App_Resources.App_Resources.HomePage</span>
        </a>
    </li>
    <li>
        <a id="liGroupName" href="javascript:void(0);" @*onclick="LoadViews('Invoicing')"*@>
            @*@Forwarding.MvcApp.App_Resources.App_Resources.MasterData*@
        </a>
    </li>
    <li>
        <a id="liTabName" href="javascript:void(0);" @*onclick="LoadViews('Invoicing')"*@>
            @*@Forwarding.MvcApp.App_Resources.App_Resources.Invoicing*@
        </a>
    </li>
    <li class="active">@Forwarding.MvcApp.App_Resources.App_Resources.PurchaseItems</li>
