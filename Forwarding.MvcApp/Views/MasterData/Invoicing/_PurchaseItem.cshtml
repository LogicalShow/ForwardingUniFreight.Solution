        </div>*@


                                <div class="form-group col-sm-4">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.Notes</label>
                                    <input type="text" id="txtNotes" autocomplete="off" class="form-control parsley-validated input-sm" data-required="false" maxlength="1000" placeholder="" style="text-transform:uppercase;" />
                                </div>

