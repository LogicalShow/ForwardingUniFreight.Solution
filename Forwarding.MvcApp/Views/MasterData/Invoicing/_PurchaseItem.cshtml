<div id="div-PurchaseItem">
    <div id="div-Data">
        <div id="div-Options">
            <div id="div-Action" class="radius-top-left-right">
            </div>
        </div>
        <section class="panel panel-default">
            <header class="panel-heading">
                <h3 class="m-b-none">
                    @Forwarding.MvcApp.App_Resources.App_Resources.PurchaseItems
                </h3>
            </header>
            <!--Region the searh, delete, addnew-->
            <div class="row text-sm wrapper hidden-print ">
                @*<input id="hExtractedData" type="hidden" />*@
                <div id="div-main-options" class="col-sm-7">



                    <button id="btn-NewAdd" style="float:left;" class="btn btn-warning btn-sm hide" data-toggle="modal" data-target="#PurchaseItemModal"><i class="fa fa-plus"></i>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.New</button>

                    <div class="swapChildrenClass" style="display: inline-flex;margin-left:10px">
                        <input type="file" class="input-sm form-control" name="UploadExcel" title="Select File" id="ExcelPurchaseItems" accept=".xls,.xlsx">
                        <button type="button" id="btnImportExcel" class="btn btn-primary btn-sm" onclick="this.disabled = true; UploadExcelFile();">
                            <i class="fa fa-file-excel-o"></i> Upload
                        </button>
                        &ensp;
                        <a href="~/Content/Templates/PurchaseItemTemplate.xlsx" target="_blank" class="btn btn-success btn-sm">
                            <i class="fa fa-table"></i> Export Template
                        </a>
                        &ensp;
                        <button type="button" id="btnExportData" class="btn btn-lightblue btn-sm" onclick="ExportData();">
                            <i class="fa fa-table"></i> Export Data
                        </button>
                        &ensp;
                        <button type="button" class="btn btn-primary btn-sm" data-toggle="modal" onclick="" data-target="#FilterOptionsModal">
                            <i class="fa fa-filter"></i> Filter
                        </button>
                    </div>


                    <div id="div-option-buttons" class="btn-group hide">
                        <button id="btn-Copy" type="button" class="btn btn-sm btn-default"><i class="fa fa-copy"></i>Copy </button>
                        <button id="btn-Print" type="button" class="btn btn-sm btn-default"><i class="fa fa-print"></i>Print </button>
                        <button id="btn-Send" type="button" class="btn btn-sm btn-default"><i class="fa fa-envelope-o"></i>Send </button>
                    </div>
                </div>
                <div id="div-search-option" class="col-sm-5">
                    <div id="div-search-controls" class="input-group col-sm-9">
                        <input id="txt-Search" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="text-transform:uppercase" type="text" class="input-sm form-control" binding-name="SearchPlaceHolder" binding-prop="placeholder" placeholder="Search">
                        <span class="input-group-btn">
                            <button id="btn-search" class="btn btn-sm btn-primary" type="button" onclick="PurchaseItem_LoadingWithPaging();"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                    <div class="float-right col-sm-1">
                        <button id="btn-Delete" type="button" class="float-right btn btn-sm btn-danger m-r-n hide"><i class="fa fa-trash-o"></i>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Delete</button>
                    </div>
                </div>
            </div>
            <!--Region the searh, delete, addnew-->
            <!--Region: table header-->
            <div class="table-responsive">
                <table id="tblPurchaseItem" class="table table-striped b-t b-light text-sm  table-hover">
                    <thead>
                        <tr id="srchControls" class="hide">
                            <th style="width:5%;"></th>
                            <th class=""><input type="text" id="srchCode" class="form-control" onchange="PurchaseItem_LoadingWithPaging();" /></th>
                            <th class=""><input type="text" id="srchName" class="form-control" onchange="PurchaseItem_LoadingWithPaging();" /></th>
                            <th class="hide"><input type="text" id="srchLocalName" class="form-control" onchange="PurchaseItem_LoadingWithPaging();" /></th>
                            <th class="ClientName hide"><input type="text" id="srchCustomer" class="form-control" onchange="PurchaseItem_LoadingWithPaging();" /></th>
                            <th class="OwnerName hide"><input type="text" id="srchOwner" class="form-control" onchange="PurchaseItem_LoadingWithPaging();" /></th>
                            <th class=""><input type="text" id="srchUnit" class="form-control" onchange="PurchaseItem_LoadingWithPaging();" /></th>
                            <th class="PartNumber hide"><input type="text" id="srchPart" class="form-control" onchange="PurchaseItem_LoadingWithPaging();" /></th>
                            <th class="HSCode hide"><input type="text" id="srchHS" class="form-control" onchange="PurchaseItem_LoadingWithPaging();" /></th>
                            <th class="Price hide"><input type="text" id="srchPrice" class="form-control" onchange="PurchaseItem_LoadingWithPaging();" /></th>
                            <th class="hide"><input type="text" id="srchCur" class="form-control" onchange="PurchaseItem_LoadingWithPaging();" /></th>
                        </tr>
                        <tr>
                            <th id="ID">
                                <input id="cb-CheckAll" type="checkbox" />
                            </th>
                            <th class="Code">
                                @Forwarding.MvcApp.App_Resources.App_Resources.Code
                            </th>
                            <th class="Name">
                                @Forwarding.MvcApp.App_Resources.App_Resources.Name
                            </th>
                            <th class="hide">
                                @Forwarding.MvcApp.App_Resources.App_Resources.LocalName
                            </th>
                            <th class="ClientName hide">
                                @Forwarding.MvcApp.App_Resources.App_Resources.Customer
                            </th>
                            <th class="OwnerName hide">
                                @Forwarding.MvcApp.App_Resources.App_Resources.Project
                            </th>
                            <th class="">
                                @Forwarding.MvcApp.App_Resources.App_Resources.StockUnit
                            </th>
                            <th class="PartNumber hide">
                                @Forwarding.MvcApp.App_Resources.App_Resources.PartNumber
                            </th>
                            <th class="HSCode hide">
                                HS Code
                            </th>
                            <th class="Price hide">
                                @Forwarding.MvcApp.App_Resources.App_Resources.Price
                            </th>
                            <th class="hide">
                                @Forwarding.MvcApp.App_Resources.App_Resources.Cur
                            </th>

                            <th class="rounded-right hide"></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <!--Region: table header-->
            <!--Region: footer-->
            <footer class="panel-footer">
                <div class="row">
                    <div class="col-sm-4 hidden-xs">
                        <select id="select-page-size" class="input-sm form-control input-s-sm inline">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                        <button id="btn-applypaging" class="btn btn-sm btn-default" type="button">
                            @Forwarding.MvcApp.App_Resources.App_Resources.Apply
                        </button>
                    </div>
                    <div id="div-Text-Total" class="col-sm-4 text-center">
                        <small class="text-muted inline m-t-sm m-b-sm">
                            @Forwarding.MvcApp.App_Resources.App_Resources.Showing
                            <span id="spn-first-page-row"></span>- <span id="spn-last-page-row"></span> @Forwarding.MvcApp.App_Resources.App_Resources.Of
                            <span id="spn-total-count"></span> @Forwarding.MvcApp.App_Resources.App_Resources.Items
                        </small>
                    </div>
                    <div id="div-Pager" class="col-sm-4 text-right text-center-xs float-right"></div>
                </div>
            </footer>
            <!--Region: footer-->
        </section>
    </div>
</div>

<!-- Add / Edit Region Modal -->
<div class="modal fade" id="PurchaseItemModal" tabindex="-1" data-keyboard="true" data-backdrop="false" role="dialog" aria-labelledby="PurchaseItemModalLabel" aria-hidden="true">
    <div class="modal-dialog  modalwidth-100 m-t-n-lg">
        <div class="modal-content">
            <div class="modal-header">
                @*<button type="button" class="close" data-dismiss="modal" aria-hidden="true">
                    &times;</button>*@
                <h3 class="m-b-none">
                    @Forwarding.MvcApp.App_Resources.App_Resources.PurchaseItem &nbsp;<label id="lblShown" purpose="dynamicLabel" class="static-text-primary"></label>
                </h3>
            </div>
            <!-- Region Add / Edit Region Form -->
            <div class="modal-body">
                <div class="span7 form vertical-mode" id="PurchaseItem-form">
                    <fieldset>
                        <div class="form-group pull-in has-error clearfix">
                            <input id="hID" type="hidden" />
                            <!-- start alert message region -->
                            <div class="alert alert-danger div-error">@Forwarding.MvcApp.App_Resources.App_Resources.ErrorMessage</div>
                            <!-- end alert message region -->
                            <!-- Region Add / Edit Region Form -->
                            <!--LeftSide-->
                            <div class="col-sm-6">

                                <div class="form-group col-sm-6">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.Customer</label>
                                    <select id="slPurchaseItemClient" class="form-control m-b input-sm" data-required="false" onchange="LoadOwners();"></select>
                                </div>
                                <div class="form-group col-sm-6 hide">
                                    <label>Project</label>
                                    <select id="slPurchaseItemOwner" class="form-control m-b input-sm" data-required="false"></select>
                                </div>
                                <div class="form-group col-sm-6">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.Code </label>
                                    <input id="txtCode" autocomplete="off" type="text" class="form-control  input-sm " data-required="false" data-minlength="1" maxlength="100" placeholder="" style="text-transform:uppercase;" />
                                </div>
                                <div class="form-group col-sm-6">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.Name</label>
                                    <input type="text" id="txtName" autocomplete="off" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" class="form-control parsley-validated input-sm" data-required="true" maxlength="200" placeholder="" style="text-transform:uppercase;" />
                                </div>
                                <div class="form-group col-sm-6">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.Commodity</label>
                                    <select id="slCommodity" class="form-control m-b input-sm classMandatoryForNIL" data-required="false"></select>
                                </div>
                                <div class="form-group col-sm-6">
                                    <label>Stock Unit</label>
                                    <select id="slPackageType" class="form-control m-b input-sm classMandatoryForNIL" data-required="true"></select>
                                </div>

                                <div class="col-sm-12 m-t-md" style="clear:both;">
                                    <label>Track By:</label>
                                    &emsp;<label><input type="checkbox" id="cbByExpireDate" name="cbByExpireDate" onchange="PurchaseItem_EnableDisableIMOProprties();">&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Expiration</label>
                                    &emsp;<label><input type="checkbox" id="cbByLotNo" name="cbByLotNo" onchange="PurchaseItem_EnableDisableIMOProprties();">&nbsp;Lot No.</label>
                                    &emsp;<label><input type="checkbox" id="cbBySerialNo" name="cbBySerialNo" onchange="PurchaseItem_EnableDisableIMOProprties();">&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Serial&nbsp;No.</label>
                                    &emsp;<label><input type="checkbox" id="cbByVehicle" name="cbByVehicle" onchange="PurchaseItem_EnableDisableIMOProprties();">&nbsp;Vehicle</label>
                                </div>

                                <div id="divPackageTypeConversionBtns" class="col-sm-12 m-t-xs" style="clear:both;">
                                    <button id="btn-AddPackageTypeConversion" class="btn btn-warning btn-sm" data-toggle="modal" data-target="" onclick="PackageTypeConversion_ClearAllControls();"><i class="fa fa-plus"></i>&nbsp;Add Conversion</button>
                                    <button id="btn-DeletePackageTypeConversion" title="Delete Conversion" type="button" class="float-right btn btn-sm btn-danger" onclick="PackageTypeConversion_DeleteList();"><i class="fa fa-trash-o"></i>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Delete</button>
                                </div>

                                <div id="divPackageTypeConversion" class="col-sm-12 m-t-xs">
                                    <section class="panel panel-default">
                                        <header class="panel-heading font-bold text-ul">Stock Unit Conversion</header>
                                        <!--Region: table header-->
                                        <div class="table-responsive" style="width:100%; height:240px; overflow:scroll;">
                                            <table id="tblPackageTypeConversion" class="table table-striped b-t b-light text-sm  table-hover ">
                                                <thead>
                                                    <tr>
                                                        <th id="HeaderDeletePackageTypeConversionID" style="width:5%;">
                                                            <input id="cb-CheckAll-PackageTypeConversion" type="checkbox" />
                                                        </th>
                                                        <th>@Forwarding.MvcApp.App_Resources.App_Resources.From</th>
                                                        <th>@Forwarding.MvcApp.App_Resources.App_Resources.To</th>
                                                        <th style="width:20%;">Factor</th>
                                                        <th class="rounded-right hide"></th>
                                                    </tr>
                                                </thead>
                                                <tbody></tbody>
                                            </table>

                                        </div>
                                        <!--Region: EOF table header-->
                                        <!--Region: table footer-->
                                        <footer class="panel-footer hide">
                                            <span id="spanNoBarCode" class="hide">No BarCode.</span>
                                        </footer>
                                        <!--Region: EOF table footer-->
                                    </section>
                                </div>

                            </div>
                            <!--LeftSide END-->
                            <!--RightSide-->
                            <div class="col-sm-6">

                                <div class="form-group col-sm-4 hide">
                                    <label>UploadFolderName</label>
                                    <input id="txtUploadFolderName" autocomplete="off" type="text" class="form-control parsley-validated input-sm " data-required="false" data-minlength="1" maxlength="100" placeholder="" style="text-transform:uppercase;" />
                                </div>

                                <div class="form-group col-sm-4 hide">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.LocalName</label>
                                    <input type="text" id="txtLocalName" autocomplete="off" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" class="form-control parsley-validated input-sm" data-required="false" maxlength="200" placeholder="" style="text-transform:uppercase;" />
                                </div>

                                <div class="form-group col-sm-4">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.GrossWeightAbbrev</label>
                                    <input type="text" id="txtGrossWeight" autocomplete="off" onkeypress="CheckValueIsDecimal(id);" onfocus="CheckValueIsDecimal(id);" onblur="CheckDecimalFormat(id);" class="form-control parsley-validated input-sm classMandatoryForNIL" data-required="false" maxlength="11" placeholder="0.0" />
                                </div>

                                <div class="form-group col-sm-4">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.NetWeightAbbrev</label>
                                    <input type="text" id="txtNetWeight" autocomplete="off" onkeypress="CheckValueIsDecimal(id);" onfocus="CheckValueIsDecimal(id);" onblur="CheckDecimalFormat(id);" class="form-control parsley-validated input-sm classMandatoryForNIL" data-required="false" maxlength="11" placeholder="0.0" />
                                </div>

                                <div class="form-group col-sm-4">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.Price</label>
                                    <input type="text" id="txtPrice" autocomplete="off" onkeypress="CheckValueIsDecimal(id);" onfocus="CheckValueIsDecimal(id);" onblur="CheckDecimalFormat(id);" class="form-control parsley-validated input-sm classMandatoryForNIL" data-required="false" maxlength="11" placeholder="0.0" />
                                </div>

                                <div class="form-group col-sm-4">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.PartNumber</label>
                                    <input type="text" id="txtPartNumber" class="form-control parsley-validated input-sm classMandatoryForNIL" data-required="false" data-minlength="0" maxlength="100" style="text-transform:uppercase" />
                                </div>

                                <div class="form-group col-sm-4">
                                    <label>HS Code</label>
                                    <input type="text" id="txtHSCode" class="form-control parsley-validated input-sm classMandatoryForNIL" data-required="false" data-minlength="0" maxlength="100" style="text-transform:uppercase" />
                                </div>

                                <div class="form-group col-sm-4 hide">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.Currency</label>
                                    <select id="slCurrency" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" class="form-control m-b input-sm" data-required="false"></select>
                                </div>

                                <div class="form-group col-sm-4">
                                    <label>Stock Unit Qty</label>
                                    <input type="text" id="txtStockUnitQuantity" autocomplete="off" onkeypress="CheckValueIsInteger(id);" onfocus="CheckValueIsInteger(id);" class="form-control parsley-validated input-sm classMandatoryForNIL" data-required="false" maxlength="100" placeholder="" />
                                </div>

                                <div class="form-group col-sm-4">
                                    <label>Preferred Area</label>
                                    <select id="slPreferredArea" class="form-control m-b input-sm" data-required="false"></select>
                                </div>

                                <div class="form-group col-sm-4 hide">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.ViewOrder</label>
                                    <input type="text" id="txtViewOrder" autocomplete="off" onkeypress="CheckValueIsInteger(id);" onfocus="CheckValueIsInteger(id);" class="form-control parsley-validated input-sm" data-type="number" data-required="false" maxlength="3" placeholder="" />
                                </div>

                                <div class="form-group col-sm-4 hide">
                                    <label>Wt.Unit</label>
                                    <select id="slWeightUnit" class="form-control m-b input-sm" data-required="false"></select>
                                </div>

                                <div class="form-group col-sm-2">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.Width</label>
                                    <input type="text" id="txtWidth" autocomplete="off" onkeyup="PurchaseItem_CalculateVolume();" onkeypress="CheckValueIsDecimal(id);" onfocus="CheckValueIsDecimal(id);" onblur="CheckDecimalFormat(id);" class="form-control parsley-validated input-sm classMandatoryForNIL" data-required="false" maxlength="11" placeholder="0.0" />
                                </div>

                                <div class="form-group col-sm-2">
                                    <label>Depth(CM)</label>
                                    <input type="text" id="txtDepth" autocomplete="off" onkeyup="PurchaseItem_CalculateVolume();" onkeypress="CheckValueIsDecimal(id);" onfocus="CheckValueIsDecimal(id);" onblur="CheckDecimalFormat(id);" class="form-control parsley-validated input-sm classMandatoryForNIL" data-required="false" maxlength="11" placeholder="0.0" />
                                </div>

                                <div class="form-group col-sm-2">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.Height</label>
                                    <input type="text" id="txtHeight" autocomplete="off" onkeyup="PurchaseItem_CalculateVolume();" onkeypress="CheckValueIsDecimal(id);" onfocus="CheckValueIsDecimal(id);" onblur="CheckDecimalFormat(id);" class="form-control parsley-validated input-sm classMandatoryForNIL" data-required="false" maxlength="11" placeholder="0.0" />
                                </div>

                                <div class="form-group col-sm-4 hide">
                                    <label>Len.Unit</label>
                                    <select id="slLengthUnit" class="form-control m-b input-sm" data-required="false"></select>
                                </div>

                                <div class="form-group col-sm-2">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.Volume</label>
                                    <input type="text" id="txtVolume" autocomplete="off" onkeypress="CheckValueIsDecimal(id);" onfocus="CheckValueIsDecimal(id);" onblur="CheckDecimalFormat(id);" class="form-control parsley-validated input-sm classMandatoryForNIL" data-required="false" maxlength="11" placeholder="0.0" />
                                </div>

                                <div class="form-group col-sm-4">
                                    <label>Gross Vol</label>
                                    <input type="text" id="txtGrossVolume" autocomplete="off" onkeypress="CheckValueIsDecimal(id);" onfocus="CheckValueIsDecimal(id);" onblur="CheckDecimalFormat(id);" class="form-control parsley-validated input-sm" data-required="false" maxlength="11" placeholder="0.0" />
                                </div>
                                @*FOR ERP*@
                                <div class="form-group col-sm-4 hide">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.Group</label>
                                    <select id="slItemGroup" class="form-control m-b input-sm" data-required="false"></select>
                                </div>

                                <div class="form-group col-sm-4 hide">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.Type</label>
                                    <select id="slItemType" class="form-control m-b input-sm" data-required="false"></select>
                                </div>

                                <div class="form-group col-sm-4 hide">
                                    <label>Vol.Unit</label>
                                    <select id="slVolumeUnit" class="form-control m-b input-sm" data-required="false"></select>
                                </div>

                                <div class="form-group col-sm-4 m-t-md classHideForNIL" style="clear:both;">
                                    <label><input type="checkbox" id="cbIsIMO" onchange="PurchaseItem_EnableDisableIMOProprties();">&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.IMO</label>
                                </div>

                                <div class="form-group col-sm-4 classHideForNIL">
                                    <label>UN</label>
                                    <input type="text" id="txtUN" disabled="disabled" onkeypress="CheckValueIsInteger(id);" onfocus="CheckValueIsInteger(id);" data-type="number" class="form-control parsley-validated input-sm" maxlength="5" placeholder="0" />
                                </div>

                                <div class="form-group col-sm-4 classHideForNIL">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.IMOClass</label>
                                    <select id="slIMOClass" disabled="disabled" class="form-control m-b input-sm" data-required="false"></select>
                                </div>

                                <div class="form-group col-sm-4 classHideForNIL">
                                    <label>PG</label>
                                    <select id="slPG" disabled="disabled" class="form-control m-b input-sm" data-required="false">
                                        <option value=""><--Select--></option>
                                        <option value="1">I</option>
                                        <option value="2">II</option>
                                        <option value="3">III</option>
                                    </select>
                                </div>

