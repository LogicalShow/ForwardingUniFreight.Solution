                                            <li data-target="#AgingAutoMailPlan" id="stepsAgingAutoMailPlan" value="Aging" onclick="" class="complete non_basic"><span class="badge badge-info" style="background-color:midnightblue;">2</span>@Forwarding.MvcApp.App_Resources.App_Resources.AgingAutomailPlan</li>
