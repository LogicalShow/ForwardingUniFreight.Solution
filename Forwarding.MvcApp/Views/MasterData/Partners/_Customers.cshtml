<div id="div-Customers">
    <!-- Region Options & Template  -->
    <div id="div-Data">
        <div id="div-Options">
            <div id="div-Action" class="radius-top-left-right">
            </div>
        </div>
        <section class="panel panel-default">
            <header class="panel-heading">
                <h3 class="m-b-none">@Forwarding.MvcApp.App_Resources.App_Resources.Customers</h3>
            </header>
            <!--Region the searh, delete, addnew-->
            <div class="row text-sm wrapper hidden-print ">
                <div id="div-main-options" class="col-sm-5 m-b-xs">
                    <button id="btn-NewAdd" class="btn btn-warning btn-sm hide" data-toggle="modal" data-target="#CustomerModal"><i class="fa fa-plus"></i>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.New</button>
                    <button id="btn-FilterOptions-Customers" class="btn btn-primary btn-sm" data-toggle="modal" onclick="" data-target="#FilterOptionsModal"><i class="fa fa-filter"></i> Filter Options</button>
                    <input id="btnAddFromExcel-Customers" type="file" style="display:inline;" title="Import Items from Excel 97-2003" class="btn-lightblue btn-sm classHideForMESCOChildren hide" onchange="Customers_onFileSelected(event, id);" />
                    <button id="btn-AutoMailSetting" class="btn btn-default btn-sm" data-toggle="modal" data-target="#CustomerAutomailPlanModal" onclick="LoadCustomers_Automail();"><i class="fa fa-envelope-o"></i>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.AutomailPlan</button>
                    <button id="btn-refreshInvoicesVAT" class="btn btn-sm btn-primary hide" type="button" onclick="RefreshInvoicesVAT();"><i class="fa fa-refresh"></i> Refresh Invoices VAT</button>
                    @*<button id="btn-FollowUp" onclick="Customers_CreateSalesLeadFromCustomers();" type="button" class="btn btn-lightblue  btn-sm"><i class="fa fa-comments-o icon"></i>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.ActivateCustomerFollowUp</button>*@
                    <select id="slFilterCompany" class="input-sm ShowForTopManagement"></select>

                    <div id="div-option-buttons" class="btn-group hide">
                        <button id="btn-Copy" type="button" class="btn btn-sm btn-default"><i class="fa fa-copy"></i>&nbsp;Copy </button>
                        <button id="btn-Print" type="button" class="btn btn-sm btn-default"><i class="fa fa-print"></i>&nbsp;Print </button>
                        <button id="btn-Send" type="button" class="btn btn-sm btn-default"><i class="fa fa-envelope-o"></i>&nbsp;Send </button>
                    </div>
                </div>
                <div id="div-search-option" class="col-sm-7">
                    <div id="div-search-controls" class="input-group col-sm-9">
                        <input id="txt-Search" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="text-transform:uppercase" type="text" class="input-sm form-control" binding-name="SearchPlaceHolder" binding-prop="placeholder" placeholder="Search Code / Name / Local Name / Vat NO">
                        <span class="input-group-btn">
                            <button id="btn-search" class="btn btn-sm btn-primary" type="button" onclick="Customers_LoadingWithPaging();"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                    <div class="float-right col-sm-1">
                        <button id="btn-Delete" type="button" class="float-right btn btn-sm btn-danger m-r-n hide"><i class="fa fa-trash-o"></i>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Delete</button>
                    </div>
                </div>
            </div>
            <!--EOF Region the searh, delete, addnew line-->
            <!--Customers Modal-->
            <!--EOF Customers Modal-->
            <!--Region: table header-->
            <div class="table-responsive">
                <table id="tblCustomers" class="table table-striped b-t b-light text-sm  table-hover">
                    <thead>
                        <tr id="srchControls" class="hide">
                            <th style="width:5%;"></th>
                            <th class="ShowForTopManagement hide"><input type="text" id="srchCompany" class="form-control" onchange="Customers_LoadingWithPaging();" /></th>
                            <th><input type="text" id="srchCode" class="form-control" onchange="Customers_LoadingWithPaging();" /></th>
                            <th><input type="text" id="srchCustomer" class="form-control" onchange="Customers_LoadingWithPaging();" /></th>
                            <th><input type="text" id="srchCustomerLocal" class="form-control" onchange="Customers_LoadingWithPaging();" /></th>
                            <th><input type="text" id="srchPayment" class="form-control" onchange="Customers_LoadingWithPaging();" /></th>
                            <th><input type="checkbox" id="srchIsInactive" class="" onchange="Customers_LoadingWithPaging();" /></th>
                            <th><input type="text" id="srchVAT" class="form-control" onchange="Customers_LoadingWithPaging();" /></th>
                            <th><input type="checkbox" id="srchIsActiveUser" class="" onchange="Customers_LoadingWithPaging();" /></th>
                            <th><input type="text" id="srchUser" class="form-control" onchange="Customers_LoadingWithPaging();" /></th>
                            <th><input type="checkbox" id="srchCRM" class="" onchange="Customers_LoadingWithPaging();" /></th>
                            <th class="AccountUNF"><input type="text" id="srchAccount" class="form-control" onchange="Customers_LoadingWithPaging();" /></th>
                            <th><input type="text" id="srchPrice" class="form-control" onchange="Customers_LoadingWithPaging();" autocomplete="off"/></th>
                            <th class="Notes hide"><input type="text" id="srchNotes" class="form-control" onchange="Customers_LoadingWithPaging();" /></th>
                        </tr>
                        <tr>
                            <th id="ID">
                                <input id="cb-CheckAll" type="checkbox" />
                            </th>
                            <th class="ShowForTopManagement hide">
                                @Forwarding.MvcApp.App_Resources.App_Resources.CompanyName
                            </th>
                            <th class="th-sortable" data-toggle="class">
                                @Forwarding.MvcApp.App_Resources.App_Resources.Code
                            </th>
                            <th>
                                @Forwarding.MvcApp.App_Resources.App_Resources.Name
                            </th>
                            <th>
                                @Forwarding.MvcApp.App_Resources.App_Resources.LocalName
                            </th>
                            <th class="showForNex hide">
                                @Forwarding.MvcApp.App_Resources.App_Resources.Salesman
                            </th>
                            <th>
                                @Forwarding.MvcApp.App_Resources.App_Resources.PaymentTerm
                            </th>
                            <th>
                                @Forwarding.MvcApp.App_Resources.App_Resources.IsInactive
                            </th>
                            <th>
                                @Forwarding.MvcApp.App_Resources.App_Resources.VATNumber
                            </th>
                            <th>
                                @Forwarding.MvcApp.App_Resources.App_Resources.IsActiveUser
                            </th>
                            <th>
                                @Forwarding.MvcApp.App_Resources.App_Resources.Username
                            </th>
                            <th class="">
                                @Forwarding.MvcApp.App_Resources.App_Resources.CRM
                            </th>
                            <th class="AccountUNF">
                                Account Number
                            </th>
                            <th class="">
                                Price List
                            </th>
                            <th class="ShowForTEU hide">

                            </th>
                            <th class="ShowForLATT hide">
                                Is Integrated
                            </th>
                            <th class="hide">
                                @Forwarding.MvcApp.App_Resources.App_Resources.Notes
                            </th>

                            <th class="rounded-right hide"></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <!--Region: table header-->
            <!--Region: footer-->
            <footer class="panel-footer">
                <div class="row">
                    <div class="col-sm-4 hidden-xs">
                        <select id="select-page-size" class="input-sm form-control input-s-sm inline">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                        <button id="btn-applypaging" class="btn btn-sm btn-default" type="button">
                            @Forwarding.MvcApp.App_Resources.App_Resources.Apply
                        </button>
                    </div>
                    <div id="div-Text-Total" class="col-sm-4 text-center">
                        <small class="text-muted inline m-t-sm m-b-sm">
                            @Forwarding.MvcApp.App_Resources.App_Resources.Showing
                            <span id="spn-first-page-row"></span>- <span id="spn-last-page-row"></span> @Forwarding.MvcApp.App_Resources.App_Resources.Of
                            <span id="spn-total-count"></span> @Forwarding.MvcApp.App_Resources.App_Resources.Items
                        </small>
                    </div>
                    <div id="div-Pager" class="col-sm-4 text-right text-center-xs float-right"></div>
                </div>
            </footer>
            <!--Region: footer-->
        </section>


        <div class="modal fade" id="CustomerAutomailPlanModal" tabindex="-1" data-keyboard="true" data-backdrop="false" role="dialog" aria-labelledby="CustomerModalLabel" aria-hidden="true">
