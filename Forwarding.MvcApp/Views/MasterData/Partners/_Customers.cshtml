                                                    <div class="">
                                                        <label class="swapChildrenClass"><input type="checkbox" id="cbCheckAllCustomers_Invoice" onchange="cbCheckAllCustomers_InvoiceAutomailChanged();" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><u>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.SelectAllCustomers&nbsp;</u></label><br />
