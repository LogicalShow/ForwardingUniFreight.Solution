                                                @*<h3 class="m-b-none">Best Print Using Internet Explorer</h3>*@
                                            </header>

                                            <div class="row text-sm wrapper hidden-print ">
                                                <section id="secCustomers_AccountStatement" class="col-sm-12 panel panel-default">
                                                    <div class="">
                                                        <label class="swapChildrenClass"><input type="checkbox" id="cbCheckAllCustomers_AccountStatement" onchange="cbCheckAllCustomers_AccountStatementAutomailChanged();" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><u>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.SelectAllCustomers&nbsp;</u></label><br />
