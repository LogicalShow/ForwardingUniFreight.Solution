                                    </div>
                                    <div class="col-sm-2">
                                        <label>@Forwarding.MvcApp.App_Resources.App_Resources.PeriodType</label>
                                        <select id="slPeriodType_Automail" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" class="form-control input-sm">
                                            <option value="-1"> @Forwarding.MvcApp.App_Resources.App_Resources.All</option>
