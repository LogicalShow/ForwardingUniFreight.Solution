                                                    <div id="divCbCustomers_Aging" style="width:104%; height:370px; font-size:100%; overflow:scroll;">
                                                    </div>
                                                    <div class="col-sm-6">
                                                        @*<h4 style="">Tuning for selected clients</h4>*@

                                                    </div>
                                                </section>
                                            </div>
                                        </div>
                                        <div id="AccountStatementAutoMailPlan" style="padding:1px!important;" class="step-pane  step-content">
                                            <header class="panel-heading hide">
                                                <div id="hExportedTable" class="hide"></div>
