                                        </div>


                                    </div>
                                </section>
                            </fieldset>
                        </div>
                    </div>
                    <!-- Endregion Add / Edit Region Form -->
                    <div class="modal-footer">
                        <button id="btn-None" type="button" class="btn float-left btn-primary btn-sm " onclick="SaveAutomailPlan(0);"><i class=""></i>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.None</button>
                        <button id="btn-Weekly" type="button" class="btn float-left btn-lightblue btn-sm hide classShowForARK " onclick="SaveAutomailPlan(70);"><i class="fa fa-calendar"></i>&nbsp;Weekly</button>
                        <button id="btn-HalfMonthly" type="button" class="btn float-left btn-lightblue btn-sm " onclick="SaveAutomailPlan(10);"><i class="fa fa-calendar"></i>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.EmailHalfMonthly</button>
                        <button id="btn-Monthly" type="button" class="btn float-left btn-warning btn-sm " onclick="SaveAutomailPlan(20);"><i class="fa fa-calendar-o"></i>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.EmailMonthly</button>
                        <button class="btn btn-link btn-sm" id="btnClose" @*onclick="Customers_UnlockRecord();"*@ data-dismiss="modal" aria-hidden="true">@Forwarding.MvcApp.App_Resources.App_Resources.Close</button><!--sherif: i added an id and the onclick fn go set the timelocked in the DB to null-->
                    </div>
                </div>
            </div>
        </div>



    </div>
</div>

<!--FilterOptionsModal-->
<div class="modal fade" id="FilterOptionsModal" @*tabindex="-1" style="z-index: 3000;"*@ data-keyboard="true" data-backdrop="false" role="dialog" aria-labelledby="FilterOptionsModalLabel" aria-hidden="true">
    <div class="modal-dialog modalwidth-100">
        <div class="modal-content m-t-n-lg">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true" title="Close">
                    &times;
                </button>
                <h3 class="m-b-none">
                    <label id="lblShownFilterOptions" class="static-text-primary">Filter Options</label>
                </h3>
            </div>
            <div class="modal-body">
                <!-- Region FilterOptions Form -->
                <button id="btn-ClearAllFilterOptions" type="button" class="btn btn-warning btn-sm m-l m-t-n-sm hide" onclick=""><i class="fa "></i><b>&nbsp;Clear All</b></button>
                <div class="span7 form vertical-mode m-t-sm" id="FilterOptions-form">
                    <fieldset>
                        <div class="row hide">
                            <div id="div-FilterOptions-controls" class="input-group m-l col-sm-5">
                                <input id="txtFilterOptions" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="text-transform:uppercase" type="text" class="input-sm form-control" binding-name="SearchPlaceHolder" binding-prop="placeholder" placeholder="Search" />
                                <span class="input-group-btn">
                                    <button id="btn-FilterOptions" class="btn btn-sm btn-primary" type="button"><i class="fa fa-search"></i></button>
                                </span>
                            </div>
                        </div>

                        <div id="divFilterOptions" class="m-t-n classSearchOptions">
                            <div class="form-group col-sm-2">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.Type</label>
                                <select id="slFilterCustomerType" class="form-control m-b input-sm" data-required="false">
                                    <option value="All" selected>All</option>
                                    <option value="Internal">Internal</option>
                                    <option value="External">External</option>
                                    <option value="Related">Related</option>
                                </select>
                            </div>
                            <div class="form-group col-sm-2">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.Country</label>
                                <select id="slFilterCountry" class="form-control m-b" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);"></select>
                            </div>
                            <div class="form-group col-sm-2">
                                <label>Customer</label>
                                <select id="slFilterCustomerKind" class="form-control m-b input-sm" data-required="false">
                                    <option value="All" selected>All</option>
                                    <option value="Consignee">Consignee</option>
                                    <option value="Shipper">Shipper</option>
                                </select>
                            </div>
                            <div class="form-group col-sm-2">
                                <label>Customer Category</label>
                                <select id="slFilterCustomerCategory" class="form-control m-b input-sm" data-required="false">
                                </select>
                            </div>
                            <button id="btn-ExportToExcel" type="button" onclick="Customers_Print('Excel');" class="btn m-t-md btn-sm btn-primary float-right hide"><i class="fa fa-table"></i><b>&nbsp;Export Excel&nbsp;</b></button>
                            <button id="btn-ExportBlackList" type="button" onclick="Customers_Print_Blacklist('Excel');" class="btn m-t-md btn-sm btn-primary float-right hide"><i class="fa fa-table"></i><b>&nbsp;Export Blacklist Customers&nbsp;</b></button>
                        </div>

                    </fieldset>
                </div>
                <!-- Endegion FilterOptions Form -->
            </div>
            <div class="modal-footer m-t-n">
                <!--sherif-->
                <button type="button" data-dismiss="modal" onclick="Customers_LoadingWithPaging();" id="btnFilterOptionsApply" class="btn btn-primary btn-sm">
                    <span class="glyphicon glyphicon-search"></span>&nbsp;Search
                </button>
                @*<button class=" btn btn-link btn-sm" data-dismiss="modal" aria-hidden="true">@Forwarding.MvcApp.App_Resources.App_Resources.Close</button>*@
            </div>
        </div>
    </div>
</div>
