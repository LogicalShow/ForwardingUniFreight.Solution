<!--Salesmens Modal-->
<div class="modal fade" id="SalesmenModal" tabindex="-1" style="z-index: 1045;" data-keyboard="true" data-backdrop="false" role="dialog" aria-labelledby="SalesmenModalLabel" aria-hidden="true">
    <div class="modal-dialog modalwidth-90">
        <div class="modal-content m-t-n-lg">
            <div class="modal-header">
                <h3 class="m-b-none">
                    @Forwarding.MvcApp.App_Resources.App_Resources.Salesmen &nbsp;<label id="lblSalesmenShown" purpose="dynamicLabel" class="static-text-primary"></label>
            </h3>
        </div>
        <!-- Region Add / Edit Region Form -->
        <div class="modal-body">
            <div class="span7 form vertical-mode" id="Salesmen-form">
                <fieldset>
                    <div class="form-group pull-in  has-error clearfix">
                        <input id="hSalesmenID" type="hidden" />
                        <!--Wizard-->
                        <div class="wizard clearfix">
                            <ul class="steps">
                                <li data-target="#BasicDataSalesmen" id="stepsBasicDataSalesmen" class="active"><span class="badge badge-info">1</span>@Forwarding.MvcApp.App_Resources.App_Resources.BasicData</li>
                            </ul>
                            <div class="actions" style="display:none;">
                                <!--Next & Previous buttons-->
                                <button type="button" class="btn btn-default btn-xs btn-prev" disabled="disabled">@Forwarding.MvcApp.App_Resources.App_Resources.Prev</button>
                                <button type="button" class="btn btn-default btn-xs btn-next" data-last="Finish">@Forwarding.MvcApp.App_Resources.App_Resources.Next</button>
                            </div>
                        </div>
                        <div class="step-content">
                            <!--Basic Data-->
                            <div class="step-pane active" id="BasicDataSalesmen">
                                @*start alert message region
                                                            <div class="alert alert-danger div-error">
                                    @Forwarding.MvcApp.App_Resources.App_Resources.ErrorMessage*@
                            </div>
                            <!-- end alert message region -->
                            <!-- Add / Edit Basic Data -->
                            <div class="form-group col-sm-6">
                                <label id="labelCode">@Forwarding.MvcApp.App_Resources.App_Resources.Code</label>
                                <input type="text" id="txtSalesmenCode" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" class="form-control parsley-validated" data-required="false" data-minlength="1" maxlength="20" placeholder="Code" style="text-transform:uppercase" />
                            </div>
                            <div class="form-group col-sm-6">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.Name</label>
                                <input type="text" id="txtSalesmenName" disabled="disabled" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" class="form-control parsley-validated" data-required="false" maxlength="100" placeholder="Name" style="text-transform:uppercase" />
                            </div>
                            <div class="form-group col-sm-6">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.LocalName</label>
                                <input type="text" id="txtSalesmenLocalName" disabled="disabled" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" class="form-control parsley-validated" data-required="false" maxlength="150" placeholder="Local Name" style="text-transform:uppercase" />
                            </div>
                            <div class="form-group col-sm-6">
                                <label>CrmCode</label>
                                <input type="text" id="txtSalesmenCrmCode" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" class="form-control parsley-validated" data-required="false" maxlength="150" placeholder="CrmCode" disabled="disabled" style="text-transform:uppercase" />
                            </div>
                            @*<div class="form-group col-sm-6">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.Email</label>
                                    <input id="txtSalesmenEmail" name="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" type="text" class="form-control parsley-validated" data-required="false" maxlength="250" placeholder="CRMCode" style="text-transform:uppercase" />
                                </div>*@




                            <!--EOF Add / Edit Basic Data -->
                        </div>
                        <!--EOF Basic Data-->
                        <!--Billing-->
                        <!--<div class="step-pane" id="BillingSalesmen">-->
                        <!-- start alert message region -->
                        <!--<div class="alert alert-danger div-error">

                            </div>

                        </div>-->


                    </div>
                    <!--EOF Wizard-->

                </fieldset>
            </div>
        </div>
        <!-- Endregion Add / Edit Region Form -->
        <div class="modal-footer m-t-n">
            @*<button id="btn-OperatorTankChargeModalSalesmen" class="m-l btn btn-lightblue btn-sm" data-toggle="modal" data-target="#" onclick="OperatorTankCharge_FillModal();"><i class="fa fa-text-width"></i>&nbsp;Operator Tank Charge</button>*@
            <button type="button" id="btnSaveSalesmen" class="btn btn-primary btn-sm">
                <span class="glyphicon glyphicon-save"></span>@Forwarding.MvcApp.App_Resources.App_Resources.Save
            </button>
            <button type="button" id="btnSaveandNewSalesmen" class="btn btn-primary btn-sm">
                <span class="glyphicon glyphicon-save"></span>@Forwarding.MvcApp.App_Resources.App_Resources.SaveAndNew
            </button>
            <button class="btnClose btn btn-link btn-sm" id="btnSalesmenClose" @*onclick="Salesmens_UnlockRecord();"*@ data-dismiss="modal" aria-hidden="true">@Forwarding.MvcApp.App_Resources.App_Resources.Close</button><!--sherif: i added an id and the onclick fn go set the timelocked in the DB to null-->
        </div>
    </div>
</div>
</div>
<!--EOF Salesmens Modal-->
