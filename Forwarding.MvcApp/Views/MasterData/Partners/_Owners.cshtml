<!-- start breadcrumb  -->
<ul id="ul-breadcrumb" class="breadcrumb no-border no-radius b-b b-light pull-in">
    <li>
        <a id="hl-homepage" href="javascript:void(0);">
            <i class="fa fa-home icon-home"></i><span>@Forwarding.MvcApp.App_Resources.App_Resources.HomePage</span>
        </a>
    </li>
    <li>
        <a id="MasterData" href="javascript:void(0);" onclick="LoadViews('Partners')">
            @Forwarding.MvcApp.App_Resources.App_Resources.MasterData
    </a>
</li>
<li>
    <a id="Partners" href="javascript:void(0);" onclick="LoadViews(id)">
        @Forwarding.MvcApp.App_Resources.App_Resources.Partners
</a>
</li>
<li class="active">Owners</li>
</ul>
<!-- end breadcrumb  -->

<div id="div-Owners">
    <!-- Region Options & Template  -->
    <div id="div-Data">
        <div id="div-Options">
            <div id="div-Action" class="radius-top-left-right">
            </div>
        </div>
        <section class="panel panel-default">
            <header class="panel-heading">
                <h3 class="m-b-none">Projects</h3>
            </header>
            <!--Region the searh, delete, addnew-->
            <div class="row text-sm wrapper hidden-print ">
                <div id="div-main-options" class="col-sm-5 m-b-xs">
                    <button id="btn-NewAdd" class="btn btn-warning btn-sm hide" data-toggle="modal" data-target="#OwnersModal"><i class="fa fa-plus"></i>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.New</button>

              

                    <div id="div-option-buttons" class="btn-group hide">
                        <button id="btn-Copy" type="button" class="btn btn-sm btn-default"><i class="fa fa-copy"></i>&nbsp;Copy </button>
                        <button id="btn-Print" type="button" class="btn btn-sm btn-default"><i class="fa fa-print"></i>&nbsp;Print </button>
                        <button id="btn-Send" type="button" class="btn btn-sm btn-default"><i class="fa fa-envelope-o"></i>&nbsp;Send </button>
                    </div>
                </div>
                <div id="div-search-option" class="col-sm-7">
                    <div id="div-search-controls" class="input-group col-sm-9">
                        <input id="txt-Search" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="text-transform:uppercase" type="text" class="input-sm form-control" binding-name="SearchPlaceHolder" binding-prop="placeholder" placeholder="@Forwarding.MvcApp.App_Resources.App_Resources.SearchCodeNameLocalName">
                        <span class="input-group-btn">
                            <button id="btn-search" class="btn btn-sm btn-primary" type="button" onclick="Owners_LoadingWithPaging();"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                    <div class="float-right col-sm-1">
                        <button id="btn-Delete" type="button" class="float-right btn btn-sm btn-danger m-r-n hide"><i class="fa fa-trash-o"></i>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Delete</button>
                    </div>
                </div>
            </div>
            <!--EOF Region the searh, delete, addnew line-->
            <!--Owners Modal-->
            <!--EOF Owners Modal-->
            <!--Region: table header-->
            <div class="table-responsive">
                <table id="tblOwners" class="table table-striped b-t b-light text-sm  table-hover">
                    <thead>
                        <tr id="srchControls" class="hide">
                            <th style="width:5%;"></th>
                            <th><input type="text" id="srchCustomer" class="form-control" onchange="Owners_LoadingWithPaging();" /></th>
                            <th><input type="text" id="srchCustomerLocal" class="form-control" onchange="Owners_LoadingWithPaging();" /></th>
                            <th><input type="text" id="srchOwner" class="form-control" onchange="Owners_LoadingWithPaging();" /></th>
                            <th><input type="text" id="srchOwnerLocal" class="form-control" onchange="Owners_LoadingWithPaging();" /></th>
                            <th><input type="text" id="srchCode" class="form-control" onchange="Owners_LoadingWithPaging();" /></th>
                        </tr>
                        <tr>
                            <th id="ID">
                                <input id="cb-CheckAll" type="checkbox" />
                            </th>
                            <th class="th-sortable" data-toggle="class">
                                @Forwarding.MvcApp.App_Resources.App_Resources.Customer
                            </th>
                            <th>
                                @Forwarding.MvcApp.App_Resources.App_Resources.LocalName
                            </th>
                            <th>
                                @Forwarding.MvcApp.App_Resources.App_Resources.Project
                            </th>
                            <th>
                                @Forwarding.MvcApp.App_Resources.App_Resources.LocalName
                            </th>
                            <th>
                                @Forwarding.MvcApp.App_Resources.App_Resources.Code
                            </th>
                            <th class="rounded-right hide"></th>
                        </tr>
                    </thead>
        <tbody>
        </tbody>
    </table>
</div>
<!--Region: table header-->
<!--Region: footer-->
            <footer class="panel-footer">
                <div class="row">
                    <div class="col-sm-4 hidden-xs">
                        <select id="select-page-size" class="input-sm form-control input-s-sm inline">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                        <button id="btn-applypaging" class="btn btn-sm btn-default" type="button">
                            @Forwarding.MvcApp.App_Resources.App_Resources.Apply
                        </button>
                    </div>
                    <div id="div-Text-Total" class="col-sm-4 text-center">
                        <small class="text-muted inline m-t-sm m-b-sm">
                            @Forwarding.MvcApp.App_Resources.App_Resources.Showing
                            <span id="spn-first-page-row"></span>- <span id="spn-last-page-row"></span> @Forwarding.MvcApp.App_Resources.App_Resources.Of
                            <span id="spn-total-count"></span> @Forwarding.MvcApp.App_Resources.App_Resources.Items
                        </small>
                    </div>
                    <div id="div-Pager" class="col-sm-4 text-right text-center-xs float-right"></div>
                </div>
                <!--Ownerss Modal-->
                <div class="modal fade" id="OwnersModal" tabindex="-1" style="z-index: 1045;" data-keyboard="true" data-backdrop="false" role="dialog" aria-labelledby="OwnersModalLabel" aria-hidden="true">
                    <div class="modal-dialog modalwidth-90">
                        <div class="modal-content m-t-n-lg">
                            <div class="modal-header">
                                <h3 class="m-b-none">
                                    @Forwarding.MvcApp.App_Resources.App_Resources.Owners &nbsp;<label id="lblOwnersShown" purpose="dynamicLabel" class="static-text-primary"></label>
                                </h3>
                            </div>
                            <!-- Region Add / Edit Region Form -->
                            <div class="modal-body">
                                <div class="span7 form vertical-mode" id="Owners-form">
                                    <fieldset>
                                        <div class="form-group pull-in  has-error clearfix">
                                            <input id="hOwnersID" type="hidden" />
                                            <!--Wizard-->
                                            <div class="wizard clearfix">
                                                <ul class="steps">
                                                    <li data-target="#BasicDataOwners" id="stepsBasicDataOwners" class="active"><span class="badge badge-info">1</span>@Forwarding.MvcApp.App_Resources.App_Resources.BasicData</li>
                                                </ul>
                                                <div class="actions" style="display:none;">
                                                    <!--Next & Previous buttons-->
                                                    <button type="button" class="btn btn-default btn-xs btn-prev" disabled="disabled">@Forwarding.MvcApp.App_Resources.App_Resources.Prev</button>
                                                    <button type="button" class="btn btn-default btn-xs btn-next" data-last="Finish">@Forwarding.MvcApp.App_Resources.App_Resources.Next</button>
                                                </div>
                                            </div>
                                            <div class="step-content">
                                                <!--Basic Data-->
                                                <div class="step-pane active" id="BasicDataOwners">
                                                    @*start alert message region
                                    <div class="alert alert-danger div-error">
            @Forwarding.MvcApp.App_Resources.App_Resources.ErrorMessage*@
                                                </div>
                                                <!-- end alert message region -->
                                                <!-- Add / Edit Basic Data -->
                                                <div class="form-group col-sm-6">
                                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.Code</label>
                                                    <input type="text" id="txtOwnersCode" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" class="form-control parsley-validated" data-required="false" data-minlength="1" maxlength="10" placeholder="Code" style="text-transform:uppercase" disabled />
                                                </div>
                                                <div class="form-group col-sm-6">
                                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.Name</label>
                                                    <input type="text" id="txtOwnersName" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" class="form-control parsley-validated" data-required="false" maxlength="100" placeholder="Name" style="text-transform:uppercase" />
                                                </div>
                                                <div class="form-group col-sm-6">
                                                    <label>Local Name</label>
                                                    <input type="text" id="txtOwnersLocalName" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" class="form-control parsley-validated" data-required="false" maxlength="150" placeholder="Local Name" style="text-transform:uppercase" />
                                                </div>
                                                @*<div class="form-group col-sm-6">
                                                    <label>Customers</label>
                                                    <select id="slOwnerCustomers" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" class="form-control m-b" data-required="false" multiple></select>
                                                </div>*@
                                                <div class="form-group col-sm-6">
                                                    <label>Customers</label>
                                                    <select id="slOwnerCustomer" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" class="form-control m-b" data-required="false"></select>
                                                </div>
                                                @*<div class="form-group col-sm-6">
            <label>CrmCode</label>
            <input type="text" id="txtOwnersCrmCode" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" class="form-control parsley-validated" data-required="false" maxlength="150" placeholder="CrmCode" disabled="disabled" style="text-transform:uppercase" />
        </div>*@
                                                @*<div class="form-group col-sm-6">
            <label>@Forwarding.MvcApp.App_Resources.App_Resources.Email</label>
            <input id="txtOwnersEmail" name="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" type="text" class="form-control parsley-validated" data-required="false" maxlength="250" placeholder="CRMCode" style="text-transform:uppercase" />
        </div>*@




                                                <!--EOF Add / Edit Basic Data -->
                                            </div>
                                            <!--EOF Basic Data-->
                                            <!--Billing-->
                                            <!--<div class="step-pane" id="BillingOwners">-->
                                            <!-- start alert message region -->
                                            <!--<div class="alert alert-danger div-error">

                                    </div>

                                </div>-->


                                        </div>
                                        <!--EOF Wizard-->

                                    </fieldset>
                                </div>
                            </div>
                            <!-- Endregion Add / Edit Region Form -->
                            <div class="modal-footer m-t-n">
                                @*<button id="btn-OperatorTankChargeModalOwners" class="m-l btn btn-lightblue btn-sm" data-toggle="modal" data-target="#" onclick="OperatorTankCharge_FillModal();"><i class="fa fa-text-width"></i>&nbsp;Operator Tank Charge</button>*@
                                <button type="button" id="btnSaveOwners" class="btn btn-primary btn-sm">
                                    <span class="glyphicon glyphicon-save"></span>@Forwarding.MvcApp.App_Resources.App_Resources.Save
                                </button>
                                <button type="button" id="btnSaveandNewOwners" class="btn btn-primary btn-sm">
                                    <span class="glyphicon glyphicon-save"></span>@Forwarding.MvcApp.App_Resources.App_Resources.SaveAndNew
                                </button>
                                <button class="btnClose btn btn-link btn-sm" id="btnOwnersClose" @*onclick="Ownerss_UnlockRecord();"*@ data-dismiss="modal" aria-hidden="true">@Forwarding.MvcApp.App_Resources.App_Resources.Close</button><!--sherif: i added an id and the onclick fn go set the timelocked in the DB to null-->
                            </div>
                        </div>
                    </div>
                </div>
                <!--EOF Ownerss Modal-->
                <!--OperatorTankCharge Modal-->
                <!--EOF OperatorTankCharge Modal-->
                <!-- OperatorTankChargeItemModal -->
                <!--EOF OperatorTankChargeItemModal -->
                <!-- OwnersNetworkModal -->
                <!-- OwnersNetworkModal -->

            </footer>
<!--Region: footer-->
</section>
</div>
