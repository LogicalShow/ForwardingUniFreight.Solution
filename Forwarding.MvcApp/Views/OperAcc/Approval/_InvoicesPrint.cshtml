                            <label class=""><input type="checkbox" checked id="cbPrintGrossWeight" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;Gross Wgt</label>&emsp;
                        </div>

                        <div class="form-group col-sm-2 m-t">
