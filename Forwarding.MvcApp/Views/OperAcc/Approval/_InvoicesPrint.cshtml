                </h3>
            </div>
            <div class="modal-body">
                <!-- Region PrintInvoiceOptions Form -->
                <div class="span7 form vertical-mode" id="PrintInvoiceOptions-form">
                    <fieldset>
                        <div class="fprm-group col-sm-12 m-t">
