                            <label class=""><input type="checkbox" id="cbPrintLeftSignature" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.LeftSignature</label>&emsp;
                            <label class=""><input type="checkbox" id="cbPrintMiddleSignature" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.MiddleSignature</label>&emsp;
                            <label class=""><input type="checkbox" id="cbPrintRightSignature" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.RightSignature</label>&emsp;
                            <label class=""><input type="checkbox" id="cbPrintStamp" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;Stamp</label>&emsp;
                            <label class=""><input type="checkbox" id="cbPrintNotification" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;Print Notification</label>&emsp;
                            <label class="hide showForLIN"><input type="checkbox" id="cbCombineTrucking" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" checked>&nbsp;Collect Trucking items</label>&emsp;
                            <label class="hide"><input type="checkbox" id="cbTotalInLocalCurrency" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;Total In Local Currency</label>&emsp;
                            <label class="hide"><input type="checkbox" id="cbPrintStamp-Ar" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;Stamp-Ar</label>&emsp;
                            <label class="hide"><input type="checkbox" id="cbPrintStamp-Kadmar" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;Stamp-Kadmar</label>&emsp;
                            <label class="classShowForGBL hide m-t"><input type="checkbox" id="cbPrintOriginalChassisDetails" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;Print Original Chassis Items</label>&emsp;
                            <label class="hide"><input type="checkbox" id="cbPrintUSDToLocal" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;USD To Local</label>&emsp;
                        </div>

                        <div class="form-group col-sm-12 m-t hide classShowForSEF">
                            <label class=""><input type="checkbox" checked id="cbPrintLine" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;Line</label>&emsp;
                            <label class=""><input type="checkbox" checked id="cbPrintPOL" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;POL</label>&emsp;
                            <label class=""><input type="checkbox" checked id="cbPrintPOD" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;POD</label>&emsp;
                            <label class=""><input type="checkbox" checked id="cbPrintRefNo" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;Ref No</label>&emsp;
                            <label class=""><input type="checkbox" checked id="cbPrintPONumber" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;PO Number</label>&emsp;
                            <label class=""><input type="checkbox" checked id="cbPrintNoOfContainers" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;No Of Contrs</label>&emsp;
                            <label class=""><input type="checkbox" checked id="cbPrintCourier" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;Courier</label>&emsp;
                            <label class=""><input type="checkbox" checked id="cbPrintAWB" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;AWB</label>&emsp;
                            <label class=""><input type="checkbox" checked id="cbPrintNoOfPackages" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;No Of Pkgs</label>&emsp;
