                                    <input id="txtTrackingContactDetails" class="form-control input-sm" style="text-transform:uppercase;" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="form-group col-sm-9">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.Notes</label>
                                    <textarea id="txtTrackingNotes" maxlength="300" class="form-control col-sm-12 textDivOperations input-sm" style="text-transform:uppercase;"></textarea>
                                </div>
                            </div>



                            @*<div class="col-sm-6 m-t">
                                    <label><input type="checkbox" id="cbIsInactive" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.IsInactive</label><br />
                                </div>*@
