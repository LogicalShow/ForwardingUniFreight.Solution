                    &times;
                </button>
                <h3 id="h3TrackingStage" class="m-b-none">
                    @Forwarding.MvcApp.App_Resources.App_Resources.TrackingStage &nbsp;<label id="lblShown" purpose="dynamicLabel" class="static-text-primary"></label>
