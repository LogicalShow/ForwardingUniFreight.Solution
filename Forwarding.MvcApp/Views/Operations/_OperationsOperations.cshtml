                                </div>
                                <div class="form-group col-sm-4">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.ReleaseDate</label>
                                    <input id="txtReleasingDate" readonly="readonly" type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="cursor:text; background-color:white;" class="datepicker-input form-control input-sm" data-required="false" data-date-format="dd/mm/yyyy" placeholder="Select Date" />
                                </div>
                                <div class="form-group col-sm-4">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.LoadingDate</label>
                                    <input id="txtLoadingDate" readonly="readonly" type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="cursor:text; background-color:white;" class="datepicker-input form-control input-sm" data-required="false" data-date-format="dd/mm/yyyy" placeholder="Select Date" />
                                </div>

                                <div class="form-group col-sm-4">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.PickupAddress</label>
                                    <input id="txtTrackingPickupAddress" class="form-control input-sm" style="text-transform:uppercase;" />
                                </div>
                                <div class="form-group col-sm-4">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.DeliveryAddress</label>
                                    <input id="txtTrackingDeliveryAddress" class="form-control input-sm" style="text-transform:uppercase;" />
                                </div>
                                <div class="form-group col-sm-4">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.OtherAddress</label>
                                    <input id="txtTrackingOtherAddress" class="form-control input-sm" style="text-transform:uppercase;" />
                                </div>
                                <div class="form-group col-sm-4">
