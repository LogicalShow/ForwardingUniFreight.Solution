                                        </div>
                                        <div class="form-group col-sm-3 m-t-xs">
                                            <label>Customer</label>
                                            <select id="slCustomer" name="slCustomer" class="form-control input-sm" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" data-required="true"><option value=""><--Select--></option></select>
                                        </div>
