<!-- start breadcrumb  -->
<ul id="ul-breadcrumb" class="breadcrumb no-border no-radius b-b b-light pull-in">
    <li>
        <a id="hl-homepage" href="javascript:void(0);">
            <i class="fa fa-home icon-home"></i><span>@Forwarding.MvcApp.App_Resources.App_Resources.HomePage</span>
        </a>
    </li>
    <li>
        <a id="PricingModule" href="javascript:void(0);" onclick="LoadViews('Pricing')">
            @Forwarding.MvcApp.App_Resources.App_Resources.Pricing
        </a>
    </li>
    <li class="active">
        Booking Schedule
    </li>
</ul>
<!-- end breadcrumb  -->

<div id="div-Bookings">
    <div id="div-Data">
        <div id="div-Options">
            <div id="div-Action" class="radius-top-left-right">
            </div>
        </div>
        <section class="panel panel-default">
            <header class="panel-heading">
                <h3 id="" class="m-b-none">
                    <span id="h3Bookings">Booking Schedule</span>
                </h3>
            </header>
            <!--Region the searh, delete, addnew-->
            <div class="row text-sm wrapper">
                <div id="div-main-options">
                    <button id="btn-NewAdd" title="Search" class="btn btn-warning btn-sm hide m-l-lg" data-toggle="modal"><i class="fa fa-plus"></i>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.New</button>&nbsp;
                    <input id="btnAddFromExcel-Bookings" type="file" style="display:inline;" title="Import Items from Excel 97-2003" class="btn-lightblue btn-sm" onchange="Bookings_onFileSelected(event, id);" />
                    <button id="btn-ExcelSample" title="Excel Sample" class="btn btn-primary btn-sm m-l-lg" data-toggle="modal" onclick="DownloadSampleBooking();">&nbsp;Download Excel Sample File</button>&nbsp;

                    <button id="btn-Delete" title="Delete" type="button" class="float-right btn btn-sm btn-danger hide m-r-lg" onclick=""><i class="fa fa-trash-o"></i>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Delete</button>

                    <section class="panel panel-default m-t-sm" style="clear:both;">
                        <!--Region: table header-->
                        <div id="divTblBookings" class="table-responsive" style="overflow:scroll;">
                            <table id="tblBookings" class="table b-t b-light text-sm table-hover ">
                                <thead>
                                    <tr>
                                        <th id="ID">
                                            <input id="cb-CheckAll" type="checkbox" />
                                        </th>
                                        <th>Contract Holder</th>
                                        <th>Booking No.</th>
                                        <th>POL</th>
                                        <th>POD</th>
                                        <th>Shipping Line</th>
                                        <th>Customer</th>
                                        <th>SI Date & Time</th>
                                        <th>Validated Titles</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                        <!--Region: EOF table header-->
                        <!--Region: table footer-->
                        <footer class="panel-footer">
                            <div class="row">
                                <div class="col-sm-4 hidden-xs">
                                    <select id="select-page-size" class="input-sm form-control input-s-sm inline">
                                        <option value="10">10</option>
                                        <option value="25">25</option>
                                        <option value="50">50</option>
                                    </select>
                                    <button id="btn-applypaging" class="btn btn-sm btn-default" type="button">
                                        @Forwarding.MvcApp.App_Resources.App_Resources.Apply
                                    </button>
                                </div>
                                <div id="div-Text-Total" class="col-sm-4 text-center">
                                    <small class="text-muted inline m-t-sm-sm">
                                        @Forwarding.MvcApp.App_Resources.App_Resources.Showing
                                        <span id="spn-first-page-row"></span>- <span id="spn-last-page-row"></span> @Forwarding.MvcApp.App_Resources.App_Resources.Of
                                        <span id="spn-total-count"></span> @Forwarding.MvcApp.App_Resources.App_Resources.Items
                                    </small>
                                </div>
                                <div id="div-Pager" class="col-sm-4 text-right text-center-xs float-right"></div>
                            </div>
                        </footer>
                        <!--Region: EOF table footer-->
                    </section>
                </div><!--EOF Region Main-Options-->
            </div>
        </section>
    </div>
</div>


<!--Booking Modal-->
<div class="modal fade" id="BookingModal" tabindex="-1" style="z-index: 1040;" data-keyboard="true" data-backdrop="false" role="dialog" aria-labelledby="BookingModalLabel" aria-hidden="true">
    <div class="modal-dialog modalwidth-80 m-t-n-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true" title="Close">
                    &times;
                </button>
                <h3 class="m-b-none">
                    Booking
                </h3>
            </div>
            <!-- Region Add / Edit Region Form -->
            <div class="modal-body">
