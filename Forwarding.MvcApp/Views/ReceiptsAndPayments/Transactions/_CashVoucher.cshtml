</ul>
<!-- end breadcrumb  -->
<!--Region the searh, delete, addnew-->
<select id="slBank" style="display:none"></select>
<select id="slNotesReceivables" style="display:none"></select>
<div id="div-Voucher">
    <div id="div-Data">
        <div id="div-Options">
            <div id="div-Action" class="radius-top-left-right">
            </div>
        </div>
        <section class="panel panel-default">
            <header class="panel-heading">
                <h3 id="h3_InOrOut" class="m-b-none"></h3>
            </header>
            <!--Region the searh, delete, addnew-->
            <div class="row text-sm wrapper hidden-print m-t-n-sm swapChildrenClass">
                <div class="col-sm-2 hide">
                    <select id="slSearchTax1" class="form-control m-b input-sm" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" data-required="false"></select>
                </div>
                <div class="col-sm-2 hide">
                    <select id="slSearchTax2" class="form-control m-b input-sm" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" data-required="false"></select>
                </div>
                <div class="col-sm-2 hide">
                    <select id="slBranch" class="form-control m-b input-sm" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" data-required="false"></select>
                </div>
                <div class="col-sm-2 hide">
                    <select id="slOperation" class="form-control m-b input-sm" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" data-required="false"></select>
                </div>
                <div class="col-sm-2">
                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.Code</label>
                    <input id="txtSearchCode" tabindex="10" type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" class="form-control parsley-validated input-sm" maxlength="50" placeholder="" style="text-transform:uppercase;" />
                </div>
                <div class="col-sm-2">
                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.From</label>
                    <input id="txtSearchFrom" tabindex="20" type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" readonly="readonly" style="background-color:white; cursor:text;" class="form-control datepicker-input input-sm" data-required="false" data-date-format="dd/mm/yyyy" placeholder="Select Date" />
                </div>
                <div class="col-sm-2">
                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.To</label>
                    <input id="txtSearchTo" tabindex="30" type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" readonly="readonly" style="background-color:white; cursor:text;" class="form-control datepicker-input input-sm" data-required="false" data-date-format="dd/mm/yyyy" placeholder="Select Date" />
                </div>
                <div class="col-sm-2">
                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.Safe</label>
                    <select id="slSearchSafe" tabindex="40" class="form-control m-b input-sm" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" data-required="false"></select>
                </div>
                <div class="col-sm-2">
                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.Amount</label>
                    <input id="txtSearchTotal" tabindex="50" type="text" onkeypress="CheckValueIsDecimal(id);" onfocus="CheckValueIsDecimal(id);" onblur="CheckDecimalFormat(id);" class="form-control parsley-validated input-sm" data-required="false" maxlength="11" @*placeholder="value from 0.00001 to 99999.99999"*@ />
                </div>
                <div class="col-sm-2">
                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.Currency</label>
                    <select id="slSearchCurrency" tabindex="60" class="form-control m-b input-sm" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" data-required="false"></select>
                </div>
            </div>
            <div class="row text-sm wrapper hidden-print m-t-n-sm swapChildrenClass">
                <div class="swapChildrenClass ">
                    @*m-t-n-lg*@
                    <div class="col-sm-2">
                        <label>@Forwarding.MvcApp.App_Resources.App_Resources.ChargedPerson</label>
                        <input id="txtSearchChargedPerson" tabindex="70" type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" class="form-control parsley-validated input-sm" maxlength="50" placeholder="" data-required="false" style="text-transform:uppercase" />
                    </div>
                    <div class="col-sm-2">
                        <label>@Forwarding.MvcApp.App_Resources.App_Resources.CashOrCharge</label>
                        <select id="slSearchCashOrCharge" tabindex="90" class="form-control input-sm" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" data-required="false">
                            <option value="0">@Forwarding.MvcApp.App_Resources.App_Resources.SelectFromMenu</option>
                            <option value="10">@Forwarding.MvcApp.App_Resources.App_Resources.Cash</option>
                            <option value="20">@Forwarding.MvcApp.App_Resources.App_Resources.Charge</option>
                        </select>
                    </div>
                    <div class="col-sm-2">
                        <label>@Forwarding.MvcApp.App_Resources.App_Resources.Status</label>
                        <select id="slSearchStatus" tabindex="100" class="form-control input-sm" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" data-required="false">
                            <option value="0">@Forwarding.MvcApp.App_Resources.App_Resources.SelectFromMenu</option>
                            <option value="10">@Forwarding.MvcApp.App_Resources.App_Resources.Approved</option>
                            <option value="20">@Forwarding.MvcApp.App_Resources.App_Resources.NotApproved</option>
                        </select>
                    </div>
                    <div class="col-sm-2 ShowForCashReceiving hide">
                        <label>@Forwarding.MvcApp.App_Resources.App_Resources.InvoiceNo</label>
                        <input id="txtSearchInvoiceNo" tabindex="120" type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" class="form-control parsley-validated input-sm" maxlength="50" placeholder="" style="text-transform:uppercase" />
                    </div>
                    <div class="col-sm-2 ShowForCashReceiving hide">
                        <label>@Forwarding.MvcApp.App_Resources.App_Resources.OperationCode</label>
                        <input id="txtSearchOperationCode" tabindex="120" type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" class="form-control parsley-validated input-sm" maxlength="50" placeholder="" style="text-transform:uppercase" />

                    </div>
                    <div class="col-sm-2 hide">
                        <label>Direct Approve</label>
                        <select id="slDirectApprove" tabindex="100" class="form-control input-sm" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" data-required="false">
                            <option value="0">@Forwarding.MvcApp.App_Resources.App_Resources.SelectFromMenu</option>
                            <option value="10">@Forwarding.MvcApp.App_Resources.App_Resources.Approved</option>
                            <option value="20">@Forwarding.MvcApp.App_Resources.App_Resources.NotApproved</option>
                        </select>
                    </div>
                    <div class=" swapChildrenClass ">
                        <div class="col-sm-8">
                            <label>@Forwarding.MvcApp.App_Resources.App_Resources.Notes</label>
                            <input id="txtSearchNotes" tabindex="80" type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" class="form-control parsley-validated input-sm" maxlength="500" placeholder="" data-required="false" style="text-transform:uppercase" />
                        </div>
                        <div class="col-sm-4"> </div>
                    </div>
                        <div class="form-group col-sm-8 swapChildrenClass m-t-md">
                            <div class="input-group col-sm-12 ">

                                <button id="btn-Search" type="button" class="btn btn-lightblue btn-sm swapChildrenClass" onclick="Voucher_LoadingWithPaging();" @*data-toggle="modal" data-target="#BankModal"*@><i class="fa fa-search"></i><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Search&nbsp;</b></button>
                                &nbsp;<button id="btn-NewAdd" type="button" onclick="$('#hID').val(''); $('#txtChargedPerson').removeAttr('disabled'); $('#slSafe').removeAttr('disabled'); $('#txtCode').removeAttr('disabled');  ClearA_PaymentRequestID_ForVoucherID();" class="btn btn-warning btn-sm swapChildrenClass hide" data-toggle="modal" @*data-target="#VoucherModal"*@><i class="fa fa-plus"></i><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.New&nbsp;</b></button>
                                &nbsp; <button id="btn-Delete" type="button" class="btn btn-sm btn-danger swapChildrenClass hide"><i class="fa fa-trash-o"></i><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Delete&nbsp;</b></button>
                                &nbsp;  <button id="btn-Print" type="button" onclick="Vouchers_Print();" class="btn btn-lightblue btn-sm swapChildrenClass "><i class="fa fa-print"></i><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.PrintByDate&nbsp;</b></button>

                                &nbsp;<button id="btn-NewAddOneInvoice" type="button" onclick="MultiCurrencyInvoicePaymentClicked();" class="btn btn-warning btn-sm swapChildrenClass hide" data-toggle="modal"><i class="fa fa-plus"></i><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.MultiCurrencyInvoicePayment&nbsp;</b></button>

                                @*<button id="btn-PermanentDelete" type="button" onclick="Voucher_DeleteList('D');" class="btn btn-sm btn-info swapChildrenClass hide"><i class="fa fa-ban"></i><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.PermanentDelete&nbsp;</b></button>*@
                            </div>
                        </div>
                        <div class=" col-sm-2 swapChildrenClass m-t-md">
                            <button id="btn-Post" tabindex="120" type="button" onclick="ApproveDirect_Voucher();" class="btn btn-warning btn-sm swapChildrenClass hide" @*data-toggle="modal" data-target="#BankModal"*@><i class="fa fa-mail-forward"></i><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Approve&nbsp;</b></button>
                        </div>
                    </div>
                </div>
            <!--EOF Region the searh, delete, addnew-->
            <!--Region: table header-->
            <div class="table-responsive m-t-n-sm">
                <table id="tblVoucher" class="table table-striped b-t b-light text-sm  table-hover">
                    <thead>
                        <tr>
                            <th id="ID">
                                <input id="cb-CheckAll" type="checkbox" />
                            </th>
                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.Code</th>
                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.Safe</th>
                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.Date</th>
                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.ChargedPerson</th>
                            <th style="width:10% !important;">@Forwarding.MvcApp.App_Resources.App_Resources.Notes</th>
                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.Amount</th>
                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.Currency</th>
                            <th id="thIsCash" class="hide">@Forwarding.MvcApp.App_Resources.App_Resources.Cash</th>
                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.Posted</th>
                            <th class="rounded-right"></th>
                            <th class="rounded-right"></th>

                            <th class="rounded-right hide"></th>
                        </tr>
                    </thead>
                    <tbody style="font-size:90%;"></tbody>
                </table>
            </div>
            <!--Region: table header-->
            <!--Region: footer-->
            <footer class="panel-footer">
                <div class="row">
                    <div class="col-sm-4 hidden-xs">
                        <select id="select-page-size" class="input-sm form-control input-s-sm inline">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                        <button id="btn-applypaging" class="btn btn-sm btn-default" type="button">
                            @Forwarding.MvcApp.App_Resources.App_Resources.Apply
                        </button>
                    </div>
                    <div id="div-Text-Total" class="col-sm-4 text-center">
                        <small class="text-muted inline m-t-sm m-b-sm">
                            @Forwarding.MvcApp.App_Resources.App_Resources.Showing
                            <span id="spn-first-page-row"></span>- <span id="spn-last-page-row"></span> @Forwarding.MvcApp.App_Resources.App_Resources.Of
                            <span id="spn-total-count"></span> @Forwarding.MvcApp.App_Resources.App_Resources.Items
                        </small>
                    </div>
                    <div id="div-Pager" class="col-sm-4 text-right text-center-xs float-right"></div>
                </div>
            </footer>
            <!--Region: footer-->
        </section>
    </div>
</div>
