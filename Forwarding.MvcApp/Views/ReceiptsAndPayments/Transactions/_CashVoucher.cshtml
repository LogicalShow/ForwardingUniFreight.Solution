<!-- VoucherModal  -->
<div class="modal fade" id="VoucherModal" tabindex="-1" data-keyboard="true" data-backdrop="false" role="dialog" aria-labelledby="VoucherModalLabel" aria-hidden="true">
    <div class="modal-dialog modalwidth-100">
        <div class="modal-content m-t-n-lg">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
                    &times;
                </button>
                <h3 id="h3Modal" class="m-b-none swapChildrenClass">
                    <span>&nbsp;&nbsp;</span><label id="lblShown" purpose="dynamicLabel" @*to be cleared*@ class="static-text-primary"></label>
                </h3>
            </div>
            <!-- Region Add / Edit Region Form -->
            <div class="modal-body">
                <div class="span7 form vertical-mode" id="Voucher-form">
                    <fieldset>
                        <div class="form-group pull-in  has-error clearfix">
                            <input id="hID" type="hidden" />
                            <!-- start alert message region -->
                            @*<div class="alert alert-danger div-error">
                                    @Forwarding.MvcApp.App_Resources.App_Resources.ErrorMessage
                                </div>*@
                            <!-- end alert message region -->
                            <div class="col-sm-2 hide">
                                <select id="slCurrencyDetails" class="form-control m-b input-sm" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" data-required="false"></select>
                            </div>
                            <!-- Region Add / Edit Region Form -->
                            <div class="swapChildrenClass m-t-n">
                                <div class="col-sm-1">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.Code</label>
                                    <input id="txtCode" tabindex="100" type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" class="form-control parsley-validated input-sm" data-required="true" maxlength="20" placeholder="Auto-Generated" style="text-transform:uppercase;" />
                                </div>
                                <div class="col-sm-2">
                                    <label @*id="lblVoucherDate"*@>@Forwarding.MvcApp.App_Resources.App_Resources.Date</label>
                                    <input id="txtVoucherDate" tabindex="200" type="text" @*onchange="JournalVouchers_JVDateChanged();"*@ onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" readonly="readonly" @*style="background-color:white; cursor:text;"*@ class="form-control datepicker-input input-sm" data-required="true" data-date-format="dd/mm/yyyy" placeholder="Select Date" />
                                </div>
                                <div class="col-sm-2">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.Safe</label>
                                    <select id="slSafe" tabindex="400" class="form-control parsley-validated input-sm" onchange="Voucher_GetCodeAndSetCurrency();" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" data-required="true"></select>
                                </div>
                                <div class="col-sm-1">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.Currency</label>
                                    <select id="slCurrency" tabindex="500" class="form-control parsley-validated input-sm" onchange="Voucher_CurrencyChanged(id, 'txtExchangeRate', '')" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" data-required="true"></select>
                                </div>


                                <div class="col-sm-2">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.BalanceCur</label>
                                    <input type="text" id="txtCurrBalance" disabled="disabled" tabindex="550" @*name="ExchangeRate*@ " onkeypress=" CheckValueIsDecimal(id);" onfocus="CheckValueIsDecimal(id);" onblur="CheckDecimalFormat(id);" class="form-control parsley-validated input-sm" data-required="false" maxlength="11" />
                                </div>


                                <div class="col-sm-1">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.ExchangeRate</label>
                                    <input type="text" id="txtExchangeRate" disabled="disabled" tabindex="600" @*name="ExchangeRate*@ " onkeypress=" CheckValueIsDecimal(id);" onfocus="CheckValueIsDecimal(id);" onblur="CheckDecimalFormat(id);" class="form-control parsley-validated input-sm" data-required="true" maxlength="11" @*placeholder="value from 0.00001 to 99999.99999"*@ />
                                </div>
                                <div class="col-sm-3">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.ChargedPerson</label>
                                    <input id="txtChargedPerson" tabindex="700" type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" class="form-control parsley-validated input-sm" maxlength="100" placeholder="" data-required="true" style="text-transform:uppercase" />
                                </div>
                            </div>

                            <div class="row">
                                @*This div is to make controls clickable*@
                                <div class="col-sm-12 swapChildrenClass" style="">
                                    <div class="col-sm-2 hide">
                                        <label>@Forwarding.MvcApp.App_Resources.App_Resources.Invoice</label>
                                        <select id="slInvoice" tabindex="750" class="form-control parsley-validated input-sm" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" data-required="false"></select>
                                    </div>
                                    <div class="col-sm-2">
                                        <label>@Forwarding.MvcApp.App_Resources.App_Resources.Tax1</label>
                                        <select id="slTax" tabindex="800" class="form-control parsley-validated input-sm" onchange="Voucher_CalculateTotal();" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" data-required="false"></select>
                                    </div>
                                    <div class="col-sm-1">
                                        <label>@Forwarding.MvcApp.App_Resources.App_Resources.TaxValue1</label>
                                        <input type="text" id="txtTaxValue" tabindex="810" onkeypress="CheckValueIsDecimal(id);" onfocus="CheckValueIsDecimal(id);" onblur="CheckDecimalFormat(id); Voucher_CalculateTotal();" class="form-control parsley-validated input-sm" data-required="false" maxlength="11" placeholder="" />
                                    </div>
                                    <div class="col-sm-2">
                                        <label>@Forwarding.MvcApp.App_Resources.App_Resources.Tax2</label>
                                        <select id="slTax2" tabindex="820" class="form-control parsley-validated input-sm" onchange="Voucher_CalculateTotal();" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" data-required="false"></select>
                                    </div>
                                    <div class="form-group col-sm-1">
                                        <label>@Forwarding.MvcApp.App_Resources.App_Resources.TaxValue2</label>
                                        <input type="text" id="txtTaxValue2" tabindex="830" onkeypress="CheckValueIsDecimal(id);" onfocus="CheckValueIsDecimal(id);" onblur="CheckDecimalFormat(id); Voucher_CalculateTotal();" class="form-control parsley-validated input-sm" data-required="false" maxlength="11" placeholder="" />
                                    </div>
                                    <div class="col-sm-2">
                                        <label>@Forwarding.MvcApp.App_Resources.App_Resources.DisbursementJobs</label>
                                        <select id="slDisbursementJobs" tabindex="800" class="form-control parsley-validated input-sm" onchange="Voucher_CalculateTotal();" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" data-required="false"></select>
                                    </div>
                                    <div class="col-sm-1">
                                        <label>@Forwarding.MvcApp.App_Resources.App_Resources.Search</label>
                                        <button id="btn-DasJobSearch" class="form-control btn btn-primary btn-sm m-t-n-xs swapChildrenClass" data-toggle="modal" @*data-target="#DetailsModal"*@ onkeypress="DisableEnterKey(id);" onfocus="DisableEnterKey(id);" onkeydown="DisableEnterKey(id);" onclick="JobSearch();"><i class="fa fa-search"></i><b>&nbsp;JobNo&nbsp;</b></button>
                                    </div>
                                    <div class="col-sm-3">
                                        <label>@Forwarding.MvcApp.App_Resources.App_Resources.Salesman</label>
                                        <select id="slSalesMan" tabindex="800" class="form-control parsley-validated input-sm" onchange="Voucher_CalculateTotal();" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" data-required="false"></select>
                                    </div>
                                    <!--<div class="col-sm-2"></div> -->
                                </div>
                            </div>
                            <div class="row">
                                @*This div is to make controls clickable*@
                                <div class="col-sm-12 swapChildrenClass" style="">
                                    <div class="col-sm-3">
                                        <label>@Forwarding.MvcApp.App_Resources.App_Resources.Notes</label>
                                        <input id="txtNotes" tabindex="840" type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" class="form-control parsley-validated input-sm" maxlength="500" placeholder="" data-required="false" style="text-transform:uppercase" />
                                    </div>
                                    <!--<div class="col-sm-2"></div> -->

                                    <div class="input-group col-sm-2 m-t-27 hide  ">
                                        <input id="txtPaymentRequestCode" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="text-transform:uppercase" type="text" class="input-sm form-control" binding-name="SearchPlaceHolder" binding-prop="placeholder" placeholder="Search payment request">
                                        <span class="input-group-btn">
                                            <button id="btn-PaymentRequestCode" title="Search" class="btn btn-sm btn-warning" onclick="CheckPaymentRequest();" type="button"><i class="fa fa-search"></i></button>
                                        </span>
                                    </div>
                                    <div class="col-sm-2 hide">
                                        <label class="m-t-27" id="lblPaymentRequestCode"></label>
                                    </div>
                                    <div class="row hide classShowForMesco ">

                                        <div class="input-group col-sm-2 m-t-27 hide classShowForMesco_Receive  ">
                                            <input id="txtDownPaymentCode" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="text-transform:uppercase" type="text" class="input-sm form-control" binding-name="SearchPlaceHolder" binding-prop="placeholder" placeholder="Search Down Payment">
                                            <span class="input-group-btn">
                                                <button id="btn-DownPaymentCode" title="Search" class="btn btn-sm btn-warning" onclick="SearchDownPayment();" type="button"><i class="fa fa-search"></i></button>
                                            </span>
                                        </div>

                                        <div class="input-group col-sm-2 m-t-27 hide classShowForMesco_Issue  ">
                                            <input id="txtCreditNoteCode" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="text-transform:uppercase" type="text" class="input-sm form-control" binding-name="SearchPlaceHolder" binding-prop="placeholder" placeholder="Search Credit Note">
                                            <span class="input-group-btn">
                                                <button id="btn-CreditNoteCode" title="Search" class="btn btn-sm btn-warning" onclick="SearchCreditNoteCode();" type="button"><i class="fa fa-search"></i></button>
                                            </span>
                                        </div>



                                    </div>
                                </div>

                            </div>
                 
                        </div>
                    </fieldset>
                </div>
