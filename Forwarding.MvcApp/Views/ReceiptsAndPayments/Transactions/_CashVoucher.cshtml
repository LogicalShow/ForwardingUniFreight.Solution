    <li>
        <a id="ReceiptsAndPaymentsMasterData" href="javascript:void(0);" onclick="LoadViews('ReceiptsAndPaymentsTransactions');">
            @Forwarding.MvcApp.App_Resources.App_Resources.RecAndPayTransactions
        </a>
