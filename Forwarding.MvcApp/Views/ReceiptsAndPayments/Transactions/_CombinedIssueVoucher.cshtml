<!-- start breadcrumb  -->
<ul id="ul-breadcrumb" class="breadcrumb no-border no-radius b-b b-light pull-in">
    <li>
        <a id="hl-homepage" href="javascript:void(0);">
            <i class="fa fa-home icon-home"></i><span>@Forwarding.MvcApp.App_Resources.App_Resources.HomePage</span>
        </a>
    </li>
    <li>
        <a id="liGroupName" href="javascript:void(0);" @*onclick="LoadViews('Invoicing');"*@>
            @*@Forwarding.MvcApp.App_Resources.App_Resources.MasterData*@
        </a>
    </li>
    <li>
        <a id="liTabName" href="javascript:void(0);" @*onclick="LoadViews('Invoicing');"*@>
            @*@Forwarding.MvcApp.App_Resources.App_Resources.Invoicing*@
        </a>
    </li>
    <li class="active">@Forwarding.MvcApp.App_Resources.App_Resources.CombinedIssueVoucher</li>
</ul>
<!-- end breadcrumb  -->

<div id="div-CombinedIssueVoucher">
    <div id="div-Data">
        <div id="div-Options">
            <div id="div-Action" class="radius-top-left-right">
            </div>
        </div>
        <section class="panel panel-default">
            <header class="panel-heading">
                <h3 class="m-b-none">
                    @Forwarding.MvcApp.App_Resources.App_Resources.CombinedIssueVoucher
                </h3>
            </header>
            <!--Region the searh, delete, addnew-->
            <div class="row text-sm wrapper hidden-print ">
                <div id="div-main-options " class="col-sm-12 m-b-xs row" style="">
                    <div class="col-sm-1">
                        <button id="btn-Search" class="btn btn-primary btn-sm swapChildrenClass" onclick="CombinedIssueVoucher_LoadingWithPaging()" data-toggle="modal" data-target="#"><i class="fa fa-search"></i><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Search&nbsp;</b></button>
                    </div>

                    <div class="col-sm-1 swapChildrenClass m-t-xs">
                        <input tabindex="" value="1" type="radio" name="nameRdGroup" onchange="IsCashChecked();" id="cbIsCash" checked="checked" onfocus="    DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"> <b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Cash&nbsp;</b>
                    </div>
                    <div class="col-sm-1 swapChildrenClass m-t-xs">
                        <input tabindex="" value="2" type="radio" name="nameRdGroup" onchange="IsChequeChecked();" id="cbIsCheque" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"> <b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Cheque&nbsp;</b>
                    </div>

                    <div id="div-search-controls" class="input-group col-sm-3">
                        <input id="txt-Search" autocomplete="off" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="text-transform:uppercase" type="text" class="input-sm form-control" binding-name="SearchPlaceHolder" binding-prop="placeholder" placeholder="Search by payment request code">
                        <span class="input-group-btn">
                            <button id="btn-search" class="btn btn-sm btn-primary" type="button" onclick="CombinedIssueVoucher_LoadingWithPaging();"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                    <div class="swapChildrenClass col-sm-2 hide classShowForMESCO">
                        <label class="hide">@Forwarding.MvcApp.App_Resources.App_Resources.PartnerType</label>
                        <div class="input-group">
                            <select id="slPartnerType" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" class="form-control m-b input-sm" data-required="false"></select>
                            <span class="input-group-btn">
                                <button id="btn-filterPartnerType" title="Search" class="btn btn-sm btn-warning" onclick="CombinedPartnerTypeChanged();" type="button"><i class="fa fa-filter"></i></button>
                            </span>
                        </div>
                    </div>

                    <div class="swapChildrenClass col-sm-3 Edit-btn hide classShowForMESCO">
                        <label class="hide">@Forwarding.MvcApp.App_Resources.App_Resources.PartnerName</label>
                        <div class="input-group swapChildrenClass">
                            <select id="slClient" class="input-sm form-control Edit-input" data-required="false" onchange=""></select>
                        </div>
                    </div>

                    <div style="clear:both">
                        <div class="col-sm-2 swapChildrenClass m-t-xs">
                            <label>@Forwarding.MvcApp.App_Resources.App_Resources.From</label>
                            <input id="txtFromDate" readonly="readonly" type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="background-color:white;cursor:text;" class="input-sm datepicker-input form-control" data-date-format="dd/mm/yyyy" placeholder="Select Date" />
                        </div>

                        <div class="col-sm-2 swapChildrenClass m-t-xs">
                            <label>@Forwarding.MvcApp.App_Resources.App_Resources.To</label>
                            <input id="txtToDate" readonly="readonly" type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="background-color:white;cursor:text;" class="input-sm datepicker-input form-control" data-date-format="dd/mm/yyyy" placeholder="Select Date" />
                        </div>

                        <div class="swapChildrenClass m-t-xs col-sm-2">
                            <label>@Forwarding.MvcApp.App_Resources.App_Resources.Safe</label>
                            <select id="slSafe" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" onchange="GetSafeBalance()" class="form-control input-sm"><option value=""><--Select--></option></select>
                        </div>
                        <div class="swapChildrenClass m-t-xs col-sm-2 hide">
                            <label>@Forwarding.MvcApp.App_Resources.App_Resources.Bank</label>
                            <select id="slBank" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" onchange="GetBankBalance()" class="form-control input-sm"><option value=""><--Select--></option></select>
                        </div>
                        <div class="swapChildrenClass m-t-xs col-sm-2 hide classShowForMESCO">

                            <label>@Forwarding.MvcApp.App_Resources.App_Resources.Custody</label>
                            <select id="slSearchCustody" onchange="" class="form-control m-b input-sm " data-required="false"></select>
                        </div>
                    </div>
                    <div style="clear:both;display:flex;align-items:center;justify-content:space-around" class="row col-sm-12 m-t-lg">
                        <h3>Openning Balance</h3>

                        <div>
                            <label>EGP</label>
                            <input style="text-align:center" disabled="disabled" type="text" id="txtEGPOpenningBalance" oninput="" class="form-control input-sm OpenningBalance">
                        </div>

                        <div>
                            <label>USD</label>
                            <input style="text-align:center" disabled="disabled" type="text" id="txtUSDOpenningBalance" oninput="" class="form-control input-sm OpenningBalance">
                        </div>

                        <div>
                            <label>EUR</label>
                            <input style="text-align:center" disabled="disabled" type="text" id="txtEUROpenningBalance" oninput="" class="form-control input-sm OpenningBalance">
                        </div>

                        <div>
                            <label>GBP</label>
                            <input style="text-align:center" disabled="disabled" type="text" id="txtGBPOpenningBalance" oninput="" class="form-control input-sm OpenningBalance">
                        </div>

                    </div>

                </div>
            </div>
            <!--Region the searh, delete, addnew-->
            <!--Region: table header-->
            <div class="table-responsive">
                <table id="tblCombinedIssueVoucher" class="table table-striped b-t b-light text-sm  table-hover">
                    <thead>
                        <tr>
                            <th id="ID" style="width:5%;">
                                <input id="cb-CheckAll" type="checkbox" />
                            </th>
                            <th class="m-r- classHideForMESCO"> Payment Request Code</th>
                            <th class="m-r-"> @Forwarding.MvcApp.App_Resources.App_Resources.PONumber</th>
                            <th class="m-r-"> @Forwarding.MvcApp.App_Resources.App_Resources.Amount</th>
                            <th class="m-r-"> @Forwarding.MvcApp.App_Resources.App_Resources.RequestDate</th>
                            <th class="m-r-"> @Forwarding.MvcApp.App_Resources.App_Resources.ApprovedOn</th>
                            <th class="m-r-"> @Forwarding.MvcApp.App_Resources.App_Resources.IsCombinedPaymentRequest</th>
                            <th class="m-r-"> Is Fleet</th>
                            <th class="m-r-"> @Forwarding.MvcApp.App_Resources.App_Resources.ChargedPerson</th>
                            <th class="m-r- hide classShowForMESCO"> @Forwarding.MvcApp.App_Resources.App_Resources.Custody</th>
                            <th class="m-r- hide classShowForMESCO"> @Forwarding.MvcApp.App_Resources.App_Resources.PartnerName</th>
                            @*<th> @Forwarding.MvcApp.App_Resources.App_Resources.Order</th>
        <th> @Forwarding.MvcApp.App_Resources.App_Resources.LastAction</th>*@
                            <th class="rounded-right"></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>

                <div style="clear:both;display:flex;align-items:center;justify-content:space-around" class="row col-sm-12 m-t-lg m-b-lg">
                    <h3>Ending Balance</h3>

                    <div>
                        <label>EGP</label>
                        <input style="text-align:center" disabled="disabled" type="text" id="txtEGPEndingBalance" oninput="" class="form-control input-sm EndingBalance">
                    </div>

                    <div>
                        <label>USD</label>
                        <input style="text-align:center" disabled="disabled" type="text" id="txtUSDEndingBalance" oninput="" class="form-control input-sm EndingBalance">
                    </div>

                    <div>
                        <label>EUR</label>
                        <input style="text-align:center" disabled="disabled" type="text" id="txtEUREndingBalance" oninput="" class="form-control input-sm EndingBalance">
                    </div>

                    <div>
                        <label>GBP</label>
                        <input style="text-align:center" disabled="disabled" type="text" id="txtGBPEndingBalance" oninput="" class="form-control input-sm EndingBalance">
                    </div>

                </div>
            </div>
            <!--Region: table header-->
            <!--Region: footer-->
            <footer class="panel-footer">
                <div class="row">
                    <div class="col-sm-4 hidden-xs">
                        <select id="select-page-size" class="input-sm form-control input-s-sm inline">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                        <button id="btn-applypaging" class="btn btn-sm btn-default" type="button">
                            @Forwarding.MvcApp.App_Resources.App_Resources.Apply
                        </button>
                    </div>
                    <div id="div-Text-Total" class="col-sm-4 text-center">
                        <small class="text-muted inline m-t-sm m-b-sm">
                            @Forwarding.MvcApp.App_Resources.App_Resources.Showing
                            <span id="spn-first-page-row"></span>- <span id="spn-last-page-row"></span> @Forwarding.MvcApp.App_Resources.App_Resources.Of
                            <span id="spn-total-count"></span> @Forwarding.MvcApp.App_Resources.App_Resources.Items
                        </small>
                    </div>
                    <div id="div-Pager" class="col-sm-4 text-right text-center-xs float-right"></div>
                </div>
            </footer>
            <!--Region: footer-->

            
        </section>
    </div>
</div>


<!-- Add / Edit Region Modal -->
<div class="modal fade" id="CombinedIssueVoucherModal" tabindex="-1" data-keyboard="true" data-backdrop="false" role="dialog" aria-labelledby="CombinedIssueVoucherModalLabel" aria-hidden="true">
    <div class="modal-dialog modalwidth-70">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
                    &times;
                </button>
                <h3 class="m-b-none swapChildrenClass">
                    <span>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.CombinedIssueVoucher &nbsp;</span><label id="lblShown" purpose="dynamicLabel" class="static-text-primary"></label>
                </h3>
            </div>
            <!-- Region Add / Edit Region Form -->
            <div class="modal-body">
                <div class="span7 form vertical-mode" id="CombinedIssueVoucher-form">
                    <fieldset>
                        <div class="form-group pull-in  has-error clearfix">
                            <input id="hID" type="hidden" />
                            <!-- start alert message region -->
                            @*<div class="alert alert-danger div-error">
                                    @Forwarding.MvcApp.App_Resources.App_Resources.ErrorMessage
                                </div>*@
                            <!-- end alert message region -->
                            <!-- Region Add / Edit Region Form -->
                            <div class="form-group col-sm-6">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.Name</label>
                                <input type="text" id="txtName" autocomplete="off" class="form-control parsley-validated input-sm" data-required="true" maxlength="200" placeholder="" style="text-transform:uppercase" />
                            </div>
                            <div class="form-group col-sm-6">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.Order</label>
                                <input id="txtOrderNo" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" type="number" class="form-control parsley-validated" maxlength="2" style="text-transform:uppercase" />
                            </div>
                            <div class="form-group col-sm-6">
                                <label><input type="checkbox" id="cbCreatePaymentOrderOnApprove" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp; Create payment order on approve</label><br />
                            </div>
                            <div class="form-group col-sm-6">
                                <label><input type="checkbox" id="cbIsLastLevel" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp; @Forwarding.MvcApp.App_Resources.App_Resources.LastAction</label><br />
                            </div>

                            <!-- Region Add / Edit Region Form -->
                        </div>
                    </fieldset>
                </div>
            </div>
            <!-- Endregion Add / Edit Region Form -->
            <div class="modal-footer">
                <button type="button" id="btnSave" class="btn btn-primary btn-sm swapChildrenClass" onclick="CombinedIssueVoucher_Insert(false);">
                    <span class="glyphicon glyphicon-save"></span><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Save&nbsp;</b>
                </button>
                <button type="button" id="btnSaveandNew" class="btn btn-primary btn-sm swapChildrenClass hide" onclick="CombinedIssueVoucher_Insert(true);">
                    <span class="glyphicon glyphicon-save"></span><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.SaveAndNew&nbsp;</b>
                </button>
                <button class="btnClose btn btn-link btn-sm" id="btnClose" onclick="" data-dismiss="modal" aria-hidden="true"><b>@Forwarding.MvcApp.App_Resources.App_Resources.Close</b></button><!--sherif: i added an id and the onclick fn go set the timelocked in the DB to null-->
            </div>
        </div>
    </div>
</div>
<!-- Region Options & Template  -->
