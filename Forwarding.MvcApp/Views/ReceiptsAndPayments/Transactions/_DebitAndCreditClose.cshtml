<!--SelectChargesModal-->
<div class="modal fade" id="SelectChargesModal" tabindex="-1" style="z-index: 1050;" data-keyboard="true" data-backdrop="false" role="dialog" aria-labelledby="SelectChargesModalLabel" aria-hidden="true">
    <div class="modal-dialog modalwidth-100">
        <div class="modal-content m-t-n-lg">
            <div class="modal-header">
                <h3 class="m-b-none">
                    @Forwarding.MvcApp.App_Resources.App_Resources.Charges &nbsp;<label id="lblShownOperationCode" purpose="dynamicLabel" class="static-text-primary"></label>
                </h3>
                <h6 id="h6ChargesHeader_Quotation" class="m-b-none hide">
                    <div class="form-group float-right">
                        <!--i need those Divs for not to start from a new line-->
                        @Forwarding.MvcApp.App_Resources.App_Resources.Salesman&nbsp;<label id="lblSalesman_Quotation" purpose="dynamicLabel" class="static-text-blue"></label>
                    </div>
                    <label id="lblDirection_Quotation" purpose="" class=""></label>
                    <label id="lblTransport_Quotation" purpose="" class=""></label>
                    @Forwarding.MvcApp.App_Resources.App_Resources.Client&nbsp;<label id="lblClient_Quotation" purpose="" class="static-text-primary"></label>
                    @Forwarding.MvcApp.App_Resources.App_Resources.Route&nbsp;<label id="lblRouting_Quotation" purpose="" class="static-text-primary"></label>
                    &nbsp;&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Expiration&nbsp;<label id="lblExpirationDate_Quotation" purpose="" class="static-text-blue"></label>
                    @*&nbsp;&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Direction&nbsp;<label id="lblDirection_Quotation" purpose=""></label>*@
                    @*&nbsp;&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Transport&nbsp;<label id="lblTransport_Quotation" purpose=""></label>*@
                    @*<br />@Forwarding.MvcApp.App_Resources.App_Resources.Code&nbsp;<label id="lblQuotationCode_Quotation" purpose="" class="static-text-blue"></label>*@
                    @*&nbsp;&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Stage&nbsp;<label id="lblStage_Quotation" purpose="" class="static-text-blue"></label>*@
                    <br />@Forwarding.MvcApp.App_Resources.App_Resources.Type&nbsp;<label id="lblShipmentType_Quotation" purpose="" class="static-text-blue"></label>
                </h6>
                <h6 id="h6ChargesHeader_TO" class="m-b-none hide">
                    @*<label id="lblDirection_TO" purpose="" class=""></label>
                        <label id="lblTransport_TO" purpose="" class=""></label>
                        @Forwarding.MvcApp.App_Resources.App_Resources.Client&nbsp;<label id="lblClient_TO" purpose="" class="static-text-primary"></label>*@
                    &nbsp;&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.BillNo&nbsp;<label id="lblBillNumber_TO" purpose="" class="static-text-primary"></label>
                    <br />Gate-In Port&nbsp;<label id="lblGateInPort_TO" purpose="" class="static-text-blue"></label>
                    &nbsp;&nbsp;Gate-In Date&nbsp;<label id="lblGateInDate_TO" purpose="" class="static-text-blue"></label>
                    &nbsp;&nbsp;Gate-Out Port&nbsp;<label id="lblGateOutPort_TO" purpose="" class="static-text-blue"></label>
                    &nbsp;&nbsp;Gate-Out Date&nbsp;<label id="lblGateOutDate_TO" purpose="" class="static-text-blue"></label>
                    <br />Stuffing Date&nbsp;<label id="lbStuffingDate_TO" purpose=""></label>
                    @*&nbsp;&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Transport&nbsp;<label id="lblTransport_TO" purpose=""></label>*@
                    @*<br />@Forwarding.MvcApp.App_Resources.App_Resources.Code&nbsp;<label id="lblQuotationCode_TO" purpose="" class="static-text-blue"></label>*@
                    @*&nbsp;&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Stage&nbsp;<label id="lblStage_TO" purpose="" class="static-text-blue"></label>*@
                    <br />@Forwarding.MvcApp.App_Resources.App_Resources.BookingNumber&nbsp;<label id="lblBookingNumber_TO" purpose="" class="static-text-blue"></label>
                </h6>
            </div>
            <div class="modal-body">
                <!-- Region SelectCharges Form -->
                <div class="span7 form vertical-mode" id="SelectCharges-form">
                    <fieldset style="min-width: auto;">
                        <div class="row">
                            <div id="div-search-controls" class="input-group m-l col-sm-5">
                                <input id="txtSearchCharges" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="text-transform:uppercase" type="text" class="input-sm form-control" binding-name="SearchPlaceHolder" binding-prop="placeholder" placeholder="Search Code / Name">
                                <span class="input-group-btn">
                                    <button id="btn-SearchCharges" class="btn btn-sm btn-primary" type="button"><i class="fa fa-search"></i></button>
                                </span>
                            </div>
                            <div id="div-search-controls-sl" class="input-group col-sm-3 hide classShowForGBL">
                                <select id="slSearchCharges" onfocus="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" class="input-sm form-control">
                                    <option value=""><--All--></option>
                                    <option value="10">1 Ton</option>
                                    <option value="20">3 Tons</option>
                                    <option value="30">5 Tons</option>
                                    <option value="40">Canter</option>
                                    <option value="50">Car Carriers</option>
                                    <option value="60">Container</option>
                                    <option value="70">Flatbed</option>
                                    <option value="80">Gen Set Truck</option>
                                    <option value="90">Pickup</option>
                                    <option value="100">Towing</option>
                                </select>
                                <span class="input-group-btn">
                                    <button id="btn-SearchCharges-sl" class="btn btn-sm btn-primary" type="button"><i class="fa fa-search"></i></button>
                                </span>
                            </div>
                        </div>
                        <br />
                        <div id="divSelectCharges">
                        </div>
                    </fieldset>
                </div>
                <!-- Endegion SelectCharges Form -->
            </div>
            <div class="modal-footer">
                <!--sherif-->
                <button type="button" id="btnAddNewCharge" class="btn btn-warning btn-sm hide" onclick="Operations_InsertFromOperations('ChargeType');">
                    <span class="glyphicon glyphicon-plus"></span>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.New
                </button>
                <button type="button" id="btnSelectChargesApply" class="btn btn-primary btn-sm">
                    <span class="glyphicon glyphicon-save"></span>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Save
                </button>
                <button class="btn btn-link btn-sm" data-dismiss="modal" aria-hidden="true">@Forwarding.MvcApp.App_Resources.App_Resources.Close</button>
            </div>
        </div>
    </div>
</div>
<!--EOF SelectChargesModal-->
