<!-- start breadcrumb  -->
<ul id="ul-breadcrumb" class="breadcrumb no-border no-radius b-b b-light pull-in">
    <li>
        <a id="hl-homepage" href="javascript:void(0);" onclick="LoadViews(id);">
            <i class="fa fa-home icon-home"></i><span>@Forwarding.MvcApp.App_Resources.App_Resources.HomePage</span>
        </a>
    </li>
    <li>
        <a id="Reports" href="javascript:void(0);" onclick="LoadViews('OperAccountingReports')">
            @Forwarding.MvcApp.App_Resources.App_Resources.Reports
    </a>
</li>
<li>
    <a id="AccountingReports" href="javascript:void(0);" onclick="LoadViews('OperAccountingReports');">
        @Forwarding.MvcApp.App_Resources.App_Resources.AccountingReports
</a>
</li>
<li class="active">@Forwarding.MvcApp.App_Resources.App_Resources.ServiceInvoiceReport</li>
</ul>
<!-- end breadcrumb  -->

<div id="div-ProfitStatistics">
    <!-- Region Options & Template  -->
    <div id="div-Data">
        <div id="div-Options">
            <div id="div-Action" class="radius-top-left-right">
            </div>
        </div>
        <section class="panel panel-default">
            <header class="panel-heading">
                <div id="hExportedTable" class="hide"></div>
                <h3 class="m-b-none">@Forwarding.MvcApp.App_Resources.App_Resources.FilterBy</h3>
                @*<h3 class="m-b-none">Best Print Using Internet Explorer</h3>*@
            </header>
            <!--Region the searh, delete, addnew-->
            <div class="row text-sm wrapper hidden-print m-l">
                <div id="div-main-options">
                    <!--Region Filter-->

                    <div class="form-group col-sm-3 m-l-n">
                        <label>From Oper.Date</label>
                        <input id="txtFromOpenDate" readonly="readonly" type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="background-color:white; cursor:text;" class="input-sm datepicker-input form-control" data-date-format="dd/mm/yyyy" placeholder="Select Date" />
                    </div>
                    <div class="form-group col-sm-3 m-l-n">
                        <label>To Oper.Date</label>
                        <input id="txtToOpenDate" readonly="readonly" type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="background-color:white; cursor:text;" class="input-sm datepicker-input form-control" data-date-format="dd/mm/yyyy" placeholder="Select Date" />
                    </div>

                    <div class="input-group col-sm-3 m-l-n">
                        <label>@Forwarding.MvcApp.App_Resources.App_Resources.PartnerType</label>
                        <select id="slPartnerType" onchange="ServiceInvoiceReport_PartnerTypeChanged();" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" class="form-control input-sm"></select>
                    </div>
                    <div class="form-group col-sm-3 m-l-n">
                        <label>@Forwarding.MvcApp.App_Resources.App_Resources.Partner</label>
                        <select id="slPartner" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" class="form-control input-sm"></select>
                    </div>



                    <div class="form-group col-sm-3 m-l-n">
                        <label>@Forwarding.MvcApp.App_Resources.App_Resources.POLCountry</label>
                        <select id="slPOLCountries" name="slPOLCountries" class="form-control input-sm" onchange="POL_GetList();" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);"><option value=""><--Select--></option></select>
                    </div>
                    <div class="form-group col-sm-3 m-l-n">
                        <label>@Forwarding.MvcApp.App_Resources.App_Resources.POL</label>
                        <select id="slPOL" class="form-control input-sm" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);"><option value=""><--Select--></option></select>
                    </div>
                    <div class="form-group col-sm-3 m-l-n">
                        <label>@Forwarding.MvcApp.App_Resources.App_Resources.PODCountry</label>
                        <select id="slPODCountries" name="slPODCountries" class="form-control input-sm" onchange="POD_GetList();" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);"><option value=""><--Select--></option></select>
                    </div>
                    <div class="form-group col-sm-3 m-l-n">
                        <label id="lblPOD">@Forwarding.MvcApp.App_Resources.App_Resources.POD</label>
                        <select id="slPOD" class="form-control input-sm" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);"><option value=""><--Select--></option></select>
                    </div>


                    <div class="col-sm-3 m-l-n m-t-md" data-toggle="buttons">
                        <button id="btn-print" type="button" class="btn btn-lightblue btn-sm m-t-xxs" onclick="ServiceInvoiceReport_Print('Print');"><i class="fa fa-print"></i>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Print</button>
                    </div>



                    <!--EOF Region Filter-->
                </div>


            </div>
            <!--EOF Region the searh, delete, addnew line-->

        </section>
    </div>

</div>
