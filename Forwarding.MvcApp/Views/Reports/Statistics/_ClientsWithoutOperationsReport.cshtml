<!-- start breadcrumb  -->
<ul id="ul-breadcrumb" class="breadcrumb no-border no-radius b-b b-light pull-in">
    <li>
        <a id="hl-homepage" href="javascript:void(0);" onclick="LoadViews(id);">
            <i class="fa fa-home icon-home"></i><span>@Forwarding.MvcApp.App_Resources.App_Resources.HomePage</span>
        </a>
    </li>
    <li>
        <a id="Reports" href="javascript:void(0);" onclick="LoadViews('Statistics')">
            @Forwarding.MvcApp.App_Resources.App_Resources.Reports
        </a>
    </li>
    <li>
        <a id="Statistics" href="javascript:void(0);" onclick="LoadViews('Statistics');">
            @Forwarding.MvcApp.App_Resources.App_Resources.Statistics
        </a>
    </li>
    <li id="liFormName" class="active"></li>
</ul>
<!-- end breadcrumb  -->

<div id="div-OperationCustomersReport">
    <!-- Region Options & Template  -->
    <div id="div-Data">
        <div id="div-Options">
            <div id="div-Action" class="radius-top-left-right">
            </div>
        </div>
        <section class="panel panel-default">
            <header class="panel-heading">
                <div id="hExportedTable" class="hide"></div>
                <h3 class="m-b-none">@Forwarding.MvcApp.App_Resources.App_Resources.Report_ClientsWithoutOperations</h3>
            </header>
            <!--Region the searh, delete, addnew-->
            <div class="row text-sm wrapper hidden-print m-l">
                <div id="div-main-options">
                    <div class="row">
                        <div class="form-group col-sm-2">
                            <label>@Forwarding.MvcApp.App_Resources.App_Resources.FromDate</label>
                            <input id="txtFromDate" readonly="readonly" type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="background-color:white; cursor:text;" class="input-sm datepicker-input form-control" data-date-format="yyyy/mm/dd" placeholder="Select Date" />
                        </div>
                        <div class="form-group col-sm-2">
                            <label>@Forwarding.MvcApp.App_Resources.App_Resources.ToDate</label>
                            <input id="txtToDate" readonly="readonly" type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="background-color:white; cursor:text;" class="input-sm datepicker-input form-control" data-date-format="yyyy/mm/dd" placeholder="Select Date" />
                        </div>
                        <div class="form-group col-sm-2 m-t-md">
                            <label> <input type="checkbox" id="cbIncludeInactive" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp; Include Inactive Clients </label>
                        </div>
                        <div class="form-group col-sm-1 m-t-md">
                            <button type="button" onclick="Print('Print');" class="btn btn-sm btn-info"><i class="fa fa-file-pdf-o"></i><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Print&nbsp;</b></button>
                        </div>
                        <div class="form-group col-sm-1 m-t-md">
                            <button type="button" onclick="Print('Excel');" class="btn btn-sm btn-primary"><i class="fa fa-file-excel-o"></i><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Export&nbsp;</b></button>
                        </div>
                    </div>
                 
                </div>
            </div>
            <!--EOF Region the searh, delete, addnew line-->
          
           
        </section>
    </div>
</div>
