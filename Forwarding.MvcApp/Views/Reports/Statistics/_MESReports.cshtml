<!--BookingControlReportModal-->
<div class="modal fade" id="bookingControlReport" tabindex="-1" style="z-index: 1040;" data-keyboard="true" data-backdrop="false" role="dialog" aria-labelledby="bookingControlReportLabel" aria-hidden="true">
    <div class="modal-dialog modalwidth-50">
        <div class="modal-content">
            <div class="modal-header">
            </div>
            <div class="modal-body">
                <div class="span7 form vertical-mode">
                    <fieldset>
                        <div class="form-group pull-in  has-error clearfix">
                            <div class="form-group col-sm-9 m-l-md">
                                <label><input type="checkbox" id="bookingReportOption1" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"> 1.Under Processing</label>
                                <br />
                                <label><input type="checkbox" id="bookingReportOption2" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"> 2.Service Ended and No Sales Con</label>
                                <br />
                                <label><input type="checkbox" id="bookingReportOption3" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"> 3.Confirmed by Sales and not inv</label>
                                <br />
                                <label><input type="checkbox" id="bookingReportOption4" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"> 4.Invoiced And No Sending Date</label>
                                <br />
                                <label><input type="checkbox" id="bookingReportOption5" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"> 5.Invoiced and Not Collected</label>
                                <br />
                                <label><input type="checkbox" id="bookingReportOption6" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"> 6.Invoiced and collected during t</label>
                            </div>
                            <div class="col-sm-3">
                                <label>From Date</label>
                                <input id="txtBookingReportfromDate" type="text" onfocus="DisableEnterKey(id);" data-required="false" onkeypress="DisableEnterKey(id);" style="cursor:text;" class="datepicker-input form-control input-sm" data-date-format="dd/mm/yyyy" placeholder="Select Date" />
                                <br />
                                <label>To Date</label>
                                <input id="txtBookingReportToDate" type="text" onfocus="DisableEnterKey(id);" data-required="false" onkeypress="DisableEnterKey(id);" style="cursor:text;" class="datepicker-input form-control input-sm" data-date-format="dd/mm/yyyy" placeholder="Select Date" />
                            </div>
                        </div>
                    </fieldset>
                </div>
                <!-- Endegion Add / Edit Country Form -->
            </div>
            <div class="modal-footer m-t-n">
                <!--sherif-->
                <button type="button" class="btn btn-primary btn-sm" onclick="print_BookingControlReport();">
                    Print
                </button>
                <button class="btn btn-link btn-sm" data-dismiss="modal" aria-hidden="true">@Forwarding.MvcApp.App_Resources.App_Resources.Close</button>
            </div>
        </div>
    </div>
