<!-- start breadcrumb  -->
<ul id="ul-breadcrumb" class="breadcrumb no-border no-radius b-b b-light pull-in">
    <li>
        <a id="hl-homepage" href="javascript:void(0);" onclick="LoadViews(id);">
            <i class="fa fa-home icon-home"></i><span>@Forwarding.MvcApp.App_Resources.App_Resources.HomePage</span>
        </a>
    </li>
    <li>
        <a id="Reports" href="javascript:void(0);" onclick="LoadViews('Statistics')">
            @Forwarding.MvcApp.App_Resources.App_Resources.Reports
        </a>
    </li>
    <li>
        <a id="Statistics" href="javascript:void(0);" onclick="LoadViews('Statistics');">
            @Forwarding.MvcApp.App_Resources.App_Resources.Statistics
        </a>
    </li>
    <li class="active">@Forwarding.MvcApp.App_Resources.App_Resources.QuotationsStatistics</li>
</ul>
<!-- end breadcrumb  -->

<div id="div-QuotationsStatistics">
    <!-- Region Options & Template  -->
    <div id="div-Data">
        <div id="div-Options">
            <div id="div-Action" class="radius-top-left-right">
            </div>
        </div>
        <section class="panel panel-default">
            <header class="panel-heading">
                <div id="hExportedTable" class="hide"></div>
                <h3 class="m-b-none">@Forwarding.MvcApp.App_Resources.App_Resources.FilterBy</h3>
                @*<h3 class="m-b-none">Best Print Using Internet Explorer</h3>*@
            </header>
            <!--Region the searh, delete, addnew-->
            <div class="row text-sm wrapper hidden-print m-l">
                <div id="div-main-options">
                    <!--Region Filter-->
                    <div id="divTransportFilter" class="btn-group" data-toggle="buttons">
                        <label class="btn btn-sm btn-default active" id="lbl-filter-AllTransports" title="All Types"> <input type="radio" name="options">   <i class="fa text-active"></i> @Forwarding.MvcApp.App_Resources.App_Resources.All</label>
                        <label class="btn btn-sm btn-default       " id="lbl-filter-ocean" title="Ocean"> <input type="radio" name="options"> <i class="fa text-active ">    </i> <i class="fa fa-anchor   "></i>    </label>
                        <label class="btn btn-sm btn-default       " id="lbl-filter-air" title="Air"> <input type="radio" name="options"> <i class="fa text-active ">  </i> <i class="fa fa-plane    "></i>    </label>
                        <label class="btn btn-sm btn-default       " id="lbl-filter-inland" title="Inland"> <input type="radio" name="options"> <i class="fa text-active  "></i> <i class="fa fa-truck     "></i>    </label>
                    </div>
                    &nbsp;&nbsp;&nbsp;
                    <div id="divDirectionFilter" class="btn-group" data-toggle="buttons">
                        <label class="btn btn-sm btn-default active" id="lbl-filter-AllDirections" title="All Directions"> <input type="radio" name="options">   <i class="fa text-active"></i> @Forwarding.MvcApp.App_Resources.App_Resources.All</label>
                        <label class="btn btn-sm btn-default       " id="lbl-filter-import" title="Import"> <input type="radio" name="options">   <i class="fa text-active">    </i> <i class="fa fa-arrow-circle-down"></i> </label>
                        <label class="btn btn-sm btn-default       " id="lbl-filter-export" title="Export"> <input type="radio" name="options">   <i class="fa text-active">  </i> <i class="fa fa-external-link      "></i> </label>
                        <label class="btn btn-sm btn-default       " id="lbl-filter-domestic" title="Domestic"> <input type="radio" name="options">   <i class="fa text-active"></i> <i class="fa fa-home                   "></i> </label>
                    </div>
                    &nbsp;&nbsp;&nbsp;
                    <div id="divBLTypeFilter" class="btn-group hide" data-toggle="buttons">
                        <label class="btn btn-sm btn-default active" id="lbl-filter-AllBLTypes" title="All B/L Types"> <input type="radio" name="options">   <i class="fa text-active"></i> @Forwarding.MvcApp.App_Resources.App_Resources.All</label>
                        <label class="btn btn-sm btn-default       " id="lbl-filter-direct" title="Direct"> <input type="radio" name="options">   <i class="fa text-active">    </i> <i class="fa fa-indent"></i>    </label>
                        <label class="btn btn-sm btn-default       " id="lbl-filter-house" title="House"> <input type="radio" name="options">   <i class="fa text-active">  </i> <i class="fa fa-link      "></i>  </label>
                        <label class="btn btn-sm btn-default       " id="lbl-filter-master" title="Master"> <input type="radio" name="options">   <i class="fa text-active"></i> <i class="fa fa-book                   "></i> </label>
                    </div>
                    @*  to get the StageID selected $("#ulQuotationStages li[class=active]").val() *@
                    &nbsp;&nbsp;&nbsp;
                    @*<div class="btn-group m-r">
                        <button data-toggle="dropdown" class="btn btn-sm btn-default dropdown-toggle"><span class="dropdown-label">@Forwarding.MvcApp.App_Resources.App_Resources.AllStages</span> <span class="caret"></span></button>
                        <ul id="ulQuotationStages" class="dropdown-menu dropdown-select">*@
                    @*<li class="active" value="0"><a href="#"><input type="radio" name="d-s-r">ALL STAGES</a></li>
                        <li class="" value="1"><a href="#"><input type="radio" name="d-s-r">CREATED</a></li>
                        <li class="" value="2"><a href="#"><input type="radio" name="d-s-r">SENT</a></li>
                        <li class="" value="3"><a href="#"><input type="radio" name="d-s-r">DRAFT</a></li>
                        <li class="" value="5"><a href="#"><input type="radio" name="d-s-r">DECLINED</a></li>
                        <li class="" value="4"><a href="#"><input type="radio" name="d-s-r">ACCEPTED</a></li>*@
                    @*<li class="disabled"><a href="#"><input type="radio" name="d-s-r" disabled="">I'm disabled</a></li>*@
                    @*</ul>
                        </div>*@
                    <br /><br />
                    <div class="form-group col-sm-3 m-l-n">
                        <label>@Forwarding.MvcApp.App_Resources.App_Resources.Branch</label>
                        <select id="slBranch" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" class="form-control input-sm"></select>
                    </div>
                    <div class="form-group col-sm-3 classShowForUnSalemen m-l-n">
                        <label>@Forwarding.MvcApp.App_Resources.App_Resources.Salesman</label>
                        <select id="slSalesman" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" class="form-control input-sm"></select>
                    </div>
                    <div class="form-group col-sm-3 m-l-n">
                        <label>@Forwarding.MvcApp.App_Resources.App_Resources.CreatedBy</label>
                        <select id="slCreator" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" class="form-control input-sm"></select>
                    </div>
                    <div class="form-group col-sm-3 m-l-n">
                        <label>@Forwarding.MvcApp.App_Resources.App_Resources.Customer</label>
                        <select id="slCustomer" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" class="form-control input-sm"><option value=""><--Select--></option></select>
                    </div>
                    <div class="form-group col-sm-3 m-l-n">
                        <label>@Forwarding.MvcApp.App_Resources.App_Resources.Agent</label>
                        <select id="slAgent" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" class="form-control input-sm"></select>
                    </div>
                    @*<div class="form-group col-sm-3 m-l-n m-t-n-sm"><br><br><br><br></div>*@
                    <div class="form-group col-sm-3 m-l-n hide">
                        <label>@Forwarding.MvcApp.App_Resources.App_Resources.Currency</label>
                        <select id="slCurrency" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" class="form-control input-sm"></select>
                    </div>
                    <div class="form-group col-sm-3 m-l-n">
                        <label>@Forwarding.MvcApp.App_Resources.App_Resources.Status</label>
                        <select id="slQuotationStages" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" class="form-control input-sm"></select>
                    </div>
                    @*<br /><br /><br /><br />*@

                    <div class="form-group col-sm-3 m-l-n">
                        <label>@Forwarding.MvcApp.App_Resources.App_Resources.From</label>
                        <input id="txtFromCreationDate" readonly="readonly" type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="background-color:white; cursor:text;" class="input-sm datepicker-input form-control" data-date-format="dd/mm/yyyy" placeholder="Select Date" />
                    </div>
                    <div class="form-group col-sm-3 m-l-n">
                        <label>@Forwarding.MvcApp.App_Resources.App_Resources.To</label>
                        <input id="txtToCreationDate" readonly="readonly" type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="background-color:white; cursor:text;" class="input-sm datepicker-input form-control" data-date-format="dd/mm/yyyy" placeholder="Select Date" />
                    </div>
                    @*<div class="col-sm-3 m-l-n-sm m-t-sm">
                            <br />
                            <label> <input type="checkbox" id="cbIncludeCurrenciesDetails" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"> Show Currencies Details</label>
                            <br /><br />
                        </div>*@

                    <div>
                        <div class="col-sm-3 m-l-n-sm m-t-sm">
                            <br />
                            <label> <input type="checkbox" id="cbHideExpiredQuotations" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"> Hide Expired Quotations</label>
                            <br /><br />
                        </div>
                        <div class="col-sm-9 m-l-n-md m-t-md" data-toggle="buttons">
                            <div class="form-group col-sm-6">
                                <button id="btn-print" type="button" class="btn btn-lightblue btn-sm" onclick="QuotationsStatistics_Print('Print');"><i class="fa fa-print"></i>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Print</button>
                                <button id="btn-ExportToExcel" type="button" onclick="QuotationsStatistics_Print('Excel');" class="btn btn-sm btn-primary"><i class="fa fa-table"></i><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.TraExportExcel&nbsp;</b></button>
                                <button id="btn-SelectColumns" type="button" class="btn btn-warning btn-sm" onclick="QuotationsStatistics_SelectColumns();"><i class="fa fa-print"></i><b>&nbsp;Add / Remove Columns</b></button>
                            </div>
                            <div class="form-group col-sm-3">
                                <div class="input-group">
                                    <input type="text" id="txtToEmail" placeholder=" Send To " class="form-control input-sm">
                                    <span id="btn-SendEmail" title="Send PDF Report as Email " class="input-group-addon" onclick="QuotationsStatistics_Print('Email');" style="background-color:green;padding:5px!important;color:white;cursor:pointer;"><span class="fa fa-envelope">&nbsp; @Forwarding.MvcApp.App_Resources.App_Resources.Send</span>&nbsp;</span>
                                </div>
                            </div>

                        </div>
                        <!--EOF Region Filter-->
                    </div>
                </div>
            </div>
            <!--EOF Region the searh, delete, addnew line-->


        </section>
    </div>
</div>

<!--ModalSelectColumns-->
<div class="modal fade" id="ModalSelectColumns" tabindex="-1" style="z-index: 3000;" data-keyboard="true" data-backdrop="false" role="dialog" aria-labelledby="ModalSelectColumnsLabel" aria-hidden="true">
    <div class="modal-dialog modalwidth-90">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="m-b-none">
                    &nbsp;<label id="lblShownItems" purpose="dynamicLabel" class="static-text-primary">Select columns to show:</label>
                </h3>
            </div>
            <div class="modal-body">
                <!-- Region SelectColumns Form -->
                <div class="span7 form vertical-mode" id="SelectColumns-form">
                    <fieldset>

                        <button id="btn-CheckAllColumns" type="button" class="btn btn-lightblue btn-sm m-l" onclick="SetSelectedColumns(true);"><i class="fa "></i><b>&nbsp;Check All</b></button>
                        <button id="btn-ClearAllColumns" type="button" class="btn btn-warning btn-sm m-l" onclick="SetSelectedColumns(false);"><i class="fa "></i><b>&nbsp;Clear All</b></button>

                        <div id="divSelectColumns" class="m-t" style="clear:both;">
                            <div class="col-sm-2">
                                <label><input type="checkbox" id="cbServiceType" class="classCheckColumn" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;Service Type</label>
                            </div>
                            <div class="col-sm-2">
                                <label><input type="checkbox" id="cbTransportType" class="classCheckColumn" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;Transport Type</label>
                            </div>
                            <div class="col-sm-2">
                                <label><input type="checkbox" id="cbTotalInDefaultCurrency" class="classCheckColumn" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;Total In Default Currency</label>
                            </div>
                            <div class="col-sm-2">
                                <label><input type="checkbox" id="cbDeclineReason" class="classCheckColumn" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;Decline Reason</label>
                            </div>
                            <div class="col-sm-2">
                                <label><input type="checkbox" id="cbOperationMan" class="classCheckColumn" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;Operation Man</label>
                            </div>
                            <div class="col-sm-2">
                                <label><input type="checkbox" id="cbApprovalUser" class="classCheckColumn" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;Approval User</label>
                            </div>
                            <div class="col-sm-2">
                                <label><input type="checkbox" id="cbRequestForChargesDate" class="classCheckColumn" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;Request For Charges Date</label>
                            </div>
                            <div class="col-sm-2">
                                <label><input type="checkbox" id="cbConfirmChargesDate" class="classCheckColumn" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;Confirm Charges Date</label>
                            </div>
                            <div class="col-sm-2">
                                <label><input type="checkbox" id="cbQuotationApprovalDate" class="classCheckColumn" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;Quotation Approval Date</label>
                            </div>
                            <div class="col-sm-2 hide">
                                <label><input type="checkbox" id="cbDateForSendingEmail" class="classCheckColumn" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;Date For Sending Email</label>
                            </div>
                            <div class="col-sm-2 hide classShowForBED">
                                <label><input type="checkbox" id="cbCreationDate" class="classCheckColumn" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;Quot. Creation Date</label>
                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>
            <div class="modal-footer">

                <button id="btn-print-FromSelect" type="button" class="btn btn-lightblue btn-sm" onclick="QuotationsStatistics_Print('Print', false);"><i class="fa fa-print"></i><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Print</b></button>
                <button id="btn-ExportToExcel-FromSelect" type="button" onclick="QuotationsStatistics_Print('Excel', false);" class="btn btn-sm btn-primary"><i class="fa fa-table"></i><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.TraExportExcel&nbsp;</b></button>

                <button class="btn btn-link btn-sm" data-dismiss="modal" aria-hidden="true">@Forwarding.MvcApp.App_Resources.App_Resources.Close</button>
            </div>
        </div>
    </div>
</div>
<!--EOF ModalSelectColumns-->