                                  <label type="button" class="btn btn-info btn-sm sm m-r-xs "><i class="btn btn-warning fa fa-table" onclick="TruckingReport_GetData('Today')"></i>&nbsp;<i class="btn btn-primary fa fa-print" onclick="TruckingReport_Print('Excel', 'Today')"></i>&nbsp;Today</label>
                                  <label type="button" class=" btn btn-info btn-sm sm m-r-xs "><i class="btn btn-warning fa fa-table" onclick="TruckingReport_GetData('Tomorrow')"></i>&nbsp;<i class="btn btn-primary fa fa-print" onclick="TruckingReport_Print('Excel', 'Tomorrow')"></i>&nbsp;Tomorrow</label>
