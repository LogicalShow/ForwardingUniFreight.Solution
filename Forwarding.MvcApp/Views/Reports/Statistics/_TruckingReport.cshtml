                          <div class="row">
                              <div class="col-sm-6">
                                  <button type="button" class="btn btn-warning btn-sm" onclick="TruckingReport_GetData('');"><i class="fa fa-table"></i><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Showing</b></button>&nbsp;
                                  <button id="btn-print" type="button" class="btn btn-lightblue btn-sm" onclick="TruckingReport_Print('Print');"><i class="fa fa-print"></i><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Print</b></button>&nbsp;
