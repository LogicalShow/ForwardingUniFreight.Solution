<div id="div-ShipsGoCustomers">
    <div id="div-Data">
        <div id="div-Options">
            <div id="div-Action" class="radius-top-left-right">
            </div>
        </div>
        <section class="panel panel-default">
            <header class="panel-heading">
                <h3 id="" class="m-b-none">
                    <span id="h3ShipsGoCustomers">BL / Container Tracking</span>
                </h3>
            </header>
            <!--Region the search, delete, addnew-->
            <div class="row text-sm wrapper">
                <div id="div-main-options">
                    <button id="btn-NewAdd" title="Search" class="btn btn-warning btn-sm hide m-l-lg" data-toggle="modal"><i class="fa fa-plus"></i>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.New</button>&nbsp;

                    <button id="btn-Delete" title="Delete" type="button" class="float-right btn btn-sm btn-danger hide m-r-lg" onclick=""><i class="fa fa-trash-o"></i>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Delete</button>

                    <section class="panel panel-default m-t-sm" style="clear:both;">
                        <!--Region: table header-->
                        <div id="divTblShipsGoCustomers" class="table-responsive" style="overflow:scroll;">
                            <table id="tblShipsGoCustomers" class="table b-t b-light text-sm table-hover ">
                                <thead>
                                    <tr>
                                        <th id="ID">
                                            <input id="cb-CheckAll" type="checkbox" />
                                        </th>
                                        <th>Customer</th>
                                        <th>Email</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                        <!--Region: EOF table header-->
                        <!--Region: table footer-->
                        <footer class="panel-footer">
                            <div class="row">
                                <div class="col-sm-4 hidden-xs">
                                    <select id="select-page-size" class="input-sm form-control input-s-sm inline">
                                        <option value="10">10</option>
                                        <option value="25">25</option>
                                        <option value="50">50</option>
                                    </select>
                                    <button id="btn-applypaging" class="btn btn-sm btn-default" type="button">
                                        @Forwarding.MvcApp.App_Resources.App_Resources.Apply
                                    </button>
                                </div>
                                <div id="div-Text-Total" class="col-sm-4 text-center">
                                    <small class="text-muted inline m-t-sm-sm">
                                        @Forwarding.MvcApp.App_Resources.App_Resources.Showing
                                        <span id="spn-first-page-row"></span>- <span id="spn-last-page-row"></span> @Forwarding.MvcApp.App_Resources.App_Resources.Of
                                        <span id="spn-total-count"></span> @Forwarding.MvcApp.App_Resources.App_Resources.Items
                                    </small>
                                </div>
                                <div id="div-Pager" class="col-sm-4 text-right text-center-xs float-right"></div>
                            </div>
                        </footer>
                        <!--Region: EOF table footer-->
                    </section>
                </div><!--EOF Region Main-Options-->
            </div>
        </section>
    </div>
</div>


<!--ShipsGoCustomer Modal-->
<div class="modal fade" id="ShipsGoCustomersModal" tabindex="-1" style="z-index: 1040;" data-keyboard="true" data-backdrop="false" role="dialog" aria-labelledby="ShipsGoCustomersModalLabel" aria-hidden="true">
    <div class="modal-dialog modalwidth-80 m-t-n-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true" title="Close">
                    &times;
                </button>
                <h3 class="m-b-none">
                    BL/Container Tracking
                </h3>
            </div>
            <!-- Region Add / Edit Region Form -->
            <div class="modal-body">
                <div class="span7 form vertical-mode" id="ShipsGoCustomer-form">
                    <fieldset>
                        <div class="form-group pull-in  has-error clearfix">
                            <input id="hShipsGoCustomerID" type="hidden" />

                            <!--Wizard-->
                            <div class="row m-l m-r">
                                <div class="col-sm-12">
                                    <div class="swapChildrenClass">
                                        <div class="form-group col-sm-6 m-t-xs">
                                            <label>Customer</label>
                                            <select id="slCustomer" name="slCustomer" class="form-control input-sm" onfocus="DisableBackspaceKey(id);" onkeydown="DisableBackspaceKey(id);" onkeypress="DisableBackspaceKey(id);" data-required="true"><option value=""><--Select--></option></select><br />
                                            <div class="hide classShowForARK">
                                                <label><input type="checkbox" id="cbIsHaveCC" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;CC Cosnignee|Shipper</label>
                                            </div>
                                        </div>
                                        <div class="form-group col-sm-6 m-t-xs">
                                            <label>@Forwarding.MvcApp.App_Resources.App_Resources.Email</label>
                                            <input type="text" id="txtEmail" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" class="form-control parsley-validated input-sm" data-required="true" maxlength="250" placeholder="abc@gmail.com" style="text-transform:uppercase" />
                                        </div>
                                        <div class="form-group col-sm-4 m-t-xs hide classShowForELI">
                                            <label>From Date</label>
                                            <input id="txtShipsGoFromDate" type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="background-color:white; cursor:text;" class="datepicker-input form-control input-sm" data-required="false" data-date-format="dd/mm/yyyy" placeholder="Select Date" />
                                        </div>
                                        <div class="form-group col-sm-4 m-t-xs hide classShowForELI">
                                            <label>To Date</label>
                                            <input id="txtShipsGoToDate" type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="background-color:white; cursor:text;" class="datepicker-input form-control input-sm" data-required="false" data-date-format="dd/mm/yyyy" placeholder="Select Date" />
                                        </div>
                                        <div class="form-group col-sm-4 m-t-xs hide classShowForELI">
                                            <label><input type="checkbox" id="cbIsImport" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;Import</label><br />
                                            <label><input type="checkbox" id="cbIsExport" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;Export</label>
                                        </div>
                                        
                                        <div class="form-group col-sm-4 m-t" style="clear:both;">
                                            <label><input type="checkbox" id="cbIsStatus" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;Status</label><br />
                                            <label><input type="checkbox" id="cbIsBLReferenceNo" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><span>&nbsp;BLReferenceNo</span></label><br />
                                            <label><input type="checkbox" id="cbIsShippingLine" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><span>&nbsp;ShippingLine</span></label><br />
                                            <label><input type="checkbox" id="cbIsContainerNumber" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><span>&nbsp;ContainerNumber</span></label><br />
                                            <label><input type="checkbox" id="cbIsContainerTEU" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><span>&nbsp;ContainerTEU</span></label><br />
                                            <label><input type="checkbox" id="cbIsFromCountry" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><span>&nbsp;FromCountry</span></label><br />
                                            <label><input type="checkbox" id="cbIsPol" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;Pol</label><br />
                                            <label><input type="checkbox" id="cbIsLoadingDate" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><span>&nbsp;LoadingDate</span></label>
                                        </div>
                                        <div class="form-group col-sm-4 m-t">
                                            <label><input type="checkbox" id="cbIsDepartureDate" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><span>&nbsp;DepartureDate</span></label><br />
                                            <label><input type="checkbox" id="cbIsTSPorts" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><span>&nbsp;TSPorts</span></label><br />
                                            <label><input type="checkbox" id="cbIsToCountry" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><span>&nbsp;ToCountry</span></label><br />
                                            <label><input type="checkbox" id="cbIsPod" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><span>&nbsp;Pod</span></label><br />
                                            <label><input type="checkbox" id="cbIsArrivalDate" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><span>&nbsp;ArrivalDate</span></label><br />
                                            <label><input type="checkbox" id="cbIsDischargeDate" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><span>&nbsp;DischargeDate</span></label><br />
                                            <label><input type="checkbox" id="cbIsVessel" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><span>&nbsp;Vessel</span></label><br />
                                            <label><input type="checkbox" id="cbIsVesselIMO" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><span>&nbsp;VesselIMO</span></label>
                                        </div>
                                        <div class="form-group col-sm-4 m-t">
                                            <label><input type="checkbox" id="cbIsGateOutDate" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);">&nbsp;GateOutDate</label><br />
                                            <label><input type="checkbox" id="cbIsEmptyReturnDate" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><span>&nbsp;EmptyReturnDate</span></label><br />
                                            <label><input type="checkbox" id="cbIsFormatedTransitTime" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><span>&nbsp;FormatedTransitTime</span></label><br />
                                            <label><input type="checkbox" id="cbIsETA" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><span>&nbsp;ETA</span></label><br />
                                            <label><input type="checkbox" id="cbIsFirstETA" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><span>&nbsp;FirstETA</span></label><br />
                                            <label><input type="checkbox" id="cbIsBLContainerCount" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><span>&nbsp;BLContainerCount</span></label><br />
                                            <label><input type="checkbox" id="cbIsBLContainers" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);"><span>&nbsp;BLContainers</span></label>
                                        </div>
                                    </div>
                                </div>
                                <!--EOF Wizard-->
                            </div>
                    </fieldset>
                </div>
            </div>
            <!-- Endregion Add / Edit Region Form -->
            <div class="modal-footer m-t-n">
                <button type="button" id="btnSaveShipsGoCustomer" class="btn btn-primary btn-sm">
                    <span class="glyphicon glyphicon-save"></span>@Forwarding.MvcApp.App_Resources.App_Resources.Save
                </button>
                <button class="btn btn-link btn-sm" data-dismiss="modal" aria-hidden="true">@Forwarding.MvcApp.App_Resources.App_Resources.Close</button><!--sherif: i added an id and the onclick fn go set the timelocked in the DB to null-->
            </div>
        </div>
    </div>
</div>
<!--EOF ShipsGoCustomer Modal-->
