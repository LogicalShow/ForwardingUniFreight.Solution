                                </div>

                                @*<div class="form-group col-sm-3">
                                        <label>@Forwarding.MvcApp.App_Resources.App_Resources.Religion</label>
                                        <input type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" id="txtReligion" class="form-control parsley-validated input-sm" data-required="false" maxlength="50" placeholder="" style="" />
                                    </div>*@
