                                        <input type="text" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" id="txtmaritalstatus" class="form-control parsley-validated input-sm" data-required="false" maxlength="50" placeholder="" style="" />
                                    </div>*@
