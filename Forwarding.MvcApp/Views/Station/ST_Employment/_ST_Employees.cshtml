                </button>
                <button type="button" id="btnSaveandNew" class="btn btn-primary btn-sm swapChildrenClass" onclick="ST_Employees_Insert(true);">
                    <span class="glyphicon glyphicon-save"></span><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.SaveAndNew&nbsp;</b>
                </button>
