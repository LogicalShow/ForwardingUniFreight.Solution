                            <th><input type="text" class="form-control srchProDate" onchange="_3PLStatistics_Print('Search');" /></th>
                            <th><input type="text" class="form-control srchExpDate" onchange="_3PLStatistics_Print('Search');" /></th>
                            <th><input type="text" class="form-control srchQty" onchange="_3PLStatistics_Print('Search');" /></th>
                            <th><input type="text" class="form-control srchRecCode" onchange="_3PLStatistics_Print('Search');" /></th>
                        </tr>
                        <tr>
                            <th>Warehouse</th>
                            <th>Location</th>
                            <th>Item</th>
                            <th>Desc</th>
                            <th>UOM</th>
                            <th>Batch No</th>
                            <th>Prod Date</th>
                            <th>Exp Date</th>
                            <th>Quantity</th>
                            <th>Rec Code</th>
                        </tr>
                    </thead>
                    <thead id="hBySerial" class="hide">
