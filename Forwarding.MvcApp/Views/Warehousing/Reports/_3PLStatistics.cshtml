                            <th><input type="text" class="form-control srchRecDate" onchange="_3PLStatistics_Print('Search');" /></th>
                            <th><input type="text" class="form-control srchOrderCreation" onchange="_3PLStatistics_Print('Search');" /></th>
                            <th><input type="text" class="form-control srchPallet" onchange="_3PLStatistics_Print('Search');" /></th>
                            <th><input type="text" class="form-control srchCreation" onchange="_3PLStatistics_Print('Search');" /></th>
                            <th><input type="text" class="form-control srchCreator" onchange="_3PLStatistics_Print('Search');" /></th>
                        </tr>
                        <tr>
                            <th>Warehouse</th>
                            <th>Rec Date</th>
                            <th>Shipped Date</th>
                            <th>Pallet ID</th>
                            <th>Creation</th>
                            <th>Creator</th>
                        </tr>
                    </thead>

                    <tbody></tbody>
                </table>
            </div>
            <!--Region: table header-->
            <!--Region: footer-->
            <footer class="panel-footer">
                <div class="row Inquiries hide">
                    <div class="col-sm-4 hidden-xs">
                        <select id="select-page-size-Inquery" class="input-sm form-control input-s-sm inline">
                            <option value="10">10</option>
                            <option value="25">25</option>
