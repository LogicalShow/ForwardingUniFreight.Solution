<!-- start breadcrumb  -->
<ul id="ul-breadcrumb" class="breadcrumb no-border no-radius b-b b-light pull-in">
    <li><a id="hl-homepage" href="javascript:void(0);"><i class="fa fa-home icon-home"></i><span>@Forwarding.MvcApp.App_Resources.App_Resources.HomePage</span>
    </a></li>
    <li><a id="liGroupName" href="javascript:void(0);" onclick="LoadViews('WarehousingTransactions')">@Forwarding.MvcApp.App_Resources.App_Resources.Warehousing
    </a></li>
    <li><a id="liTabName" href="javascript:void(0);" onclick="LoadViews('WarehousingTransactions')">@Forwarding.MvcApp.App_Resources.App_Resources.WarehousingTransactions
    </a></li>
    <li class="active">@Forwarding.MvcApp.App_Resources.App_Resources.WarehousingContract</li>
</ul>
<!-- end breadcrumb  -->

<div id="div-WH_Contract">
    <div id="div-Data">
        <div id="div-Options">
            <div id="div-Action" class="radius-top-left-right">
            </div>
        </div>
        <section class="panel panel-default">
            <header class="panel-heading">
                <h3 class="m-b-none">@Forwarding.MvcApp.App_Resources.App_Resources.Contracts
                </h3>
            </header>
            <!--Region the searh, delete, addnew-->
            <div class="row text-sm wrapper hidden-print ">
                <div id="div-main-options" class="col-sm-5 m-b-xs">
                    <button id="btn-NewAdd" class="btn btn-warning btn-sm swapChildrenClass hide" data-toggle="modal" data-target="#WH_ContractModal"><i class="fa fa-plus"></i><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.New&nbsp;</b></button>
                    <div id="div-option-buttons" class="btn-group hide">
                        <button id="btn-Copy" type="button" class="btn btn-sm btn-default"><i class="fa fa-copy"></i>&nbsp;Copy </button>
                        <button id="btn-Print" type="button" class="btn btn-sm btn-default"><i class="fa fa-print"></i>&nbsp;Print </button>
                        <button id="btn-Send" type="button" class="btn btn-sm btn-default"><i class="fa fa-envelope-o"></i>&nbsp;Send </button>
                    </div>
                </div>
                <div id="div-search-option" class="col-sm-7">
                    <div id="div-search-controls" class="input-group col-sm-9">
                        <input id="txt-Search" autocomplete="off" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="text-transform:uppercase"  type="text" class="input-sm form-control" binding-name="SearchPlaceHolder" binding-prop="placeholder" placeholder="">
                        <span class="input-group-btn">
                            <button id="btn-search" class="btn btn-sm btn-primary" type="button" onclick="WH_Contract_LoadingWithPaging();"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                    <div class="float-right col-sm-1">
                        <button id="btn-Delete" type="button" class="float-right btn btn-sm btn-danger m-r-n swapChildrenClass hide"><i class="fa fa-trash-o"></i><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Delete&nbsp;</b></button>
                    </div>
                </div>
            </div>
            <!--Region the searh, delete, addnew-->

            <!--Region: table header-->
            <div class="table-responsive">
                <table id="tblWH_Contract" class="table table-striped b-t b-light text-sm  table-hover">
                    <thead>
                        <tr>
                            <th id="ID" style="width:5%;">
                                <input id="cb-CheckAll" type="checkbox" />
                            </th>
                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.Code</th>
                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.Customer</th>
                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.FromDate</th>
                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.ToDate</th>
                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.Status</th>
                            <th class="rounded-right hide"></th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
            <!--Region: table header-->
            <!--Region: footer-->
            <footer class="panel-footer">
                <div class="row">
                    <div class="col-sm-4 hidden-xs">
                        <select id="select-page-size" class="input-sm form-control input-s-sm inline">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                        <button id="btn-applypaging" class="btn btn-sm btn-default" type="button">
                            @Forwarding.MvcApp.App_Resources.App_Resources.Apply
                        </button>
                    </div>
                    <div id="div-Text-Total" class="col-sm-4 text-center">
                        <small class="text-muted inline m-t-sm m-b-sm"> @Forwarding.MvcApp.App_Resources.App_Resources.Showing 
                            <span id="spn-first-page-row"></span>- <span id="spn-last-page-row"></span> @Forwarding.MvcApp.App_Resources.App_Resources.Of
                            <span id="spn-total-count"></span> @Forwarding.MvcApp.App_Resources.App_Resources.Items
                        </small>
                    </div>
                    <div id="div-Pager" class="col-sm-4 text-right text-center-xs float-right"></div>
                </div>
            </footer>
            <!--Region: footer-->
        </section>
    </div>
</div>


<!-- Add / Edit Region Modal -->
<div class="modal fade" id="WH_ContractModal" tabindex="-1" data-keyboard="true" data-backdrop="false" role="dialog" aria-labelledby="WH_ContractModalLabel" aria-hidden="true">
    <div class="modal-dialog  modalwidth-100 m-t-n-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
                    &times;</button>
                <h3 class="m-b-none">@Forwarding.MvcApp.App_Resources.App_Resources.WH_Contract &nbsp;<label id="lblShown" purpose="dynamicLabel" class="static-text-primary"></label>
                </h3>
            </div>
            <!-- Region Add / Edit Region Form -->
            <div class="modal-body">
                <div class="span7 form vertical-mode" id="WH_Contract-form">
                    <fieldset>
                        <div class="form-group pull-in has-error clearfix">
                            <input id="hID" type="hidden" />
                            <!-- start alert message region -->
                            @*<div class="alert alert-danger div-error">
            @Forwarding.MvcApp.App_Resources.App_Resources.ErrorMessage
        </div>*@
                            <!-- end alert message region -->
                            <!-- Region Add / Edit Region Form -->
                            <div class="form-group col-sm-2">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.Code</label>
                                <input type="text" id="txtCode" autocomplete="off" disabled="disabled" class="form-control parsley-validated input-sm" data-required="false" maxlength="200" placeholder="Auto-Generated" style="text-transform:uppercase;" />
                            </div>
                            <div class="form-group col-sm-2">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.Status</label>
                                <input type="text" id="txtStatus" autocomplete="off" disabled="disabled" class="form-control parsley-validated input-sm" data-required="false" maxlength="200" placeholder="InProgress" style="text-transform:uppercase;" />
                            </div>
                            <div class="form-group col-sm-2">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.Customer</label>
                                <select id="slCustomer" class="form-control m-b input-sm" data-required="true"></select>
                            </div>
                            <div class="form-group col-sm-2">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.FromDate</label>
                                <input id="txtFromDate" type="text" readonly="readonly" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="background-color:white; cursor:text;" class="datepicker-input form-control input-sm" data-required="true" data-date-format="dd/mm/yyyy" placeholder="Select Date" />
                            </div>
                            <div class="form-group col-sm-2">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.ToDate</label>
                                <input id="txtToDate" type="text" readonly="readonly" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="background-color:white; cursor:text;" class="datepicker-input form-control input-sm" data-required="true" data-date-format="dd/mm/yyyy" placeholder="Select Date" />
                            </div>
                            <div class="form-group col-sm-1">
                                <label>StorageUnit</label>
                                <select id="slStorageUnit" onchange="WH_Contract_StorageUnitChanged();" class="form-control m-b input-sm" data-required="true"></select>
                            </div>
                            <div class="form-group col-sm-5">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.Notes</label>
                                <input type="text" id="txtNotes" autocomplete="off" class="form-control parsley-validated input-sm" data-required="false" maxlength="200" placeholder="Notes" style="text-transform:uppercase" />
                            </div>
                            <!--Details-->
                            <div id="divWH_ContractDetailsBtns" class="col-sm-12 m-t" style="clear:both;">
                                <button id="btn-AddWH_ContractDetails" class="btn btn-warning btn-sm classDisableForFinalized" data-toggle="modal" data-target="" onclick="WH_ContractDetails_ClearAllControls();"><i class="fa fa-plus"></i>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.AddDetails</button>
                                <button id="btn-DeleteWH_ContractDetails" title="Delete Details" type="button" class="float-right btn btn-sm btn-danger classDisableForFinalized" onclick="WH_ContractDetails_DeleteList();"><i class="fa fa-trash-o"></i>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Delete</button>
                            </div>

                            <div id="divWH_ContractDetails" class="col-sm-12 m-t-xs">
                                <section class="panel panel-default">
                                    <header class="panel-heading font-bold text-ul">
                                        <div class="wizard clearfix">
                                            <ul class="steps">
                                                <li data-target="#WH_ContractDetails" id="stepsWH_ContractDetails" class="active"><span class="badge badge-info">1</span>Contract Details</li>
                                                <li data-target="#ExtraServices" id="stepsExtraServices" class="complete"><span class="badge badge-info">2</span>Extra Services</li>
                                            </ul>
                                            <div class="actions" style="display:none;">
                                                <!--Next & Previous buttons-->
                                                <button type="button" class="btn btn-default btn-xs btn-prev" disabled="disabled">@Forwarding.MvcApp.App_Resources.App_Resources.Prev</button>
                                                <button type="button" class="btn btn-default btn-xs btn-next" data-last="Finish">@Forwarding.MvcApp.App_Resources.App_Resources.Next</button>
                                            </div>
                                        </div>

                                    </header>
                                    <div class="step-content">
                                        <!--Basic Data-->
                                        <div class="step-pane active" id="WH_ContractDetails">
                                            <!-- start alert message region -->
                                            <div class="alert alert-danger div-error">
                                                @Forwarding.MvcApp.App_Resources.App_Resources.ErrorMessage
                                            </div>
                                            <!-- end alert message region -->
                                            <!-- Add / Edit Basic Data -->

                                            <div class="table-responsive" style="width:100%; height:300px; overflow:scroll;">
                                                <table id="tblWH_ContractDetails" class="table table-striped b-t b-light text-sm  table-hover ">
                                                    <thead>
                                                        <tr>
                                                            <th id="HeaderDeleteWH_ContractDetailsID" style="width:5%;">
                                                                <input id="cb-CheckAll-WH_ContractDetails" type="checkbox" />
                                                            </th>
                                                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.Description</th>
                                                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.StockUnit</th>
                                                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.TransactionType</th>
                                                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.PalletClassification</th>
                                                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.PaymentTerm</th>
                                                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.Qty</th>
                                                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.Price</th>
                                                            <th class="rounded-right hide"></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody></tbody>
                                                </table>
                                            </div>



                                            <!--EOF Add / Edit Basic Data -->
                                        </div>
                                        <!--EOF Basic Data-->
                                        <!--Billing-->
                                        <div class="step-pane" id="ExtraServices">
                                            <!-- start alert message region -->
                                            <div class="alert alert-danger div-error">
                                                @Forwarding.MvcApp.App_Resources.App_Resources.ErrorMessage
                                            </div>
                                            <select id="slService" class="form-control hide select2" data-required="false"></select>

                                            <!-- end alert message region -->
                                            <!-- Add / Edit Billing -->
                                            <div class="row">
                                                <div style="margin:20px;padding: 0;" class="panel panel-default">

                                                    <div class="panel-body">
                                                        <div class="row">

                                                            <div class="table-responsive  m-t-n" style="font-size:80%;">
                                                                <table id="tblServices" class="table table-striped b-t b-light text-sm  table-hover">
                                                                    <thead>
                                                                        <tr>
                                                                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.Service</th>

                                                                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.Selling</th>

                                                                            <th class="rounded-right"></th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody></tbody>
                                                                </table>
                                                            </div>

                                                        </div>

                                                    </div>
                                                    <div class="panel-footer">
                                                        <div class="row">

                                                            <div class="col-sm-11"></div>
                                                            <div class="col-sm-1" id=addWH_ContractService>
                                                                <button type="button" class="btn btn-blue btn-sm swapChildrenClass" onclick="AddService();">
                                                                    <i class="fa fa-plus"></i><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Add&nbsp;</b>
                                                                </button>
                                                            </div>
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                            <!--EOF Add / Edit Billing -->
                                        </div>
                                        <!--EOF Billing-->
                                        <!--Addresses-->
                                      

                                    </div>

                                    <!--Region: table header-->
                                  
                                    <!--Region: EOF table header-->
                                    <!--Region: table footer-->
                                    <footer class="panel-footer hide">
                                        <div class="col-sm-12 m-t-n-sm swapChildrenClass">
                                            <!--
                <div class="col-sm-6 swapChildrenClass"><b>&emsp;Row Max Weight(KGM)</b><label id="lblRowMaxWeight" @*purpose="dynamicLabel"*@ class="static-text-blue"></label></div>
                <div class="col-sm-6 text-right swapChildrenClass"><b>&emsp;Row Max Volume(CBM)</b><label id="lblRowMaxVolume" @*purpose="dynamicLabel"*@ class="static-text-blue"></label></div>
            -->
                                        </div>
                                    </footer>




                                    <!--Region: EOF table footer-->
                                </section>
                                </section>
                            </div>



                            <!--EOF Details-->
                        </div>
                    </fieldset>
                </div>
            </div>
            <!-- Endregion Add / Edit Region Form -->
            <div class="modal-footer m-t-n-lg">
                <button type="button" id="btnSave" class="btn btn-primary btn-sm classDisableForFinalized" onclick="">
                    <span class="glyphicon glyphicon-save"></span>@Forwarding.MvcApp.App_Resources.App_Resources.Save</button>
                <button type="button" id="btnSaveAndAddNew" class="btn btn-primary btn-sm classDisableForFinalized" onclick="">
                    <span class="glyphicon glyphicon-save"></span>@Forwarding.MvcApp.App_Resources.App_Resources.SaveAndNew</button>
                <button class="btnClose btn btn-link btn-sm" id="btnClose" onclick="" data-dismiss="modal" aria-hidden="true" >@Forwarding.MvcApp.App_Resources.App_Resources.Close</button><!--sherif: i added an id and the onclick fn go set the timelocked in the DB to null-->
            </div> 
        </div>
    </div>
</div>
<!-- Region Options & Template  -->


<!--WH_ContractDetailsModal-->
<div class="modal fade" id="WH_ContractDetailsModal" tabindex="-1" style="z-index: 1050;" data-keyboard="true" data-backdrop="false" role="dialog" aria-labelledby="WH_ContractDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modalwidth-60">
        <div class="modal-content m-t-n-lg">
            <div class="modal-header">
                @*<button type="button" class="close" data-dismiss="modal" aria-hidden="true">
                    &times;</button>*@
                <h3 class="m-b-none">Contract Details&nbsp;<label id="lblWH_ContractDetailsShown" purpose="dynamicLabel" class="static-text-primary"></label>
                </h3>
            </div>
            <div class="modal-body">
                <!-- Region Add / Edit WH_ContractDetails Form -->
                <div class="span7 form vertical-mode" id="WH_ContractDetails-form">
                    <fieldset>
                        <div class="form-group pull-in  has-error clearfix">
                            <input id="hWH_ContractDetailsID" type="hidden" />
                            <!-- start alert message region -->
                            @*<div class="alert alert-danger div-error">
            @Forwarding.MvcApp.App_Resources.App_Resources.ErrorMessage
        </div>*@
                            <!-- end alert message region -->
                            <div class="form-group col-sm-3">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.Description</label>
                                <select id="slWH_ContractDetailsChargeType" class="form-control m-b input-sm" data-required="true"></select>
                            </div>
                            <div class="form-group col-sm-3">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.StockUnit</label>
                                <select id="slWH_ContractDetailsPackageType" class="form-control m-b input-sm" data-required="false"></select>
                            </div>
                            <div class="form-group col-sm-3">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.TransactionType</label>
                                <select id="slWH_ContractDetailsTransType" class="form-control m-b input-sm" data-required="false">
                                    <option value="10">NONE</option>
                                    <option value="20">IN</option>
                                    <option value="30">OUT</option>
                                    <option value="40">IN-OUT</option>
                                </select>
                            </div>
                            <div class="form-group col-sm-3">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.PalletClassification</label>
                                <select id="slWH_ContractDetailsPalletClass" class="form-control m-b input-sm" data-required="false"></select>
                            </div>
                            <div class="form-group col-sm-3">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.PaymentTerm</label>
                                <select id="slWH_ContractDetailsPaymentTerm" class="form-control m-b input-sm" data-required="false"></select>
                            </div>
                            <div class="form-group col-sm-3">
                                <label>Quantity</label>
                                <input type="text" id="txtWH_ContractDetailsQuantity" autocomplete="off" onkeypress="CheckValueIsDecimal(id);" onfocus="CheckValueIsDecimal(id);" onblur="CheckDecimalFormat(id);" class="form-control parsley-validated input-sm" data-required="false" maxlength="11" placeholder="0.0" />
                            </div>
                            <div class="form-group col-sm-3">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.Price</label>
                                <input type="text" id="txtWH_ContractDetailsCost" autocomplete="off" onkeypress="CheckValueIsDecimal(id);" onfocus="CheckValueIsDecimal(id);" onblur="CheckDecimalFormat(id);" class="form-control parsley-validated input-sm" data-required="false" maxlength="11" placeholder="0.0" />
                            </div>

                        </div>
                    </fieldset>
                </div>
                <!-- End Region Add / Edit EditCharge Form -->
            </div>
            <div class="modal-footer">
                <button type="button" id="btnSaveWH_ContractDetails" class="btn btn-primary btn-sm classDisableForFinalized" onclick="WH_ContractDetails_Save(false);">
                    <span class="glyphicon glyphicon-save"></span>@Forwarding.MvcApp.App_Resources.App_Resources.Save</button>
                <button type="button" id="btnSaveAndNewWH_ContractDetails" class="btn btn-primary btn-sm classDisableForFinalized" onclick="WH_ContractDetails_Save(true);">
                    <span class="glyphicon glyphicon-save"></span>@Forwarding.MvcApp.App_Resources.App_Resources.SaveAndNew</button>
                <button class="btnClose btn btn-link btn-sm" id="btnWH_ContractDetailsClose" data-dismiss="modal" aria-hidden="true" >@Forwarding.MvcApp.App_Resources.App_Resources.Close</button><!--sherif: i added an id and the onclick fn go set the timelocked in the DB to null-->
            </div>
        </div>
    </div>
</div>
<!--EOF WH_ContractDetailsModal-->

