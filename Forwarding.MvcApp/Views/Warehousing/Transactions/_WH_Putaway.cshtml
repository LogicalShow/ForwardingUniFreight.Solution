<!-- start breadcrumb  -->
<ul id="ul-breadcrumb" class="breadcrumb no-border no-radius b-b b-light pull-in">
    <li><a id="hl-homepage" href="javascript:void(0);"><i class="fa fa-home icon-home"></i><span>@Forwarding.MvcApp.App_Resources.App_Resources.HomePage</span>
    </a></li>
    <li><a id="liGroupName" href="javascript:void(0);" onclick="LoadViews('WarehousingTransactions')">@Forwarding.MvcApp.App_Resources.App_Resources.Warehousing
    </a></li>
    <li><a id="liTabName" href="javascript:void(0);" onclick="LoadViews('WarehousingTransactions')">@Forwarding.MvcApp.App_Resources.App_Resources.WarehousingTransactions
    </a></li>
    <li class="active">@Forwarding.MvcApp.App_Resources.App_Resources.WH_Putaway</li>
</ul>
<!-- end breadcrumb  -->

<div id="div-WH_Putaway">
    <div id="div-Data">
        <div id="div-Options">
            <div id="div-Action" class="radius-top-left-right">
            </div>
        </div>
        <section class="panel panel-default">
            <header class="panel-heading">
                <h3 class="m-b-none">@Forwarding.MvcApp.App_Resources.App_Resources.WH_Putaway
                </h3>
            </header>
            <!--Region the searh, delete, addnew-->
            <div class="row text-sm wrapper hidden-print ">
                <div id="div-main-options" class="col-sm-5 m-b-xs">
                        <button id="btn-NewAdd" class="btn btn-warning btn-sm swapChildrenClass hide" data-toggle="modal" data-target="#WH_PutawayModal"><i class="fa fa-plus"></i><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.New&nbsp;</b></button>
                    <div id="div-option-buttons" class="btn-group hide">
                        <button id="btn-Copy" type="button" class="btn btn-sm btn-default"><i class="fa fa-copy"></i>&nbsp;Copy </button>
                        <button id="btn-Print" type="button" class="btn btn-sm btn-default"><i class="fa fa-print"></i>&nbsp;Print </button>
                        <button id="btn-Send" type="button" class="btn btn-sm btn-default"><i class="fa fa-envelope-o"></i>&nbsp;Send </button>
                    </div>
                </div>
                <div id="div-search-option" class="col-sm-7 hide">
                    <div id="div-search-controls" class="input-group col-sm-9">
                        <input id="txt-Search" autocomplete="off" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="text-transform:uppercase"  type="text" class="input-sm form-control" binding-name="SearchPlaceHolder" binding-prop="placeholder" placeholder="">
                        <span class="input-group-btn">
                            <button id="btn-search" class="btn btn-sm btn-primary" type="button" onclick="WH_Putaway_LoadingWithPaging();"><i class="fa fa-search"></i></button>
                        </span>
                    </div>
                    <div class="float-right col-sm-1 hide">
                        <button id="btn-Delete" type="button" class="float-right btn btn-sm btn-danger m-r-n swapChildrenClass hide"><i class="fa fa-trash-o"></i><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Delete&nbsp;</b></button>
                    </div>
                </div>
            </div>
            <!--Region the searh, delete, addnew-->

            <!--Region: table header-->
            <div class="table-responsive">
                <table id="tblWH_Putaway" class="table table-striped b-t b-light text-sm  table-hover">
                    <thead>
                        <tr id="srchControls" class="">
                            <th style="width:5%;"></th>
                            <th><input type="text" id="srchCode" class="form-control" onchange="WH_Putaway_LoadingWithPaging();" /></th>
                            <th><input type="text" id="srchReceiveCode" class="form-control" onchange="WH_Putaway_LoadingWithPaging();" /></th>
                            <th><input type="text" id="srchPalletID" class="form-control" onchange="WH_Putaway_LoadingWithPaging();" /></th>
                            <th><input type="text" id="srchLocation" class="form-control" onchange="WH_Putaway_LoadingWithPaging();" /></th>
                            <th><input type="text" id="srchCreator" class="form-control" onchange="WH_Putaway_LoadingWithPaging();" /></th>
                            <th><input type="text" id="srchCreation" class="form-control" onchange="WH_Putaway_LoadingWithPaging();" /></th>
                            <th><input type="text" id="srchWarehouse" class="form-control" onchange="WH_Putaway_LoadingWithPaging();" /></th>
                            <th><input type="text" id="srchOwner" class="form-control" onchange="WH_Putaway_LoadingWithPaging();" /></th>
                        </tr>
                        <tr>
                            <th id="ID" style="width:5%;">
                                <input id="cb-CheckAll" type="checkbox" />
                            </th>
                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.Code</th>
                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.Receive</th>
                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.PalletID</th>
                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.Location</th>
                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.CreatedBy</th>
                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.CreationDate</th>
                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.Warehouse</th>
                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.Project</th>

                            <th class="rounded-right hide"></th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
            <!--Region: table header-->
            <!--Region: footer-->
            <footer class="panel-footer">
                <div class="row">
                    <div class="col-sm-4 hidden-xs">
                        <select id="select-page-size" class="input-sm form-control input-s-sm inline">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                        <button id="btn-applypaging" class="btn btn-sm btn-default" type="button">
                            @Forwarding.MvcApp.App_Resources.App_Resources.Apply
                        </button>
                    </div>
                    <div id="div-Text-Total" class="col-sm-4 text-center">
                        <small class="text-muted inline m-t-sm m-b-sm"> @Forwarding.MvcApp.App_Resources.App_Resources.Showing 
                            <span id="spn-first-page-row"></span>- <span id="spn-last-page-row"></span> @Forwarding.MvcApp.App_Resources.App_Resources.Of
                            <span id="spn-total-count"></span> @Forwarding.MvcApp.App_Resources.App_Resources.Items
                        </small>
                    </div>
                    <div id="div-Pager" class="col-sm-4 text-right text-center-xs float-right"></div>
                </div>
            </footer>
            <!--Region: footer-->
        </section>
    </div>
</div>


<!-- Add / Edit Region Modal -->
<div class="modal fade" id="WH_PutawayModal" data-keyboard="true" data-backdrop="false" role="dialog" aria-labelledby="WH_PutawayModalLabel" aria-hidden="true">
    <div class="modal-dialog  modalwidth-100 m-t-n-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
                    &times;</button>
                <h3 class="m-b-none">@Forwarding.MvcApp.App_Resources.App_Resources.WH_Putaway &nbsp;<label id="lblShown" purpose="dynamicLabel" class="static-text-primary"></label>
                </h3>
            </div>
            <!-- Region Add / Edit Region Form -->
            <div class="modal-body">
                <div class="span7 form vertical-mode" id="WH_Putaway-form">
                    <fieldset>
                        <div class="form-group pull-in has-error clearfix">
                            <!-- start alert message region -->
                            @*<div class="alert alert-danger div-error">
            @Forwarding.MvcApp.App_Resources.App_Resources.ErrorMessage
        </div>*@
                            <!-- end alert message region -->
                            <!-- Region Add / Edit Region Form -->
                            <div class="row">
                                <div class="row hide">
                                    <input id="hID" type="hidden" />

                                    <select id="slLocation" class="form-control select2" data-required="false"></select>
                                </div>

                                <div class="form-group col-sm-2">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.Order</label>
                                    <input type="text" id="txtCode" class="form-control parsley-validated input-sm" data-required="false" maxlength="50" readonly />
                                </div>

                                <div class="form-group col-sm-2">
                                    <label>@Forwarding.MvcApp.App_Resources.App_Resources.Receive</label>
                                    <select id="slReceive" class="form-control select2" data-required="true" onchange="LoadReceiveDetails();"></select>
                                </div>

                            </div>
                         

                            <div class="row">
                                <div style="margin:20px;padding: 0;" class="panel panel-default">
                                   
                                    <div class="panel-body">
                                        <div class="row">

                                            <div class="table-responsive  m-t-n" style="font-size:80%;">
                                                <table id="tblPallets" class="table table-striped b-t b-light text-sm  table-hover">
                                                    <thead>
                                                        <tr>
                                                            <th class="OwnerName"><input type="text" id="srchOwnerDetail" class="form-control" onkeyup="SearchRowItem();" /></th>
                                                            <th class="WarehouseName"><input type="text" id="srchWarehouseDetail" class="form-control" onkeyup="SearchRowItem();" /></th>
                                                            <th class="PalletID"><input type="text" id="srchPallet" class="form-control" onkeyup="SearchRowItem();" /></th>
                                                            <th class="LocationID"><input type="text" id="srchLoc" class="form-control" onkeyup="SearchRowItem();" /></th>
                                                            <th></th>
                                                        </tr>
                                                        <tr>
                                                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.Project</th>
                                                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.Warehouse</th>
                                                            <th>@Forwarding.MvcApp.App_Resources.App_Resources.PalletID</th>
                                                            <th>Receive Location</th>
                                                            <th>Putaway Location</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody></tbody>
                                                </table>
                                            </div>

                                        </div>

                                    </div>
                                    <div class="panel-footer">
                                    

                                    </div>
                                </div>
                            </div>

                        </div>
                        <br />
                        
                    </fieldset>
                </div>
            </div>
            <!-- Endregion Add / Edit Region Form -->
            <div class="modal-footer m-t-n-lg">
                <button type="button" id="btnSave" class="btn btn-primary btn-sm classDisableForFinalized" onclick="WH_Putaway_Save();">
                    <span class="glyphicon glyphicon-save"></span>@Forwarding.MvcApp.App_Resources.App_Resources.Save</button>
          
                <button class="btnClose btn btn-link btn-sm" id="btnClose" onclick="" data-dismiss="modal" aria-hidden="true" >@Forwarding.MvcApp.App_Resources.App_Resources.Close</button><!--sherif: i added an id and the onclick fn go set the timelocked in the DB to null-->
            </div> 
        </div>
    </div>
</div>
<!-- Region Options & Template  -->



