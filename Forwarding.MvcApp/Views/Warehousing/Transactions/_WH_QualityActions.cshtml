<!-- start breadcrumb  -->
<ul id="ul-breadcrumb" class="breadcrumb no-border no-radius b-b b-light pull-in">
    <li>
        <a id="hl-homepage" href="javascript:void(0);">
            <i class="fa fa-home icon-home"></i><span>@Forwarding.MvcApp.App_Resources.App_Resources.HomePage</span>
        </a>
    </li>
    <li>
        <a id="liGroupName" href="javascript:void(0);" onclick="LoadViews('WarehousingTransactions')">
            @Forwarding.MvcApp.App_Resources.App_Resources.Warehousing
    </a>
</li>
<li>
    <a id="liTabName" href="javascript:void(0);" onclick="LoadViews('WarehousingTransactions')">
        @Forwarding.MvcApp.App_Resources.App_Resources.WarehousingTransactions
</a>
</li>
<li class="active">@Forwarding.MvcApp.App_Resources.App_Resources.WH_QualityActions</li>
</ul>
<!-- end breadcrumb  -->


<div id="div-WH_QualityActions">
    <div id="div-Data">
        <div id="div-Options">
            <div id="div-Action" class="radius-top-left-right">
            </div>
        </div>
        <section class="panel panel-default">
            <header class="panel-heading">
                <h3 class="m-b-none">
                    @Forwarding.MvcApp.App_Resources.App_Resources.WH_QualityActions
                </h3>
            </header>
            <ul class="nav nav-tabs">
                <li class="active Pallets tabPallets" onclick="_isPallet = true; strBindTableRowsFunctionName = 'WH_QualityActions_BindTableRows'; $('#select-page-size').val(10); WH_QualityActions_LoadingWithPaging();"><a data-toggle="tab" href="#tabPallet"><b>Pallet</b> </a></li>
                <li class="Batches tabBatches" onclick="_isPallet = false; strBindTableRowsFunctionName = 'WH_QualityActionsBatch_BindTableRows';  $('#select-page-size-batch').val(10); WH_QualityActions_LoadingWithPaging();"><a data-toggle="tab" href="#tabBatch"><b>Batch</b></a></li>
                <li class="Items tabItems" onclick="$('#tblWH_QualityActionsItem tbody').html('');"><a data-toggle="tab" href="#tabItem"><b>Item</b></a></li>
            </ul>
            <div class="tab-content">
                <div id="tabPallet" class="tab-pane fade in active Pallets tabPallets">
                    <div class="row text-sm wrapper hidden-print ">
                        <div id="div-main-options" class="col-sm-7 m-b-xs">
                            <div class="form-group col-sm-3">
                                <label>Pallet Status</label>
                                <select id="slPalletStatus" class="form-control m-b input-sm" data-required="false"></select>
                            </div>
                            <div class="form-group col-sm-3">
                                <label>Pallet Class</label>
                                <select id="slPalletClass" class="form-control m-b input-sm" data-required="false"></select>
                            </div>
                            <div class="form-group col-sm-8">
                                <input type="text" id="txtReason" class="form-control" data-required="false" placeholder="@Forwarding.MvcApp.App_Resources.App_Resources.Reason" />
                            </div>
                            <div class="form-group col-sm-1">
                                <button type="button" class="btn btn-primary btn-sm swapChildrenClass" onclick="WH_QualityActions_Save();"><i class="fa fa-save"></i><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Save&nbsp;</b></button>
                            </div>
                        </div>
                        <div id="div-search-option" class="col-sm-4">
                            <div id="div-search-controls" class="input-group col-sm-9 hide">
                                <input id="txt-Search" autocomplete="off" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="text-transform:uppercase" type="text" class="input-sm form-control" binding-name="SearchPlaceHolder" binding-prop="placeholder" placeholder="">
                                <span class="input-group-btn">
                                    <button id="btn-search" class="btn btn-sm btn-primary" type="button" onclick="WH_QualityActions_LoadingWithPaging();"><i class="fa fa-search"></i></button>
                                </span>
                            </div>
                        </div>
                        <div class="form-group col-sm-1">
                            <button type="button" class="btn btn-primary btn-sm swapChildrenClass" onclick="ExportQualityActions();"><i class="fa fa-file-excel-o"></i><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Export&nbsp;</b></button>
                        </div>
                    </div>
                    <!--Region the searh, delete, addnew-->
                    <!--Region: table header-->
                    <div class="table-responsive">
                        <table id="tblWH_QualityActions" class="table table-striped b-t b-light text-sm  table-hover">
                            <thead>
                                <tr>
                                    <th id="ID-Pallet" style="width:5%;"></th>
                                    <th><input type="text" id="srchPallet" class="form-control" onchange="WH_QualityActions_LoadingWithPaging();" /></th>
                                    <th><input type="text" id="srchLocation" class="form-control" onchange="WH_QualityActions_LoadingWithPaging();" /></th>
                                    <th><input type="text" id="srchPalletStatus" class="form-control" onchange="WH_QualityActions_LoadingWithPaging();" /></th>
                                    <th><input type="text" id="srchPalletClass" class="form-control" onchange="WH_QualityActions_LoadingWithPaging();" /></th>

                                    <th class="hide"><input type="text" id="srchItem" class="form-control" onchange="WH_QualityActions_LoadingWithPaging();" /></th>
                                    <th><input type="text" id="srchReason" class="form-control" onchange="WH_QualityActions_LoadingWithPaging();" /></th>
                                    <th><input type="text" id="srchReceiveCode" class="form-control" onchange="WH_QualityActions_LoadingWithPaging();" /></th>

                                    <th class="rounded-right">
                                        <button class="btn btn-sm btn-primary hide" type="button" onclick="WH_QualityActions_LoadingWithPaging();"><i class="fa fa-search"></i> @Forwarding.MvcApp.App_Resources.App_Resources.Search</button>
                                    </th>
                                </tr>
                                <tr>
                                    <th id="ID-Pallet" style="width:5%;">
                                        <input id="cb-CheckAll-pallet" type="checkbox" onclick="CheckAllPallets(this);"/>
                                    </th>
                                    <th>@Forwarding.MvcApp.App_Resources.App_Resources.PalletID</th>
                                    <th>@Forwarding.MvcApp.App_Resources.App_Resources.Location</th>
                                    <th>@Forwarding.MvcApp.App_Resources.App_Resources.PalletStatus</th>
                                    <th>@Forwarding.MvcApp.App_Resources.App_Resources.PalletClassification</th>
                                    <th class="hide">@Forwarding.MvcApp.App_Resources.App_Resources.Item</th>
                                    <th>@Forwarding.MvcApp.App_Resources.App_Resources.Reason</th>
                                    <th>@Forwarding.MvcApp.App_Resources.App_Resources.ReceiveCode</th>

                                    <th class="rounded-right"></th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                    <!--Region: table header-->
                    <!--Region: footer-->
                    <footer class="panel-footer">
                        <div class="row">
                            <div class="col-sm-4 hidden-xs">
                                <select id="select-page-size" class="input-sm form-control input-s-sm inline">
                                    <option value="10">10</option>
                                    <option value="25">25</option>
                                    <option value="50">50</option>
                                </select>
                                <button id="btn-applypaging" class="btn btn-sm btn-default" type="button" onclick="WH_QualityActions_LoadingWithPaging();">
                                    @Forwarding.MvcApp.App_Resources.App_Resources.Apply
                                </button>
                            </div>
                            <div id="div-Text-Total" class="col-sm-4 text-center">
                                <small class="text-muted inline m-t-sm m-b-sm">
                                    @Forwarding.MvcApp.App_Resources.App_Resources.Showing
                                    <span id="spn-first-page-row"></span>- <span id="spn-last-page-row"></span> @Forwarding.MvcApp.App_Resources.App_Resources.Of
                                    <span id="spn-total-count"></span> @Forwarding.MvcApp.App_Resources.App_Resources.Items
                                </small>
                            </div>
                            <div id="div-Pager" class="col-sm-4 text-right text-center-xs float-right" onclick="WH_QualityActions_LoadingWithPaging();"></div>
                        </div>
                    </footer>

                </div>
                <div id="tabBatch" class="tab-pane fade in Batches tabBatches">
                    <div class="row text-sm wrapper hidden-print ">
                        <div id="div-main-options" class="col-sm-7 m-b-xs">
                            <div class="form-group col-sm-3">
                                <label>Batch Status</label>
                                <select id="slBatchStatus" class="form-control m-b input-sm" data-required="false"></select>
                            </div>
                            <br />
                            <div class="form-group col-sm-8">
                                <input type="text" id="txtBatchReason" class="form-control" data-required="false" placeholder="@Forwarding.MvcApp.App_Resources.App_Resources.Reason" />
                            </div>
                            <div class="form-group col-sm-1">
                                <button type="button" class="btn btn-primary btn-sm swapChildrenClass" onclick="WH_QualityActions_Save();"><i class="fa fa-save"></i><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Save&nbsp;</b></button>
                            </div>
                        </div>
                        <div id="div-search-option" class="col-sm-4">
                            <div id="div-search-controls" class="input-group col-sm-9 hide">
                                <input id="txt-Search" autocomplete="off" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="text-transform:uppercase" type="text" class="input-sm form-control" binding-name="SearchPlaceHolder" binding-prop="placeholder" placeholder="">
                                <span class="input-group-btn">
                                    <button id="btn-search" class="btn btn-sm btn-primary" type="button" onclick="WH_QualityActions_LoadingWithPaging();"><i class="fa fa-search"></i></button>
                                </span>
                            </div>
                        </div>
                        <div class="form-group col-sm-1">
                            <button type="button" class="btn btn-primary btn-sm swapChildrenClass" onclick="ExportQualityActions();"><i class="fa fa-file-excel-o"></i><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Export&nbsp;</b></button>
                        </div>
                    </div>
                    <!--Region the searh, delete, addnew-->
                    <!--Region: table header-->
                    <div class="table-responsive">
                        <table id="tblWH_QualityActionsBatch" class="table table-striped b-t b-light text-sm  table-hover">
                            <thead>
                                <tr>
                                    <th id="ID-Batch" style="width:5%;"></th>
                                    <th><input type="text" id="srchBatch" class="form-control" onchange="WH_QualityActions_LoadingWithPaging();" /></th>
                                    <th><input type="text" id="srchProductionDate" class="form-control" onchange="WH_QualityActions_LoadingWithPaging();" /></th>
                                    <th><input type="text" id="srchExpirationDate" class="form-control" onchange="WH_QualityActions_LoadingWithPaging();" /></th>
                                    <th><input type="text" id="srchBatchStatus" class="form-control" onchange="WH_QualityActions_LoadingWithPaging();" /></th>
                                    <th><input type="text" id="srchReason" class="form-control" onchange="WH_QualityActions_LoadingWithPaging();" /></th>

                                    <th class="rounded-right"></th>
                                    <th class="rounded-right"></th>
                                </tr>
                                <tr>
                                    <th id="ID-Batch" style="width:5%;">
                                        <input id="cb-CheckAll-batch" type="checkbox" onclick="CheckAllBatches(this);"/>
                                    </th>
                                    <th>@Forwarding.MvcApp.App_Resources.App_Resources.BatchNo</th>
                                    <th>@Forwarding.MvcApp.App_Resources.App_Resources.ProductionDate</th>
                                    <th>@Forwarding.MvcApp.App_Resources.App_Resources.ExpirationDate</th>
                                    <th>@Forwarding.MvcApp.App_Resources.App_Resources.BatchStatus</th>
                                    <th>@Forwarding.MvcApp.App_Resources.App_Resources.Reason</th>

                                    <th class="rounded-right"></th>
                                    <th class="rounded-right"></th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                    <!--Region: table header-->
                    <!--Region: footer-->
                    <footer class="panel-footer">
                        <div class="row">
                            <div class="col-sm-4 hidden-xs">
                                <select id="select-page-size-batch" class="input-sm form-control input-s-sm inline">
                                    <option value="10">10</option>
                                    <option value="25">25</option>
                                    <option value="50">50</option>
                                </select>
                                <button id="btn-applypaging-batch" class="btn btn-sm btn-default" type="button" onclick="WH_QualityActions_LoadingWithPaging();">
                                    @Forwarding.MvcApp.App_Resources.App_Resources.Apply
                                </button>
                            </div>
                            <div id="div-Text-Total-batch" class="col-sm-4 text-center">
                                <small class="text-muted inline m-t-sm m-b-sm">
                                    @Forwarding.MvcApp.App_Resources.App_Resources.Showing
                                    <span id="spn-first-page-row-batch"></span>- <span id="spn-last-page-row-batch"></span> @Forwarding.MvcApp.App_Resources.App_Resources.Of
                                    <span id="spn-total-count-batch"></span> @Forwarding.MvcApp.App_Resources.App_Resources.Items
                                </small>
                            </div>
                            <div id="div-Pager-batch" class="col-sm-4 text-right text-center-xs float-right" onclick="WH_QualityActions_LoadingWithPaging();"></div>
                        </div>
                    </footer>

                </div>
                <div id="tabItem" class="tab-pane fade in Items tabItems">
                    <div class="row text-sm wrapper hidden-print ">
                        <div id="div-main-options" class="col-sm-7 m-b-xs">
                            <div class="form-group col-sm-3">
                                <label>Item</label>
                                <select id="slItem" class="form-control m-b input-sm" data-required="false" onchange="GetItemBalance();"></select>
                            </div>
                            <div class="form-group col-sm-3">
                                <label>Receive</label>
                                <select id="slReceive" class="form-control m-b input-sm" data-required="false" onchange="GetItemBalance();"></select>
                            </div>
                            <div class="form-group col-sm-1">
                                <button type="button" class="btn btn-primary btn-sm swapChildrenClass m-t-md" onclick="UpdateItem();"><i class="fa fa-save"></i><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Save&nbsp;</b></button>
                            </div>
                        </div>
                    </div>
                    <!--Region the searh, delete, addnew-->
                    <!--Region: table header-->
                    <div class="table-responsive">
                        <table id="tblWH_QualityActionsItem" class="table table-striped b-t b-light text-sm  table-hover">
                            <thead>
                                <tr>
                                    <th class="rounded-right"></th>
                                    <th><input type="text" id="srchItemCode" class="form-control" onkeyup="SearchRowItem();" /></th>
                                    <th><input type="text" id="srchItemName" class="form-control" onkeyup="SearchRowItem();" /></th>
                                    <th><input type="text" id="srchItemPallet" class="form-control" onkeyup="SearchRowItem();" /></th>
                                    <th><input type="text" id="srchItemLoc" class="form-control" onkeyup="SearchRowItem();" /></th>
                                    <th><input type="text" id="srchItemBatch" class="form-control" onkeyup="SearchRowItem();" /></th>
                                    <th class="ProductionDate hide"><input type="text" id="srchItemProdDate" class="form-control" onkeyup="SearchRowItem();" /></th>
                                    <th><input type="text" id="srchItemExpiDate" class="form-control" onkeyup="SearchRowItem();" /></th>

                                    <th class="rounded-right"></th>
                                </tr>
                                <tr>
                                    <th id="ID-Item" style="width:5%;">
                                        <input id="cb-CheckAll-item" type="checkbox" onclick="CheckAllItems(this);" />
                                    </th>
                                    <th>@Forwarding.MvcApp.App_Resources.App_Resources.ProductCode</th>
                                    <th>@Forwarding.MvcApp.App_Resources.App_Resources.Description</th>
                                    <th>@Forwarding.MvcApp.App_Resources.App_Resources.PalletID</th>
                                    <th>@Forwarding.MvcApp.App_Resources.App_Resources.Location</th>
                                    <th>@Forwarding.MvcApp.App_Resources.App_Resources.BatchNo</th>
                                    <th class="ProductionDate hide">@Forwarding.MvcApp.App_Resources.App_Resources.ProductionDate</th>
                                    <th>@Forwarding.MvcApp.App_Resources.App_Resources.ExpirationDate</th>

                                    <th class="rounded-right"></th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                    <!--Region: table header-->
                    <!--Region: footer-->
                    <footer class="panel-footer">
                        <div class="row">
                            <div class="col-sm-4 hidden-xs">
                                <select id="select-page-size-item" class="input-sm form-control input-s-sm inline">
                                    <option value="10">10</option>
                                    <option value="25">25</option>
                                    <option value="50">50</option>
                                </select>
                                <button id="btn-applypaging-item" class="btn btn-sm btn-default" type="button" onclick="GetItemBalance();">
                                    @Forwarding.MvcApp.App_Resources.App_Resources.Apply
                                </button>
                            </div>
                            <div id="div-Text-Total-item" class="col-sm-4 text-center">
                                <small class="text-muted inline m-t-sm m-b-sm">
                                    @Forwarding.MvcApp.App_Resources.App_Resources.Showing
                                    <span id="spn-first-page-row-item"></span>- <span id="spn-last-page-row-item"></span> @Forwarding.MvcApp.App_Resources.App_Resources.Of
                                    <span id="spn-total-count-item"></span> @Forwarding.MvcApp.App_Resources.App_Resources.Items
                                </small>
                            </div>
                            <div id="div-Pager-item" class="col-sm-4 text-right text-center-xs float-right" onclick="GetItemBalance();"></div>
                        </div>
                    </footer>

                </div>
            </div>
            <!--Region the searh, delete, addnew-->
          
            <!--Region: footer-->
        </section>
</div>
</div>


<!-- Add / Edit Region Modal -->
<div class="modal fade" id="WH_QualityActionsModal" tabindex="-1" data-keyboard="true" data-backdrop="false" role="dialog" aria-labelledby="WH_QualityActionsModalLabel" aria-hidden="true">
    <div class="modal-dialog  modalwidth-50 m-t-n-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
                    &times;
                </button>
                <h3 class="m-b-none"><label id="lblShown" purpose="dynamicLabel" class="static-text-primary"></label></h3>
        </div>
        <!-- Region Add / Edit Region Form -->
        <div class="modal-body">
            <div class="span7 form vertical-mode" id="WH_QualityActions-form">
                <fieldset>
                    <div class="form-group pull-in has-error clearfix">

                        <div class="table-responsive">
                            <table id="tblPalletItems" class="table table-striped b-t b-light text-sm  table-hover">
                                <thead>
                                    <tr>
                                        <th>Item Code</th>
                                        <th>Item Name</th>
                                        <th>Stoke Unit</th>
                                        <th>Qty</th>
                                        <th>Expiration Date</th>
                                        <th>Manu.Date</th>
                                        <th>Location</th>
                                        <th>BatchNo</th>
                                        <th>PalletId</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>

                    </div>
                    <br />
                </fieldset>
            </div>
        </div>
        <!-- Endregion Add / Edit Region Form -->
        <div class="modal-footer m-t-n-lg">
            <button class="btnClose btn btn-link btn-sm" id="btnClose" onclick="" data-dismiss="modal" aria-hidden="true">@Forwarding.MvcApp.App_Resources.App_Resources.Close</button><!--sherif: i added an id and the onclick fn go set the timelocked in the DB to null-->
        </div>
    </div>
</div>
</div>
<!-- Region Options & Template  -->


<table id="tblWH_QualityActionsExport" class="table table-striped b-t b-light text-sm table-hover hide">
    <thead>
        <tr>
            <th>@Forwarding.MvcApp.App_Resources.App_Resources.Code</th>
            <th>@Forwarding.MvcApp.App_Resources.App_Resources.Location</th>
            <th>@Forwarding.MvcApp.App_Resources.App_Resources.PalletID</th>
            <th>@Forwarding.MvcApp.App_Resources.App_Resources.PalletStatus</th>
            <th>@Forwarding.MvcApp.App_Resources.App_Resources.Item</th>
            <th>@Forwarding.MvcApp.App_Resources.App_Resources.Reason</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>