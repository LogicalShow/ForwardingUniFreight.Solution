<!-- start breadcrumb  -->
<ul id="ul-breadcrumb" class="breadcrumb no-border no-radius b-b b-light pull-in">
    <li>
        <a id="hl-homepage" href="javascript:void(0);">
            <i class="fa fa-home icon-home"></i><span>@Forwarding.MvcApp.App_Resources.App_Resources.HomePage</span>
        </a>
    </li>
    <li>
        <a id="liGroupName" href="javascript:void(0);" onclick="LoadViews('WarehousingTransactions')">
            @Forwarding.MvcApp.App_Resources.App_Resources.Warehousing
    </a>
</li>
<li>
    <a id="liTabName" href="javascript:void(0);" onclick="LoadViews('WarehousingTransactions')">
        @Forwarding.MvcApp.App_Resources.App_Resources.WarehousingTransactions
</a>
</li>
<li class="active">@Forwarding.MvcApp.App_Resources.App_Resources.WH_TransServices</li>
</ul>
<!-- end breadcrumb  -->

<div id="div-WH_TransServices">
    <div id="div-Data">
        <div id="div-Options">
            <div id="div-Action" class="radius-top-left-right">
            </div>
        </div>
        <section class="panel panel-default">
            <header class="panel-heading">
                <h3 class="m-b-none">
                    @Forwarding.MvcApp.App_Resources.App_Resources.WH_TransServices
            </h3>
        </header>
        <!--Region the searh, delete, addnew-->
        <div class="row text-sm wrapper hidden-print ">
            <div id="div-main-options" class="col-sm-5 m-b-xs">
                <div id="div-option-buttons" class="btn-group">
                    <button id="btn-NewAdd" class="btn btn-warning btn-sm swapChildrenClass hide" data-toggle="modal" data-target="#WH_ExtraServicesModal"><i class="fa fa-plus"></i><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.New&nbsp;</b></button>
                    <button id="btn-Copy" type="button" class="btn btn-sm btn-default hide"><i class="fa fa-copy"></i>&nbsp;Copy </button>
                    <button id="btn-Print" type="button" class="btn btn-sm btn-default hide"><i class="fa fa-print"></i>&nbsp;Print </button>
                    <button id="btn-Send" type="button" class="btn btn-sm btn-default hide"><i class="fa fa-envelope-o"></i>&nbsp;Send </button>
                </div>
            </div>
            <div id="div-search-option" class="col-sm-7">
                <div id="div-search-controls" class="input-group col-sm-9">
                    <input id="txt-Search" autocomplete="off" onfocus="DisableEnterKey(id);" onkeypress="DisableEnterKey(id);" style="text-transform:uppercase" type="text" class="input-sm form-control" binding-name="SearchPlaceHolder" binding-prop="placeholder" placeholder="">
                    <span class="input-group-btn">
                        <button id="btn-search" class="btn btn-sm btn-primary" type="button" onclick="WH_TransServices_LoadingWithPaging(true);"><i class="fa fa-search"></i></button>
                    </span>
                </div>
                <div class="float-right col-sm-1">
                    <button id="btn-Delete" type="button" class="float-right btn btn-sm btn-danger m-r-n swapChildrenClass hide"><i class="fa fa-trash-o"></i><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Delete&nbsp;</b></button>
                </div>
            </div>
        </div>
        <!--Region the searh, delete, addnew-->
        <!--Region: table header-->
        <div class="table-responsive">
            <table id="tblWH_TransServices" class="table table-striped b-t b-light text-sm  table-hover">
                <thead>
                    <tr id="srchControls" class="hide TableHead1">
                        <th style="width:5%;"></th>
                        <th><input type="text" id="srchOrder" class="form-control" onchange="WH_TransServices_LoadingWithPaging();" /></th>
                        <th><input type="text" id="srchOrderDate" class="form-control" onchange="WH_TransServices_LoadingWithPaging();" /></th>
                        <th><input type="text" id="srchWarehouse" class="form-control" onchange="WH_TransServices_LoadingWithPaging();" /></th>
                        <th><input type="text" id="srchCustomer" class="form-control" onchange="WH_TransServices_LoadingWithPaging();" /></th>
                        <th><input type="text" id="srchOwner" class="form-control" onchange="WH_TransServices_LoadingWithPaging();" /></th>
                        <th><input type="text" id="srchService" class="form-control" onchange="WH_TransServices_LoadingWithPaging();" /></th>
                        <th><input type="text" id="srchQty" class="form-control" onchange="WH_TransServices_LoadingWithPaging();" /></th>
                        <th><input type="text" id="srchCreator" class="form-control" onchange="WH_TransServices_LoadingWithPaging();" /></th>
                        <th><input type="text" id="srchCreation" class="form-control" onchange="WH_TransServices_LoadingWithPaging();" /></th>
                    </tr>
                    <tr class="hide TableHead1">
                        <th id="ID" style="width:5%;">
                            <input id="cb-CheckAll" type="checkbox" />
                        </th>
                        <th>@Forwarding.MvcApp.App_Resources.App_Resources.Order</th>
                        <th>@Forwarding.MvcApp.App_Resources.App_Resources.Date</th>
                        <th>@Forwarding.MvcApp.App_Resources.App_Resources.Warehouse</th>
                        <th>@Forwarding.MvcApp.App_Resources.App_Resources.Customer</th>
                        <th>@Forwarding.MvcApp.App_Resources.App_Resources.Project</th>
                        <th>@Forwarding.MvcApp.App_Resources.App_Resources.Service</th>
                        <th>@Forwarding.MvcApp.App_Resources.App_Resources.Quantity</th>
                        <th>@Forwarding.MvcApp.App_Resources.App_Resources.Creator</th>
                        <th>@Forwarding.MvcApp.App_Resources.App_Resources.CreationDate</th>

                        <th class="rounded-right hide"></th>
                    </tr>
                    <tr class="TableHead2">
                        <th id="ID" style="width:5%;">
                            <input id="cb-CheckAll" type="checkbox" />
                        </th>
                        <th>@Forwarding.MvcApp.App_Resources.App_Resources.Code</th>
                        <th>@Forwarding.MvcApp.App_Resources.App_Resources.Date</th>
                        <th>@Forwarding.MvcApp.App_Resources.App_Resources.Customer</th>
                        <th>@Forwarding.MvcApp.App_Resources.App_Resources.Warehouse</th>

                        <th class="rounded-right hide"></th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
        <!--Region: table header-->
        <!--Region: footer-->
        <footer class="panel-footer">
            <div class="row">
                <div class="col-sm-4 hidden-xs">
                    <select id="select-page-size" class="input-sm form-control input-s-sm inline">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select>
                    <button id="btn-applypaging" class="btn btn-sm btn-default" type="button">
                        @Forwarding.MvcApp.App_Resources.App_Resources.Apply
                    </button>
                </div>
                <div id="div-Text-Total" class="col-sm-4 text-center">
                    <small class="text-muted inline m-t-sm m-b-sm">
                        @Forwarding.MvcApp.App_Resources.App_Resources.Showing
                        <span id="spn-first-page-row"></span>- <span id="spn-last-page-row"></span> @Forwarding.MvcApp.App_Resources.App_Resources.Of
                        <span id="spn-total-count"></span> @Forwarding.MvcApp.App_Resources.App_Resources.Items
                    </small>
                </div>
                <div id="div-Pager" class="col-sm-4 text-right text-center-xs float-right"></div>
            </div>
        </footer>
        <!--Region: footer-->
    </section>
</div>
</div>


<!-- Add / Edit Region Modal -->
<div class="modal fade hide" id="WH_TransServicesModal" data-keyboard="true" data-backdrop="false" role="dialog" aria-labelledby="WH_TransServicesModalLabel" aria-hidden="true">
    <div class="modal-dialog  modalwidth-100 m-t-n-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
                    &times;
                </button>
                <h3 class="m-b-none">
                    @Forwarding.MvcApp.App_Resources.App_Resources.WH_TransServices &nbsp;<label id="lblShown" purpose="dynamicLabel" class="static-text-primary"></label>
            </h3>
        </div>
        <!-- Region Add / Edit Region Form -->
        <div class="modal-body">
            <div class="span7 form vertical-mode" id="WH_TransServices-form">
                <fieldset>
                    <div class="form-group pull-in has-error clearfix">
                        <!-- start alert message region -->
                        @*<div class="alert alert-danger div-error">
                                @Forwarding.MvcApp.App_Resources.App_Resources.ErrorMessage
                            </div>*@
                        <!-- end alert message region -->
                        <!-- Region Add / Edit Region Form -->
                        <div class="row">
                            <div class="row hide">
                                <input id="hID" type="hidden" />
                                <input id="hIsReceive" type="checkbox" data-required="false" />

                                <select id="slService" class="form-control select2" data-required="false"></select>
                            </div>

                            <div class="form-group col-sm-3">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.Name</label>
                                <input type="text" id="txtCode" class="form-control parsley-validated input-sm" data-required="false" maxlength="50" readonly />
                            </div>
                            <div class="form-group col-sm-3 m-t-md">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.Invoiced</label>
                                <input id="cbIsInvoiced" type="checkbox" data-required="false" disabled />
                            </div>
                        </div>


                        <div class="row">
                            <div style="margin:20px;padding: 0;" class="panel panel-default">

                                <div class="panel-body">
                                    <div class="row">

                                        <div class="table-responsive  m-t-n" style="font-size:80%;">
                                            <table id="tblServices" class="table table-striped b-t b-light text-sm  table-hover">
                                                <thead>
                                                    <tr>
                                                        <th>@Forwarding.MvcApp.App_Resources.App_Resources.Service</th>
                                                        <th>@Forwarding.MvcApp.App_Resources.App_Resources.Cost</th>
                                                        <th>@Forwarding.MvcApp.App_Resources.App_Resources.Selling</th>
                                                        <th>@Forwarding.MvcApp.App_Resources.App_Resources.CalculationType</th>
                                                        <th>@Forwarding.MvcApp.App_Resources.App_Resources.Quantity</th>
                                                        <th>@Forwarding.MvcApp.App_Resources.App_Resources.CostAmount</th>
                                                        <th>@Forwarding.MvcApp.App_Resources.App_Resources.SaleAmount</th>
                                                        <th class="rounded-right"></th>
                                                    </tr>
                                                </thead>
                                                <tbody></tbody>
                                            </table>
                                        </div>

                                    </div>

                                </div>
                                <div class="panel-footer">
                                    <div class="row">

                                        <div class="col-sm-11"></div>
                                        <div class="col-sm-1">
                                            <button type="button" class="btn btn-blue btn-sm swapChildrenClass" onclick="AddService();">
                                                <i class="fa fa-plus"></i><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Add&nbsp;</b>
                                            </button>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                    </div>
                    <br />

                </fieldset>
            </div>
        </div>
        <!-- Endregion Add / Edit Region Form -->
        <div class="modal-footer m-t-n-lg">
            <button type="button" id="btnSave" class="btn btn-primary btn-sm classDisableForFinalized" onclick="WH_TransServices_Save();">
                <span class="glyphicon glyphicon-save"></span>@Forwarding.MvcApp.App_Resources.App_Resources.Save
            </button>

            <button class="btnClose btn btn-link btn-sm" id="btnClose" onclick="" data-dismiss="modal" aria-hidden="true">@Forwarding.MvcApp.App_Resources.App_Resources.Close</button><!--sherif: i added an id and the onclick fn go set the timelocked in the DB to null-->
        </div>
    </div>
</div>
</div>
<!-- Region Options & Template  -->
<!-- Add / Edit Region Modal -->
<div class="modal fade hide" id="WH_ExtraServicesModal" data-keyboard="true" data-backdrop="false" role="dialog" aria-labelledby="WH_ExtraServicesModalLabel" aria-hidden="true">
    <div class="modal-dialog  modalwidth-100 m-t-n-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
                    &times;
                </button>
                <h3 class="m-b-none">
                    @Forwarding.MvcApp.App_Resources.App_Resources.WH_ExtraServices &nbsp;<label id="lblShownNew" purpose="dynamicLabel" class="static-text-primary"></label>
            </h3>
        </div>
        <!-- Region Add / Edit Region Form -->
        <div class="modal-body">
            <div class="span7 form vertical-mode" id="WH_ExtraServices-form">
                <fieldset>
                    <div class="form-group pull-in has-error clearfix">
                        <!-- start alert message region -->
                        @*<div class="alert alert-danger div-error">
                                @Forwarding.MvcApp.App_Resources.App_Resources.ErrorMessage
                            </div>*@
                        <!-- end alert message region -->
                        <!-- Region Add / Edit Region Form -->
                        <div class="row">
                            <div class="row hide">
                                <input id="hID" type="hidden" />
                                <select id="slService" class="form-control select2" data-required="false"></select>
                                <select id="slOrder" class="form-control select2" data-required="false"></select>
                            </div>

                            <div class="form-group col-sm-2">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.Name</label>
                                <input type="text" id="txtDate" class="form-control parsley-validated input-sm" data-required="false" maxlength="50" readonly />
                            </div>
                            <div class="form-group col-sm-2">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.Warehouse</label>
                                <select id="slWarehouse" class="form-control m-b input-sm classDisableForFinalized" data-required="true" onchange="LoadOrders();"></select>
                            </div>
                            <div class="form-group col-sm-2">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.Customer</label>
                                <select id="slCustomer" class="form-control m-b input-sm" data-required="true" onchange="LoadOwners('New');LoadOrders();"></select>
                            </div>
                            <div class="form-group col-sm-2">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.Project</label>
                                <select id="slOwner" class="form-control m-b input-sm" data-required="true" onchange="LoadOrders();"></select>
                            </div>
                            <div class="form-group col-sm-4">
                                <label>@Forwarding.MvcApp.App_Resources.App_Resources.Notes</label>
                                <input type="text" id="txtNotes" class="form-control parsley-validated input-sm" data-required="false" maxlength="50"  />
                            </div>
                        </div>


                        <div class="row">
                            <div style="margin:20px;padding: 0;" class="panel panel-default">

                                <div class="panel-body">
                                    <div class="row">

                                        <div class="table-responsive m-t-n" style="font-size:80%;">
                                            <table id="tblExtraServices" class="table table-striped b-t b-light text-sm  table-hover">
                                                <thead>
                                                    <tr>
                                                        <th>@Forwarding.MvcApp.App_Resources.App_Resources.Service</th>
                                                        <th>@Forwarding.MvcApp.App_Resources.App_Resources.Quantity</th>
                                                        <th>@Forwarding.MvcApp.App_Resources.App_Resources.Order</th>
                                                        <th class="rounded-right"></th>
                                                    </tr>
                                                </thead>
                                                <tbody></tbody>
                                            </table>
                                        </div>

                                    </div>

                                </div>
                                <div class="panel-footer">
                                    <div class="row">

                                        <div class="col-sm-11"></div>
                                        <div class="col-sm-1">
                                            <button type="button" class="btn btn-blue btn-sm swapChildrenClass" onclick="AddExtraService();">
                                                <i class="fa fa-plus"></i><b>&nbsp;@Forwarding.MvcApp.App_Resources.App_Resources.Add&nbsp;</b>
                                            </button>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                    </div>
                    <br />

                </fieldset>
            </div>
        </div>
        <!-- Endregion Add / Edit Region Form -->
        <div class="modal-footer m-t-n-lg">
            <button type="button" id="btnSaveNew" class="btn btn-primary btn-sm" onclick="WH_ExtraServices_Save();">
                <span class="glyphicon glyphicon-save"></span>@Forwarding.MvcApp.App_Resources.App_Resources.Save
            </button>

            <button class="btnClose btn btn-link btn-sm" id="btnCloseNew" onclick="" data-dismiss="modal" aria-hidden="true">@Forwarding.MvcApp.App_Resources.App_Resources.Close</button><!--sherif: i added an id and the onclick fn go set the timelocked in the DB to null-->
        </div>
    </div>
</div>
</div>
<!-- Region Options & Template  -->
